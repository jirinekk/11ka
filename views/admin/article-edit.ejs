</form>
<% } %>

<script>
  (function () {
    var catEl = document.getElementById('category');
    var tagEl = document.getElementById('tag');
    if (!catEl || !tagEl) return;

    var ALL_TAGS = [];
    try { ALL_TAGS = JSON.parse(tagEl.getAttribute('data-all-tags') || '[]') || []; } catch (e) { ALL_TAGS = []; }

    var FIXED_TAGS_BY_CATEGORY = {
      'Český Fotbal': ['Chance Liga', 'Chance Národní liga', 'Reprezentace', 'Ostatní'],
      'Ženský Fotbal': ['Fortuna Liga', 'Reprezentace', 'Ostatní'],
      'Světový Fotbal': ['Svět', 'Evropa', 'Ostatní'],
    };
    var STRICT_FIXED_TAGS_CATEGORIES = {
      'Český Fotbal': true,
      'Světový Fotbal': true,
      'Ženský Fotbal': true,
    };
    var USE_ALL_TAGS_CATEGORIES = {
      'Zápasy': true,
      'Rozhovory': true,
      'Analýzy': true,
    };
    var EXTRA_TAGS_BY_CATEGORY = {
      'Zápasy': ['Svět', 'Evropa', 'Ostatní'],
      'Rozhovory': ['Svět', 'Evropa', 'Ostatní'],
      'Analýzy': ['Svět', 'Evropa', 'Ostatní'],
    };

    function uniq(arr) {
      var out = [];
      var seen = {};
      for (var i = 0; i < arr.length; i++) {
        var v = String(arr[i] || '').trim();
        if (!v) continue;
        if (seen[v]) continue;
        seen[v] = true;
        out.push(v);
      }
      return out;
    }

    function setOptions(values, selected) {
      var sel = selected != null ? String(selected) : '';
      tagEl.innerHTML = '';

      var opt0 = document.createElement('option');
      opt0.value = '';
      opt0.textContent = '- žádný -';
      if (!sel) opt0.selected = true;
      tagEl.appendChild(opt0);

      if (sel && values.indexOf(sel) === -1) {
        var o = document.createElement('option');
        o.value = sel;
        o.textContent = sel;
        o.selected = true;
        tagEl.appendChild(o);
      }

      for (var i = 0; i < values.length; i++) {
        var v = values[i];
        var opt = document.createElement('option');
        opt.value = v;
        opt.textContent = v;
        if (sel && v === sel) opt.selected = true;
        tagEl.appendChild(opt);
      }
    }

    function refreshTags() {
      var cat = String(catEl.value || '').trim();
      var fixed = FIXED_TAGS_BY_CATEGORY[cat];
      var extra = EXTRA_TAGS_BY_CATEGORY[cat] || [];
      var values = [];
      if (STRICT_FIXED_TAGS_CATEGORIES[cat] && fixed && fixed.length) {
        values = uniq(fixed);
      } else {
        values = uniq(
          USE_ALL_TAGS_CATEGORIES[cat]
            ? ALL_TAGS.concat(extra)
            : (fixed && fixed.length ? fixed.concat(ALL_TAGS, extra) : ALL_TAGS.concat(extra))
        );
      }
      setOptions(values, tagEl.value);
    }

    catEl.addEventListener('change', refreshTags);
    refreshTags();
  })();
</script>

