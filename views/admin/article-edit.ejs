<%- include('../partials/admin-layout-start') %>
<% 
  var a = article || {}; 
  var f = typeof form !== 'undefined' && form ? form : {}; 
  function val(k) { 
    if (f[k] != null && f[k] !== '') return f[k]; 
    if (a[k] != null && a[k] !== '') return a[k]; 
    return ''; 
  }
  var st = a.status || 'draft'; 
  var isNew = !article || !article.id; 
  var canPub = typeof hasAnyRole === 'function'
    ? hasAnyRole(currentUser, 'vedeni', 'sefredaktor')
    : (currentUser && (currentUser.role === 'vedeni' || currentUser.role === 'sefredaktor'));
  var canRequestPublish = typeof isRedaktorWorkflow === 'function'
    ? isRedaktorWorkflow(currentUser)
    : (currentUser && currentUser.role === 'redaktor');
  var schedVal = typeof scheduledAtLocal !== 'undefined' ? scheduledAtLocal : '';
  var schedMin = typeof scheduledAtMin !== 'undefined' ? scheduledAtMin : '';
  var heroPosVal = String(val('hero_position') || a.hero_position || '50% 50%').trim();
  var heroCardPosVal = String(
    val('hero_card_position') || a.hero_card_position || val('hero_position') || a.hero_position || '50% 50%'
  ).trim();
  var heroSliderMobilePosVal = String(
    val('hero_slider_mobile_position') || a.hero_slider_mobile_position || val('hero_position') || a.hero_position || '50% 50%'
  ).trim();
  var heroSliderDesktopPosVal = String(
    val('hero_slider_desktop_position') || a.hero_slider_desktop_position || val('hero_position') || a.hero_position || '50% 50%'
  ).trim();
  var lineupInitialRaw = val('lineup_json') || a.lineup_json || '';
  var lineupInitialJson = '';
  try {
    if (lineupInitialRaw) {
      var _parsedLineup = typeof lineupInitialRaw === 'string' ? JSON.parse(lineupInitialRaw) : lineupInitialRaw;
      lineupInitialJson = JSON.stringify(_parsedLineup);
    }
  } catch (e) {
    lineupInitialJson = '';
  }
%>
<div class="border-b border-white/10 pb-6">
  <h1 class="text-2xl font-bold text-white md:text-3xl"><%= isNew ? 'Nový článek' : 'Upravit článek' %></h1>
  <% if (!isNew) { %><p class="mt-2 text-sm text-11muted break-words">Stav: <strong class="text-11accent"><%= st %></strong> · slug <code class="text-slate-400 break-all"><%= a.slug %></code></p><% } %>
</div>

<% if (error) { %><p class="mt-6 rounded-lg border border-red-500/40 bg-red-500/10 px-3 py-2 text-sm text-red-200"><%= error %></p><% } %>
<% if (success) { %><p class="mt-6 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-3 py-2 text-sm text-emerald-200"><%= success %></p><% } %>

<form id="article-form" class="mt-8 space-y-6" method="post" action="<%= isNew ? '/administrace/clanek/novy' : '/administrace/clanek/' + a.id + '/edit' %>" enctype="multipart/form-data">
  <div class="card-11 space-y-4 p-4 sm:p-6">
    <div>
      <% var titleMax = typeof titleMax !== 'undefined' ? titleMax : 100; %>
      <label class="text-xs text-11muted" for="title">Nadpis</label>
      <input id="title" name="title" type="text" required maxlength="<%= titleMax %>" value="<%= val('title') %>" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
      <p id="title-counter" class="mt-1 text-xs text-11muted">0 / <%= titleMax %></p>
    </div>
    <div>
      <label class="text-xs text-11muted" for="slug">Slug (URL, volitelné)</label>
      <input id="slug" name="slug" type="text" value="<%= val('slug') %>" placeholder="napr. slavia-vyhrala" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
    </div>
    <div>
      <label class="text-xs text-11muted" for="category">Kategorie</label>
      <%
        var cats = (typeof categories !== 'undefined' && Array.isArray(categories)) ? categories : [];
        var currentCat = String(val('category') || '').trim();
        var hasCurrent = currentCat && cats.some(function (c) { return String(c || '').trim() === currentCat; });
      %>
      <select id="category" name="category" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white">
        <option value="" <%= !currentCat ? 'selected' : '' %>>- vyberte -</option>
        <% if (currentCat && !hasCurrent) { %>
        <option value="<%= currentCat %>" selected><%= currentCat %></option>
        <% } %>
        <% cats.forEach(function (c) { %>
        <option value="<%= c %>" <%= currentCat === String(c) ? 'selected' : '' %>><%= c %></option>
        <% }); %>
      </select>
    </div>
    <div>
      <label class="text-xs text-11muted" for="tag">Štítek</label>
      <%
        var tgs = (typeof tags !== 'undefined' && Array.isArray(tags)) ? tags : [];
        var currentTag = String(val('tag') || '').trim();
        var hasCurrentTag = currentTag && tgs.some(function (t) { return String(t || '').trim() === currentTag; });
      %>
      <select id="tag" name="tag" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" data-all-tags="<%= JSON.stringify(tgs) %>">
        <option value="" <%= !currentTag ? 'selected' : '' %>>- žádný -</option>
        <% if (currentTag && !hasCurrentTag) { %>
        <option value="<%= currentTag %>" selected><%= currentTag %></option>
        <% } %>
        <% tgs.forEach(function (t) { %>
        <option value="<%= t %>" <%= currentTag === String(t) ? 'selected' : '' %>><%= t %></option>
        <% }); %>
      </select>
    </div>
    <div>
      <% var excerptMax = typeof excerptMax !== 'undefined' ? excerptMax : 250; %>
      <label class="text-xs text-11muted" for="excerpt">Perex (krátký úvod)</label>
      <div class="relative mt-1">
        <textarea id="excerpt" name="excerpt" rows="3" maxlength="<%= excerptMax %>" class="input-11 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white"><%= val('excerpt') %></textarea>
      </div>
      <p id="excerpt-counter" class="mt-1 text-xs text-11muted">0 / <%= excerptMax %></p>
    </div>
    <%
      var canPickAuthor = typeof hasRole === 'function'
        ? hasRole(currentUser, 'vedeni')
        : (currentUser && currentUser.role === 'vedeni');
      var authorsList = typeof authors !== 'undefined' && authors ? authors : [];
      var currentAuthorId = String(val('author_id') || (a.author_id != null ? a.author_id : (currentUser && currentUser.id)) || '');
    %>
    <% if (canPickAuthor && authorsList.length) { %>
    <div>
      <label class="text-xs text-11muted" for="author_id">Autor článku</label>
      <select id="author_id" name="author_id" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white">
        <% authorsList.forEach(function (u) { %>
        <option value="<%= u.id %>" <%= String(u.id) === currentAuthorId ? 'selected' : '' %>>
          <%= u.display_name || u.email %> (<%= u.email %>)
        </option>
        <% }); %>
      </select>
      <p class="mt-1 text-xs text-11muted">Článek se zveřejní pod vybraným účtem.</p>
    </div>
    <% } %>
  </div>

  <div class="card-11 space-y-5 p-4 sm:p-6">
    <h2 class="text-sm font-semibold text-white">Týmy, související a rubrika</h2>
    <%
      var clubs = typeof chanceLigaClubs !== 'undefined' && chanceLigaClubs ? chanceLigaClubs : [];
      var selectedTeams = typeof selectedTeamCodes !== 'undefined' && selectedTeamCodes ? selectedTeamCodes : [];
      var selectedRelated = typeof selectedRelatedIds !== 'undefined' && selectedRelatedIds ? selectedRelatedIds.map(String) : [];
      var relatedList = typeof relatedPickerArticles !== 'undefined' && relatedPickerArticles ? relatedPickerArticles : [];
      var rubricList = typeof rubrics !== 'undefined' && rubrics ? rubrics : [];
      var currentRubric = String(val('rubric_slug') || a.rubric_slug || '').trim();
      var isRubricOn = currentRubric ? true : false;
    %>
    <div>
      <p class="text-xs text-11muted">Zmíněné týmy Chance Ligy</p>
      <div class="mt-2 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
        <% clubs.forEach(function (club) { %>
        <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-white/10 bg-[#111827] px-2.5 py-2 text-sm text-slate-200">
          <input type="checkbox" name="mentioned_teams" value="<%= club.code %>" class="rounded border-white/20 bg-[#0b1220] text-11accent focus:ring-11accent/40" <%= selectedTeams.indexOf(club.code) !== -1 ? 'checked' : '' %> />
          <img src="<%= club.logo %>" alt="" class="h-6 w-6 object-contain" width="24" height="24" />
          <span class="min-w-0 truncate"><%= club.name %></span>
        </label>
        <% }); %>
      </div>
    </div>

    <div>
      <label class="inline-flex cursor-pointer items-center gap-2 text-sm text-slate-200">
        <input id="is_rubric" name="is_rubric" type="checkbox" value="1" class="rounded border-white/20 bg-[#111827] text-11accent focus:ring-11accent/40" <%= isRubricOn ? 'checked' : '' %> />
        Je to rubrika
      </label>
      <div id="rubric-select-wrap" class="mt-3 <%= isRubricOn ? '' : 'hidden' %>">
        <label class="text-xs text-11muted" for="rubric_slug">Která rubrika</label>
        <select id="rubric_slug" name="rubric_slug" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white">
          <option value="">- vyberte -</option>
          <% rubricList.forEach(function (r) { %>
          <option value="<%= r.slug %>" <%= currentRubric === r.slug ? 'selected' : '' %>><%= r.label %></option>
          <% }); %>
        </select>
      </div>
    </div>

    <div>
      <label class="text-xs text-11muted" for="match_key">Zápas Chance Ligy</label>
      <p class="mt-0.5 text-xs text-11muted">Když článek patří ke konkrétnímu zápasu, vyberte ho. Ukáže se u článku i v detailu zápasu.</p>
      <%
        var matchPicker = typeof matchPickerMatches !== 'undefined' && matchPickerMatches ? matchPickerMatches : [];
        var currentMatchKey = String(typeof selectedMatchKey !== 'undefined' && selectedMatchKey ? selectedMatchKey : (val('match_key') || a.match_key || '')).trim();
      %>
      <select id="match_key" name="match_key" class="input-11 mt-2 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white">
        <option value="">— není o konkrétním zápase —</option>
        <% matchPicker.forEach(function (m) { %>
        <%
          var when = '';
          try {
            var ts = Date.parse(m.kickoff || m.date || '');
            if (Number.isFinite(ts)) {
              when = new Date(ts).toLocaleString('cs-CZ', { day: 'numeric', month: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Prague' });
            }
          } catch (e) {}
        %>
        <option value="<%= m.matchKey %>" <%= currentMatchKey === m.matchKey ? 'selected' : '' %>>
          <%= m.homeLabel || m.home %> – <%= m.awayLabel || m.away %><% if (when) { %> · <%= when %><% } %>
        </option>
        <% }); %>
      </select>
    </div>

    <div>
      <p class="text-xs text-11muted">Související články</p>
      <p class="mt-0.5 text-xs text-11muted">Zaškrtněte ručně. Když nic nevyberete, web doplní automaticky podle kategorie.</p>
      <input id="related-filter" type="search" placeholder="Hledat v posledních článcích…" class="input-11 mt-2 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
      <div class="mt-2 max-h-64 space-y-1 overflow-y-auto rounded-xl border border-white/10 bg-[#0f1729]/70 p-2">
        <% if (!relatedList.length) { %>
        <p class="px-2 py-3 text-xs text-11muted">Zatím nejsou jiné publikované články.</p>
        <% } %>
        <% relatedList.forEach(function (item) { %>
        <label class="js-related-item flex cursor-pointer items-start gap-2 rounded-lg px-2 py-1.5 text-sm text-slate-200 hover:bg-white/5" data-title="<%= String(item.title || '').toLowerCase() %>">
          <input type="checkbox" name="related_ids" value="<%= item.id %>" class="mt-0.5 rounded border-white/20 bg-[#0b1220] text-11accent focus:ring-11accent/40" <%= selectedRelated.indexOf(String(item.id)) !== -1 ? 'checked' : '' %> />
          <span class="min-w-0">
            <span class="block leading-snug text-white"><%= item.title %></span>
            <span class="block text-xs text-11muted"><%= item.slug %></span>
          </span>
        </label>
        <% }); %>
      </div>
    </div>
  </div>

  <div class="card-11 space-y-4 p-4 sm:p-6">
    <h2 class="text-sm font-semibold text-white">Titulní obrázek</h2>
    <% if (a.hero_image_path) { %>
    <div class="hero-credit-wrap relative max-h-48 overflow-hidden rounded-xl ring-1 ring-white/10">
      <img src="<%= a.hero_image_path %>" alt="" class="js-hero-preview-thumb max-h-48 w-full object-cover" style="object-position: <%= heroPosVal %>;" />
      <% if (a.hero_credit) { %>
      <figcaption class="hero-credit-pill pointer-events-none">
        <%- include('../partials/hero-credit-badge', { credit: a.hero_credit }) %>
      </figcaption>
      <% } %>
    </div>
    <% } %>
    <div>
      <label class="text-xs text-11muted" for="hero"><%= a.hero_image_path ? 'Nahradit obrázkem' : 'Nahrát obrázek' %></label>
      <input id="hero" name="hero" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="mt-1 block w-full min-w-0 text-sm text-11muted file:mr-3 file:rounded-lg file:border-0 file:bg-11accent file:px-3 file:py-2 file:text-sm file:font-medium file:text-11bg sm:w-auto" />
    </div>
    <div class="hero-admin-previews rounded-xl border border-white/10 bg-[#0f1729]/70 p-3">
      <p class="text-xs text-11muted">Každý náhled má vlastní výřez - táhněte myší přímo v náhledu.</p>
      <div class="hero-admin-previews__grid mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="hero-admin-previews__item">
          <p class="mb-1.5 text-xs font-medium text-slate-300">V článku</p>
          <div id="hero-live-frame" class="hero-admin-preview hero-admin-preview--article relative w-full cursor-move">
            <img
              id="hero-live-image"
              src="<%= a.hero_image_path || '' %>"
              alt=""
              class="js-hero-preview-img aspect-[21/9] w-full object-cover select-none sm:aspect-[2/1]"
              style="object-position: <%= heroPosVal %>; <%= a.hero_image_path ? '' : 'display:none;' %>"
              draggable="false"
            />
            <div id="hero-live-empty" class="js-hero-preview-empty hero-admin-preview__empty <%= a.hero_image_path ? 'hidden' : '' %>">
              Zatím není vybraná titulní fotka
            </div>
          </div>
        </div>
        <div class="hero-admin-previews__item">
          <p class="mb-1.5 text-xs font-medium text-slate-300">Hlavní stránka - mobil</p>
          <div id="hero-slider-mobile-frame" class="hero-admin-preview hero-admin-preview--home-slider relative w-full cursor-move">
            <img
              src="<%= a.hero_image_path || '' %>"
              alt=""
              class="js-hero-preview-img hero-admin-preview__img"
              data-hero-preview="slider-mobile"
              style="object-position: <%= heroSliderMobilePosVal %>; <%= a.hero_image_path ? '' : 'display:none;' %>"
              draggable="false"
            />
            <div class="js-hero-preview-empty hero-admin-preview__empty <%= a.hero_image_path ? 'hidden' : '' %>">
              Zatím není vybraná titulní fotka
            </div>
          </div>
        </div>
        <div class="hero-admin-previews__item">
          <p class="mb-1.5 text-xs font-medium text-slate-300">Hlavní stránka - desktop</p>
          <div id="hero-slider-desktop-frame" class="hero-admin-preview hero-admin-preview--home-slider-desktop relative w-full cursor-move">
            <img
              src="<%= a.hero_image_path || '' %>"
              alt=""
              class="js-hero-preview-img hero-admin-preview__img"
              data-hero-preview="slider-desktop"
              style="object-position: <%= heroSliderDesktopPosVal %>; <%= a.hero_image_path ? '' : 'display:none;' %>"
              draggable="false"
            />
            <div class="js-hero-preview-empty hero-admin-preview__empty <%= a.hero_image_path ? 'hidden' : '' %>">
              Zatím není vybraná titulní fotka
            </div>
          </div>
        </div>
        <div class="hero-admin-previews__item">
          <p class="mb-1.5 text-xs font-medium text-slate-300">Karta článku (výpis)</p>
          <div id="hero-card-frame" class="hero-admin-preview hero-admin-preview--card relative w-full cursor-move">
            <img
              src="<%= a.hero_image_path || '' %>"
              alt=""
              class="js-hero-preview-img js-hero-preview-card hero-admin-preview__img"
              data-hero-preview="card"
              style="object-position: <%= heroCardPosVal %>; <%= a.hero_image_path ? '' : 'display:none;' %>"
              draggable="false"
            />
            <div class="js-hero-preview-empty hero-admin-preview__empty <%= a.hero_image_path ? 'hidden' : '' %>">
              Zatím není vybraná titulní fotka
            </div>
          </div>
        </div>
      </div>
    </div>
    <div>
      <label class="text-xs text-11muted" for="hero_credit">Credit / autor fotky (povinné u titulního obrázku)</label>
      <input id="hero_credit" name="hero_credit" type="text" value="<%= val('hero_credit') %>" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
    </div>
  </div>

  <div class="card-11 p-4 sm:p-6">
    <h2 class="text-sm font-semibold text-white">Obsah článku</h2>
    <p class="mt-1 text-xs text-11muted">Toolbar: <strong class="text-slate-400">Embed</strong> vloží náhled z X / YouTube (URL). U obrázku můžete měnit velikost a zarovnání.</p>
    <textarea id="body_html" name="body_html" rows="14" class="input-11 mt-3 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 font-mono text-sm text-white"><%= val('body_html') %></textarea>
  </div>

  <div class="card-11 space-y-4 p-4 sm:p-6">
    <div>
      <label class="text-xs text-11muted" for="sources">Zdroje</label>
      <p class="mt-0.5 text-xs text-11muted">Zobrazí se na konci článku na webu (odkazy, média, citace).</p>
      <textarea id="sources" name="sources" rows="4" placeholder="např. FIFA.com&#10;Reuters - https://…" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white"><%= val('sources') %></textarea>
    </div>
  </div>

  <div class="card-11 space-y-4 p-4 sm:p-6" id="lineup-admin-card">
    <h2 class="text-sm font-semibold text-white">Sestava</h2>
    <label class="inline-flex cursor-pointer items-center gap-2 text-sm text-slate-200">
      <input id="lineup_enabled" type="checkbox" class="rounded border-white/20 bg-[#111827]" />
      Zobrazit sestavu v článku
    </label>

    <div id="lineup-teams-wrap" class="space-y-6 hidden">
      <div class="lineup-admin-team rounded-xl border border-white/10 bg-[#0f1729]/70 p-4" data-team-index="0">
        <p class="text-xs font-medium uppercase tracking-wide text-11muted">Tým 1</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div>
            <label class="text-xs text-11muted">Název týmu</label>
            <input type="text" data-lineup-label class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" placeholder="např. Sparta Praha" />
          </div>
          <div>
            <label class="text-xs text-11muted">Formace</label>
            <input type="text" data-lineup-formation class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
          </div>
        </div>
        <p class="lineup-player-count mt-2 text-xs text-11muted"></p>
        <div class="lineup-players-grid mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3"></div>
      </div>

      <label class="inline-flex cursor-pointer items-center gap-2 text-sm text-slate-200">
        <input id="lineup_second_team" type="checkbox" class="rounded border-white/20 bg-[#111827]" />
        Přidat druhý tým (hosté)
      </label>

      <div id="lineup-team-2" class="lineup-admin-team hidden rounded-xl border border-white/10 bg-[#0f1729]/70 p-4" data-team-index="1">
        <p class="text-xs font-medium uppercase tracking-wide text-11muted">Tým 2</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div>
            <label class="text-xs text-11muted">Název týmu</label>
            <input type="text" data-lineup-label class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" placeholder="např. Slavia Praha" />
          </div>
          <div>
            <label class="text-xs text-11muted">Formace</label>
            <input type="text" data-lineup-formation class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
          </div>
        </div>
        <p class="lineup-player-count mt-2 text-xs text-11muted"></p>
        <div class="lineup-players-grid mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3"></div>
      </div>
    </div>
  </div>

  <% if (canPub) { %>
  <div class="card-11 space-y-3 p-4 sm:p-6">
    <h2 class="text-sm font-semibold text-white">Naplánovat publikaci</h2>
    <input type="datetime-local" name="scheduled_at" value="<%= schedVal %>"<% if (schedMin) { %> min="<%= schedMin %>"<% } %> class="input-11 rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
    <p class="text-xs text-11muted">Čas v časové zóně Praha (CET/CEST). Vyberte datum a použijte tlačítko „Naplánovat“ níže.</p>
  </div>
  <% } %>

  <input id="hero_position" name="hero_position" type="hidden" value="<%= heroPosVal %>" />
  <input id="hero_card_position" name="hero_card_position" type="hidden" value="<%= heroCardPosVal %>" />
  <input id="hero_slider_mobile_position" name="hero_slider_mobile_position" type="hidden" value="<%= heroSliderMobilePosVal %>" />
  <input id="hero_slider_desktop_position" name="hero_slider_desktop_position" type="hidden" value="<%= heroSliderDesktopPosVal %>" />
  <input id="lineup_json" name="lineup_json" type="hidden" value="" />
  <input type="hidden" name="action" id="article-form-action" value="save" />

  <div class="flex flex-wrap gap-3">
    <button type="submit" data-article-action="save" class="btn-11 btn-11--ghost">Uložit</button>
