<script>
  (function () {
    var input = document.getElementById('hero');
    var img = document.getElementById('hero-live-image');
    var previewEmpties = document.querySelectorAll('.js-hero-preview-empty');
    if (!input || !img) return;

    function parsePosition(raw) {
      var m = String(raw || '').trim().match(/^(\d{1,3}(?:\.\d+)?)%\s+(\d{1,3}(?:\.\d+)?)%$/);
      if (!m) return { x: 50, y: 50 };
      var x = Number(m[1]);
      var y = Number(m[2]);
      if (!Number.isFinite(x) || !Number.isFinite(y)) return { x: 50, y: 50 };
      return { x: clamp(x, 0, 100), y: clamp(y, 0, 100) };
    }

    function clamp(v, min, max) {
      return Math.max(min, Math.min(max, v));
    }

    function formatPos(v) {
      return Math.round(v * 10) / 10;
    }

    function hasPreviewImage() {
      return img.style.display !== 'none' && !!img.getAttribute('src');
    }

    var previewConfigs = [
      {
        frame: document.getElementById('hero-live-frame'),
        input: document.getElementById('hero_position'),
        targets: [img].concat(Array.prototype.slice.call(document.querySelectorAll('.js-hero-preview-thumb'))),
      },
      {
        frame: document.getElementById('hero-slider-mobile-frame'),
        input: document.getElementById('hero_slider_mobile_position'),
        targets: [document.querySelector('[data-hero-preview="slider-mobile"]')].filter(Boolean),
      },
      {
        frame: document.getElementById('hero-slider-desktop-frame'),
        input: document.getElementById('hero_slider_desktop_position'),
        targets: [document.querySelector('[data-hero-preview="slider-desktop"]')].filter(Boolean),
      },
      {
        frame: document.getElementById('hero-card-frame'),
        input: document.getElementById('hero_card_position'),
        targets: [document.querySelector('[data-hero-preview="card"]')].filter(Boolean),
      },
    ].filter(function (cfg) {
      return cfg.frame && cfg.input && cfg.targets.length;
    });

    if (!previewConfigs.length) return;

    var states = previewConfigs.map(function (cfg) {
      var start = parsePosition(cfg.input.value);
      return {
        cfg: cfg,
        x: start.x,
        y: start.y,
      };
    });

    var activeState = null;
    var lastX = 0;
    var lastY = 0;

    function applyState(state) {
      state.x = formatPos(clamp(state.x, 0, 100));
      state.y = formatPos(clamp(state.y, 0, 100));
      var pos = state.x + '% ' + state.y + '%';
      state.cfg.targets.forEach(function (el) {
        el.style.objectPosition = pos;
      });
      state.cfg.input.value = pos;
    }

    function syncAllHeroPositionsBeforeSubmit() {
      states.forEach(applyState);
      window.dispatchEvent(new CustomEvent('hero-preview-updated'));
    }

    window.syncHeroPositionBeforeSubmit = syncAllHeroPositionsBeforeSubmit;
    window.syncHeroCardPositionBeforeSubmit = syncAllHeroPositionsBeforeSubmit;

    function showPreviews(url) {
      document.querySelectorAll('.js-hero-preview-img').forEach(function (el) {
        el.src = url;
        el.style.display = '';
      });
      document.querySelectorAll('.js-hero-preview-thumb').forEach(function (el) {
        el.src = url;
      });
      previewEmpties.forEach(function (el) {
        el.classList.add('hidden');
      });
    }

    function bindDrag(state) {
      var frame = state.cfg.frame;

      frame.addEventListener('mousedown', function (e) {
        if (!hasPreviewImage()) return;
        activeState = state;
        lastX = e.clientX;
        lastY = e.clientY;
      });

      frame.addEventListener('touchstart', function (e) {
        if (!hasPreviewImage()) return;
        if (!e.touches || !e.touches[0]) return;
        activeState = state;
        lastX = e.touches[0].clientX;
        lastY = e.touches[0].clientY;
      }, { passive: true });
    }

    window.addEventListener('mousemove', function (e) {
      if (!activeState) return;
      var dx = e.clientX - lastX;
      var dy = e.clientY - lastY;
      lastX = e.clientX;
      lastY = e.clientY;
      activeState.x = clamp(activeState.x + dx * 0.22, 0, 100);
      activeState.y = clamp(activeState.y + dy * 0.22, 0, 100);
      applyState(activeState);
    });

    window.addEventListener('touchmove', function (e) {
      if (!activeState) return;
      var touch = e.touches && e.touches[0];
      if (!touch) return;
      var dx = touch.clientX - lastX;
      var dy = touch.clientY - lastY;
      lastX = touch.clientX;
      lastY = touch.clientY;
      activeState.x = clamp(activeState.x + dx * 0.22, 0, 100);
      activeState.y = clamp(activeState.y + dy * 0.22, 0, 100);
      applyState(activeState);
    });

    window.addEventListener('mouseup', function () {
      activeState = null;
    });

    window.addEventListener('touchend', function () {
      activeState = null;
    }, { passive: true });

    states.forEach(function (state) {
      bindDrag(state);
      applyState(state);
    });

    input.addEventListener('change', function () {
      var file = input.files && input.files[0];
      if (!file) return;
      var url = URL.createObjectURL(file);
      showPreviews(url);
      states.forEach(function (state) {
        state.x = 50;
        state.y = 50;
        applyState(state);
      });
    });
  })();
</script>

<script src="/js/lineup-positions.js"></script>
<script>
  (function () {
    var enabledEl = document.getElementById('lineup_enabled');
    var teamsWrap = document.getElementById('lineup-teams-wrap');
    var secondTeamEl = document.getElementById('lineup_second_team');
    var team2Wrap = document.getElementById('lineup-team-2');
    var hiddenInput = document.getElementById('lineup_json');
    var initialRaw = <%- lineupInitialJson ? lineupInitialJson : 'null' %>;

    if (!enabledEl || !teamsWrap || !hiddenInput) return;

    function parseFormation(str) {
      var raw = String(str || '').trim();
      if (!raw || !/^\d+(?:-\d+)*$/.test(raw)) return null;
      var parts = raw.split('-');
      var lines = [];
      for (var i = 0; i < parts.length; i += 1) {
        var n = parseInt(parts[i], 10);
        if (!Number.isFinite(n) || n < 1 || n > 9) return null;
        lines.push(n);
      }
      return lines.length ? lines : null;
    }

    function playerCount(lines) {
      if (!lines || !lines.length) return 0;
      var sum = 0;
      for (var i = 0; i < lines.length; i += 1) sum += lines[i];
      return 1 + sum;
    }

    function playerAt(prev, index) {
      var p = prev[index];
      if (!p) return { name: '', number: '' };
      if (typeof p === 'string') return { name: p, number: '' };
      return {
        name: p.name != null ? p.name : '',
        number: p.number != null && p.number !== '' ? String(p.number) : '',
      };
    }

    function collectPlayers(container) {
      var rows = container.querySelectorAll('[data-lineup-player]');
      var players = [];
      for (var i = 0; i < rows.length; i += 1) {
        var row = rows[i];
        var nameEl = row.querySelector('[data-lineup-player-name]');
        var numberEl = row.querySelector('[data-lineup-player-number]');
        var name = nameEl ? nameEl.value.trim() : '';
        var numberRaw = numberEl ? numberEl.value.trim() : '';
        var number = numberRaw ? parseInt(numberRaw, 10) : null;
        players.push({
          name: name,
          number: Number.isFinite(number) && number >= 1 && number <= 99 ? number : null,
        });
      }
      return players;
    }

    function renderPlayers(teamEl, players) {
      var formationInput = teamEl.querySelector('[data-lineup-formation]');
      var grid = teamEl.querySelector('.lineup-players-grid');
      var countEl = teamEl.querySelector('.lineup-player-count');
      if (!formationInput || !grid || !countEl) return;

      var lines = parseFormation(formationInput.value);
      var prev = players || collectPlayers(teamEl);
      grid.innerHTML = '';

      if (!lines) {
        countEl.textContent = 'Zadejte platnou formaci.';
        return;
      }

      var total = playerCount(lines);
      var outfield = total - 1;
      if (outfield !== 10) {
        countEl.textContent = 'Formace má ' + outfield + ' hráčů v poli - musí být 10 (+ brankář).';
        return;
      }

      countEl.textContent = 'Formace ' + formationInput.value.trim() + ' = ' + total + ' hráčů';

      var positionLabels =
        window.LineupPositions && typeof window.LineupPositions.positionLabelsForFormation === 'function'
          ? window.LineupPositions.positionLabelsForFormation(lines)
          : ['Brankář'];

      function addField(label, index) {
        var data = playerAt(prev, index);
        var wrap = document.createElement('div');
        wrap.setAttribute('data-lineup-player', '1');

        var lab = document.createElement('label');
        lab.className = 'text-xs text-11muted';
        lab.textContent = label;

        var row = document.createElement('div');
        row.className = 'mt-1 flex gap-2';

        var numberInput = document.createElement('input');
        numberInput.type = 'number';
        numberInput.min = '1';
        numberInput.max = '99';
        numberInput.setAttribute('data-lineup-player-number', '1');
        numberInput.className =
          'input-11 w-16 shrink-0 rounded-xl border border-white/10 bg-[#111827] px-2 py-2 text-center text-sm text-white';
        numberInput.value = data.number !== '' ? data.number : String(index + 1);
        numberInput.placeholder = '#';
        numberInput.title = 'Číslo dresu';

        var nameInput = document.createElement('input');
        nameInput.type = 'text';
        nameInput.setAttribute('data-lineup-player-name', '1');
        nameInput.className =
          'input-11 min-w-0 flex-1 rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white';
        nameInput.value = data.name;
        nameInput.placeholder = 'Jméno hráče';

        row.appendChild(numberInput);
        row.appendChild(nameInput);
        wrap.appendChild(lab);
        wrap.appendChild(row);
        grid.appendChild(wrap);
      }

      for (var idx = 0; idx < positionLabels.length; idx += 1) {
        addField(positionLabels[idx], idx);
      }
    }

    function getTeamEls() {
      var teams = [document.querySelector('.lineup-admin-team[data-team-index="0"]')];
      if (secondTeamEl && secondTeamEl.checked && team2Wrap) teams.push(team2Wrap);
      return teams.filter(Boolean);
    }

    function syncLineupJson() {
      if (!enabledEl.checked) {
        hiddenInput.value = JSON.stringify({ enabled: false, teams: [] });
        return;
      }

      var teams = [];
      var teamEls = getTeamEls();
      for (var i = 0; i < teamEls.length; i += 1) {
        var teamEl = teamEls[i];
        var label = teamEl.querySelector('[data-lineup-label]').value.trim();
        var formation = teamEl.querySelector('[data-lineup-formation]').value.trim();
        var lines = parseFormation(formation);
        if (!lines) continue;
        teams.push({
          label: label,
          formation: formation,
          players: collectPlayers(teamEl),
        });
      }

      hiddenInput.value = JSON.stringify({ enabled: true, teams: teams });
    }

    window.syncLineupBeforeSubmit = syncLineupJson;

    function toggleEnabled() {
      teamsWrap.classList.toggle('hidden', !enabledEl.checked);
      syncLineupJson();
    }

    function toggleSecondTeam() {
      if (!team2Wrap || !secondTeamEl) return;
      team2Wrap.classList.toggle('hidden', !secondTeamEl.checked);
      syncLineupJson();
    }

    function bindTeam(teamEl) {
      var formationInput = teamEl.querySelector('[data-lineup-formation]');
      if (formationInput) {
        formationInput.addEventListener('input', function () {
          renderPlayers(teamEl);
          syncLineupJson();
        });
      }
      teamEl.addEventListener('input', syncLineupJson);
    }

    document.querySelectorAll('.lineup-admin-team').forEach(bindTeam);
    enabledEl.addEventListener('change', toggleEnabled);
    if (secondTeamEl) secondTeamEl.addEventListener('change', toggleSecondTeam);

    if (initialRaw && initialRaw.enabled !== false && Array.isArray(initialRaw.teams) && initialRaw.teams.length) {
      enabledEl.checked = true;
      teamsWrap.classList.remove('hidden');
      var t0 = initialRaw.teams[0];
      if (t0) {
        var team0 = document.querySelector('.lineup-admin-team[data-team-index="0"]');
        if (team0) {
          team0.querySelector('[data-lineup-label]').value = t0.label || '';
          team0.querySelector('[data-lineup-formation]').value = t0.formation || '';
          renderPlayers(team0, t0.players || []);
        }
      }
      if (initialRaw.teams.length > 1 && secondTeamEl && team2Wrap) {
        secondTeamEl.checked = true;
        team2Wrap.classList.remove('hidden');
        var t1 = initialRaw.teams[1];
        team2Wrap.querySelector('[data-lineup-label]').value = t1.label || '';
        team2Wrap.querySelector('[data-lineup-formation]').value = t1.formation || '';
        renderPlayers(team2Wrap, t1.players || []);
      }
    } else {
      document.querySelectorAll('.lineup-admin-team').forEach(function (teamEl) {
        renderPlayers(teamEl, []);
      });
    }

    syncLineupJson();
  })();
</script>

<script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js"></script>
<script>
(function () {
  function bindCounter(inputId, counterId) {
    var input = document.getElementById(inputId);
    var counter = document.getElementById(counterId);
    if (!input || !counter) return;
    function refresh() {
      var max = Number(input.getAttribute('maxlength') || 0);
      var length = String(input.value || '').length;
      counter.textContent = length + ' / ' + max;
      counter.classList.toggle('text-amber-300', max > 0 && length > max);
    }
    input.addEventListener('input', refresh);
    refresh();
  }
  bindCounter('title', 'title-counter');
  bindCounter('excerpt', 'excerpt-counter');
})();
</script>
