        var obs = new MutationObserver(function (mutations) {
          mutations.forEach(function (m) {
            m.addedNodes.forEach(function (node) {
              var imgs = [];
              if (node.nodeName === 'IMG') imgs.push(node);
              else if (node.querySelectorAll) imgs = Array.from(node.querySelectorAll('img'));
              imgs.forEach(function (img) {
                if (!img.style.marginLeft && !img.style.float) {
                  img.style.display = 'block';
                  img.style.marginLeft = 'auto';
                  img.style.marginRight = 'auto';
                }
              });
            });
          });
        });
        obs.observe(editor.getBody(), { childList: true, subtree: true });
      });

      function selectedImage() {
        return editor.dom.getParent(editor.selection.getNode(), 'img');
      }

      function ensureImageBase(img) {
        if (!img) return;
        editor.dom.setStyles(img, {
          display: 'block',
          maxWidth: '100%',
          height: 'auto',
          float: 'none',
        });
      }

      function requireImage() {
        var img = selectedImage();
        if (!img) {
          alert('Nejprve klikněte na obrázek v editoru.');
          return null;
        }
        return img;
      }

      function setImageAlign(mode) {
        var img = requireImage();
        if (!img) return;
        ensureImageBase(img);
        if (mode === 'left') {
          editor.dom.setStyles(img, { marginLeft: '0', marginRight: 'auto' });
        } else if (mode === 'right') {
          editor.dom.setStyles(img, { marginLeft: 'auto', marginRight: '0' });
        } else {
          editor.dom.setStyles(img, { marginLeft: 'auto', marginRight: 'auto' });
        }
        editor.nodeChanged();
      }

      function resizeImage(step) {
        var img = requireImage();
        if (!img) return;
        ensureImageBase(img);
        var current = img.style.width ? parseInt(img.style.width, 10) : 100;
        if (!Number.isFinite(current) || current <= 0) current = 100;
        var next = Math.max(20, Math.min(100, current + step));
        editor.dom.setStyle(img, 'width', next + '%');
        editor.nodeChanged();
      }

      editor.ui.registry.addButton('imgleft', {
        text: 'Img vlevo',
        onAction: function () { setImageAlign('left'); },
      });

      editor.ui.registry.addButton('imgcenter', {
        text: 'Img střed',
        onAction: function () { setImageAlign('center'); },
      });

      editor.ui.registry.addButton('imgright', {
        text: 'Img vpravo',
        onAction: function () { setImageAlign('right'); },
      });

      editor.ui.registry.addButton('imgsmaller', {
        text: 'Img -',
        onAction: function () { resizeImage(-10); },
      });

      editor.ui.registry.addButton('imgbigger', {
        text: 'Img +',
        onAction: function () { resizeImage(10); },
      });

      function applyCredit(img, credit, pos) {
        var fig = editor.dom.getParent(img, 'figure.article-img-credit-wrap');
        if (!credit) {
          if (fig) {
            // Restore img styles from figure and unwrap
            var innerImg = editor.dom.select('img', fig)[0];
            if (innerImg && fig.style.width) editor.dom.setStyle(innerImg, 'width', fig.style.width);
            if (innerImg && fig.style.marginLeft) editor.dom.setStyle(innerImg, 'margin-left', fig.style.marginLeft);
            if (innerImg && fig.style.marginRight) editor.dom.setStyle(innerImg, 'margin-right', fig.style.marginRight);
            editor.dom.setOuterHTML(fig, editor.dom.getOuterHTML(innerImg));
            editor.nodeChanged();
          }
          return;
        }
        var posClass = 'article-img-credit-pill--' + (pos || 'br');
        if (fig) {
          var cap = editor.dom.select('figcaption', fig)[0];
          if (cap) {
            cap.textContent = credit;
            cap.className = 'article-img-credit-pill ' + posClass;
          }
        } else {
          // Use actual rendered pixel width so figure always matches image exactly
          var iStyle = img.style;
          var figPx = img.offsetWidth;
          // Detect centering: TinyMCE may compute auto→0px on one side
          var rawML = iStyle.marginLeft || '';
          var rawMR = iStyle.marginRight || '';
          var isCentered = (rawML === 'auto' && rawMR === 'auto') ||
                           (rawML === 'auto' || rawMR === 'auto') ||
                           (rawML === '0px' && rawMR === 'auto') ||
                           (rawML === 'auto' && rawMR === '0px');
          var figML = isCentered ? 'auto' : rawML;
          var figMR = isCentered ? 'auto' : rawMR;
          var figFl = iStyle.float || '';
          var figStyleStr = (figPx ? 'width:' + figPx + 'px;' : '') +
            (figML ? 'margin-left:' + figML + ';' : '') +
            (figMR ? 'margin-right:' + figMR + ';' : '') +
            (figFl ? 'float:' + figFl + ';' : '');
          // Strip layout styles from img, set width:100% so img fills the figure
          var imgHTML = editor.dom.getOuterHTML(img).replace(/style="([^"]*)"/, function(_, s) {
            s = s.replace(/(?<![a-z-])width\s*:[^;]+;?\s*/gi, '')
                 .replace(/margin-left\s*:[^;]+;?\s*/gi, '')
                 .replace(/margin-right\s*:[^;]+;?\s*/gi, '')
                 .replace(/float\s*:[^;]+;?\s*/gi, '');
            return 'style="' + s + 'width:100%;"';
          });
          editor.dom.setOuterHTML(img, '<figure class="article-img-credit-wrap" style="' + figStyleStr + '">' + imgHTML + '<figcaption class="article-img-credit-pill ' + posClass + '">' + credit + '</figcaption></figure>');
        }
        editor.nodeChanged();
      }

      editor.ui.registry.addButton('imgcredit', {
        text: 'Credit',
        onAction: function () {
          var img = requireImage();
          if (!img) return;
          var fig = editor.dom.getParent(img, 'figure.article-img-credit-wrap');
          var cap = fig ? editor.dom.select('figcaption', fig)[0] : null;
          var currentText = cap ? cap.textContent.trim() : '';
          var currentPos = cap ? (cap.className.match(/--(\w{2})\b/) || [,'br'])[1] : 'br';

          editor.windowManager.open({
            title: 'Credit fotky',
            body: {
              type: 'panel',
              items: [
                { type: 'input', name: 'credit', label: 'Autor / zdroj', placeholder: 'např. Reuters / AP' },
                {
                  type: 'selectbox',
                  name: 'pos',
                  label: 'Pozice',
                  items: [
                    { value: 'br', text: 'Vpravo dole' },
                    { value: 'bl', text: 'Vlevo dole' },
                    { value: 'tr', text: 'Vpravo nahoře' },
                    { value: 'tl', text: 'Vlevo nahoře' },
                  ],
                },
              ],
            },
            initialData: { credit: currentText, pos: currentPos },
            buttons: [
              { type: 'cancel', text: 'Zrušit' },
              ...(fig ? [{ type: 'custom', name: 'remove', text: 'Odebrat credit' }] : []),
              { type: 'submit', text: 'Uložit', primary: true },
            ],
            onAction: function (api, details) {
              if (details.name === 'remove') {
                applyCredit(editor.dom.select('img', fig)[0], '', '');
                api.close();
              }
            },
            onSubmit: function (api) {
              var data = api.getData();
              applyCredit(fig ? editor.dom.select('img', fig)[0] : img, data.credit.trim(), data.pos);
              api.close();
            },
          });
        },
      });

      editor.ui.registry.addButton('embedbtn', {
        text: 'Embed',
        onAction: function () {
          var url = window.prompt('URL příspěvku (X, YouTube, Vimeo):');
          if (!url) return;
          fetch('/api/oembed', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ url: url }),
            credentials: 'same-origin',
          })
            .then(function (r) { return r.json(); })
            .then(function (j) {
              if (j.html) editor.insertContent(j.html);
              else alert(j.error || 'Chyba');
            })
            .catch(function () { alert('Chyba sítě'); });
        },
      });
    },
  });
  form.addEventListener('submit', function () {
    if (typeof window.syncHeroPositionBeforeSubmit === 'function') {
      window.syncHeroPositionBeforeSubmit();
    }
    if (typeof window.syncHeroCardPositionBeforeSubmit === 'function') {
      window.syncHeroCardPositionBeforeSubmit();
    }
    if (typeof window.syncLineupBeforeSubmit === 'function') {
      window.syncLineupBeforeSubmit();
    }
    if (window.tinymce && tinymce.get('body_html')) tinymce.get('body_html').save();
  });
  var actionInput = document.getElementById('article-form-action');
  form.querySelectorAll('button[type="submit"][data-article-action]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (actionInput) actionInput.value = btn.getAttribute('data-article-action') || 'save';
      if (typeof window.syncHeroPositionBeforeSubmit === 'function') {
        window.syncHeroPositionBeforeSubmit();
      }
      if (typeof window.syncHeroCardPositionBeforeSubmit === 'function') {
        window.syncHeroCardPositionBeforeSubmit();
      }
      if (typeof window.syncLineupBeforeSubmit === 'function') {
        window.syncLineupBeforeSubmit();
      }
    });
  });
})();
</script>

<%- include('../partials/admin-layout-end') %>
