<script>
  (function () {
    var keeperForm = document.getElementById('penalty-keeper-form');
    if (!keeperForm) return;

    var nameInput = keeperForm.querySelector('input[name="name"]');
    var teamInput = keeperForm.querySelector('input[name="team_name"]');
    var thumbFileInput = keeperForm.querySelector('input[name="thumb_file"]');
    var previewNames = keeperForm.querySelectorAll('.js-penalty-preview-name');
    var previewTeams = keeperForm.querySelectorAll('.js-penalty-preview-team');
    var previewDesktopThumb = keeperForm.querySelector('.js-penalty-preview-desktop-thumb');
    var previewDesktopThumbWrap = keeperForm.querySelector('.js-penalty-preview-desktop-thumb-wrap');
    var previewMobileThumb = keeperForm.querySelector('.js-penalty-preview-mobile-thumb');
    var previewMobileThumbWrap = keeperForm.querySelector('.js-penalty-preview-mobile-thumb-wrap');
    var previewStars = keeperForm.querySelectorAll('[data-preview-star]');
    var thumbScaleInput = document.getElementById('penalty_thumb_scale');
    var thumbPositionInput = document.getElementById('penalty_thumb_position');
    var thumbMobileScaleInput = document.getElementById('penalty_thumb_mobile_scale');
    var thumbMobilePositionInput = document.getElementById('penalty_thumb_mobile_position');
    var faceTopInput = document.getElementById('penalty_face_top_pct');
    var faceLeftInput = document.getElementById('penalty_face_left_pct');
    var faceSizeInput = document.getElementById('penalty_face_size_pct');
    var previewFaceWrap = keeperForm.querySelector('.js-penalty-face-preview-wrap');
    var previewFaceImg = keeperForm.querySelector('.js-penalty-face-preview-face');
    var faceSizeLabel = keeperForm.querySelector('[data-face-size-label]');
    var zoomOutBtn = keeperForm.querySelector('[data-thumb-zoom-out]');
    var zoomInBtn = keeperForm.querySelector('[data-thumb-zoom-in]');
    var zoomLabel = keeperForm.querySelector('[data-thumb-zoom-label]');
    var posUpBtn = keeperForm.querySelector('[data-thumb-pos-up]');
    var posDownBtn = keeperForm.querySelector('[data-thumb-pos-down]');
    var mobileZoomOutBtn = keeperForm.querySelector('[data-thumb-mobile-zoom-out]');
    var mobileZoomInBtn = keeperForm.querySelector('[data-thumb-mobile-zoom-in]');
    var mobileZoomLabel = keeperForm.querySelector('[data-thumb-mobile-zoom-label]');
    var mobilePosUpBtn = keeperForm.querySelector('[data-thumb-mobile-pos-up]');
    var mobilePosDownBtn = keeperForm.querySelector('[data-thumb-mobile-pos-down]');
    var defaultThumbSrc = <%- JSON.stringify(previewThumbSrc) %>;
    var hasCustomFaceThumb = <%- JSON.stringify(!!hasCustomFaceThumb) %>;
    var previewBlobUrl = null;
    var MIN_THUMB_SCALE = 0.5;
    var MAX_THUMB_SCALE = 5;
    var THUMB_SCALE_STEP = 0.1;
    var THUMB_POS_STEP = 5;
    var FACE_POS_STEP = 0.5;
    var FACE_SIZE_STEP = 0.5;
    var MIN_FACE_SIZE = 3;
    var MAX_FACE_SIZE = 500;

    function clamp(v, min, max) {
      return Math.max(min, Math.min(max, v));
    }

    function parseScale(raw) {
      var n = Number(String(raw || '').trim().replace(',', '.'));
      if (!Number.isFinite(n)) return 1;
      return Math.round(clamp(n, MIN_THUMB_SCALE, MAX_THUMB_SCALE) * 100) / 100;
    }

    function parseThumbOffset(raw, frameHeight) {
      if (typeof raw === 'number' && Number.isFinite(raw)) return raw;
      var s = String(raw || '').trim();
      var m = s.match(/calc\(50%\s*\+\s*(-?\d+(?:\.\d+)?)px\)/i);
      if (m) return Number(m[1]);
      m = s.match(/^50%\s+(-?\d+(?:\.\d+)?)%$/);
      if (m) {
        var h = frameHeight || 52;
        return ((Number(m[1]) - 50) / 100) * h;
      }
      return 0;
    }

    function formatThumbPosition(offsetPx) {
      var n = Math.round(offsetPx * 10) / 10;
      return '50% calc(50% + ' + n + 'px)';
    }

    function parseFacePct(raw, fallback) {
      var n = Number(String(raw || '').trim().replace(',', '.'));
      if (!Number.isFinite(n)) return fallback;
      return Math.round(clamp(n, 0, 100) * 10) / 10;
    }

    function applyFacePreview() {
      if (!previewFaceWrap) return;
      faceTopPct = parseFacePct(faceTopPct, 14);
      faceLeftPct = parseFacePct(faceLeftPct, 50);
      faceSizePct = Math.round(clamp(faceSizePct, MIN_FACE_SIZE, MAX_FACE_SIZE) * 10) / 10;
      previewFaceWrap.style.setProperty('--penalty-face-top-fraction', String(faceTopPct / 100));
      previewFaceWrap.style.setProperty('--penalty-face-left', faceLeftPct + '%');
      previewFaceWrap.style.setProperty('--penalty-face-size-fraction', String(faceSizePct / 100));
      if (faceTopInput) faceTopInput.value = String(faceTopPct);
      if (faceLeftInput) faceLeftInput.value = String(faceLeftPct);
      if (faceSizeInput) faceSizeInput.value = String(faceSizePct);
      if (faceSizeLabel) faceSizeLabel.textContent = faceSizePct + '%';
    }

    var faceTopPct = parseFacePct(faceTopInput && faceTopInput.value, 14);
    var faceLeftPct = parseFacePct(faceLeftInput && faceLeftInput.value, 50);
    var faceSizePct = parseFacePct(faceSizeInput && faceSizeInput.value, 100);

    function changeFacePos(dx, dy) {
      faceLeftPct = parseFacePct(faceLeftPct + dx, 50);
      faceTopPct = parseFacePct(faceTopPct + dy, 14);
      applyFacePreview();
    }

    function changeFaceSize(delta) {
      faceSizePct = Math.round(clamp(faceSizePct + delta, MIN_FACE_SIZE, MAX_FACE_SIZE) * 10) / 10;
      applyFacePreview();
    }

    function applyDesktopThumbPreview() {
      if (!previewDesktopThumb) return;
      thumbScale = parseScale(thumbScale);
      if (!Number.isFinite(thumbOffsetY)) thumbOffsetY = 0;
      var thumbPosition = formatThumbPosition(thumbOffsetY);
      if (previewDesktopThumbWrap) {
        previewDesktopThumbWrap.style.setProperty('--penalty-thumb-scale', String(thumbScale));
      }
      previewDesktopThumb.style.objectPosition = thumbPosition;
      if (thumbScaleInput) thumbScaleInput.value = String(thumbScale);
      if (thumbPositionInput) thumbPositionInput.value = thumbPosition;
      if (zoomLabel) zoomLabel.textContent = Math.round(thumbScale * 100) + '%';
      if (zoomOutBtn) zoomOutBtn.disabled = thumbScale <= MIN_THUMB_SCALE + 0.001;
      if (zoomInBtn) zoomInBtn.disabled = thumbScale >= MAX_THUMB_SCALE - 0.001;
    }

    function applyMobileThumbPreview() {
      if (!previewMobileThumb) return;
      thumbMobileScale = parseScale(thumbMobileScale);
      if (!Number.isFinite(thumbMobileOffsetY)) thumbMobileOffsetY = 0;
      var thumbMobilePosition = formatThumbPosition(thumbMobileOffsetY);
      if (previewMobileThumbWrap) {
        previewMobileThumbWrap.style.setProperty('--penalty-thumb-scale', String(thumbMobileScale));
      }
      previewMobileThumb.style.objectPosition = thumbMobilePosition;
      if (thumbMobileScaleInput) thumbMobileScaleInput.value = String(thumbMobileScale);
      if (thumbMobilePositionInput) thumbMobilePositionInput.value = thumbMobilePosition;
      if (mobileZoomLabel) mobileZoomLabel.textContent = Math.round(thumbMobileScale * 100) + '%';
      if (mobileZoomOutBtn) mobileZoomOutBtn.disabled = thumbMobileScale <= MIN_THUMB_SCALE + 0.001;
      if (mobileZoomInBtn) mobileZoomInBtn.disabled = thumbMobileScale >= MAX_THUMB_SCALE - 0.001;
    }

    var thumbScale = parseScale(thumbScaleInput && thumbScaleInput.value);
    var thumbOffsetY = parseThumbOffset(
      thumbPositionInput && thumbPositionInput.value,
      previewDesktopThumbWrap && previewDesktopThumbWrap.offsetHeight
    );
    var thumbMobileScale = parseScale(thumbMobileScaleInput && thumbMobileScaleInput.value);
    var thumbMobileOffsetY = parseThumbOffset(
      thumbMobilePositionInput && thumbMobilePositionInput.value,
      previewMobileThumbWrap && previewMobileThumbWrap.offsetHeight
    );

    function changeThumbPos(delta) {
      thumbOffsetY += delta;
      applyDesktopThumbPreview();
    }

    function changeThumbMobilePos(delta) {
      thumbMobileOffsetY += delta;
      applyMobileThumbPreview();
    }

    function syncPreviewText() {
      var nameText = nameInput ? String(nameInput.value || '').trim() || 'Jméno brankáře' : 'Jméno brankáře';
      var teamText = teamInput ? String(teamInput.value || '').trim() || 'Název týmu' : 'Název týmu';
      previewNames.forEach(function (el) { el.textContent = nameText; });
      previewTeams.forEach(function (el) { el.textContent = teamText; });
    }

    function paintPreviewStars(value) {
      var n = parseInt(value, 10) || 1;
      previewStars.forEach(function (star) {
        var v = parseInt(star.getAttribute('data-preview-star'), 10);
        star.classList.toggle('penalty-game__pick-star--on', v <= n);
      });
    }

    function changeThumbScale(delta) {
      thumbScale = parseScale(thumbScale + delta);
      applyDesktopThumbPreview();
    }

    function changeThumbMobileScale(delta) {
      thumbMobileScale = parseScale(thumbMobileScale + delta);
      applyMobileThumbPreview();
    }

    if (nameInput) nameInput.addEventListener('input', syncPreviewText);
    if (teamInput) teamInput.addEventListener('input', syncPreviewText);

    function setFacePreviewVisible(visible) {
      if (!previewFaceWrap) return;
      previewFaceWrap.hidden = !visible;
    }

    function setPreviewImage(src, showFace) {
      if (previewDesktopThumb) previewDesktopThumb.src = src;
      if (previewMobileThumb) previewMobileThumb.src = src;
      if (previewFaceImg) previewFaceImg.src = showFace ? src : '';
      setFacePreviewVisible(!!showFace);
    }

    if (thumbFileInput && (previewDesktopThumb || previewMobileThumb)) {
      thumbFileInput.addEventListener('change', function () {
        var file = thumbFileInput.files && thumbFileInput.files[0];
        if (previewBlobUrl) {
          URL.revokeObjectURL(previewBlobUrl);
          previewBlobUrl = null;
        }
        if (!file) {
          setPreviewImage(defaultThumbSrc, hasCustomFaceThumb);
          return;
        }
        previewBlobUrl = URL.createObjectURL(file);
        setPreviewImage(previewBlobUrl, true);
        thumbScale = 1;
        thumbOffsetY = 0;
        thumbMobileScale = 1;
        thumbMobileOffsetY = 0;
        var loadTarget = previewDesktopThumb || previewMobileThumb;
        loadTarget.onload = function () {
          loadTarget.onload = null;
          applyDesktopThumbPreview();
          applyMobileThumbPreview();
        };
        applyDesktopThumbPreview();
        applyMobileThumbPreview();
      });
    }

    function bindPreviewButton(btn, handler) {
      if (!btn) return;
      btn.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        handler();
      });
    }

    bindPreviewButton(zoomOutBtn, function () {
      changeThumbScale(-THUMB_SCALE_STEP);
    });

    bindPreviewButton(zoomInBtn, function () {
      changeThumbScale(THUMB_SCALE_STEP);
    });

    bindPreviewButton(posUpBtn, function () {
      changeThumbPos(-THUMB_POS_STEP);
    });

    bindPreviewButton(posDownBtn, function () {
      changeThumbPos(THUMB_POS_STEP);
    });

    bindPreviewButton(mobileZoomOutBtn, function () {
      changeThumbMobileScale(-THUMB_SCALE_STEP);
    });

    bindPreviewButton(mobileZoomInBtn, function () {
      changeThumbMobileScale(THUMB_SCALE_STEP);
    });

    bindPreviewButton(mobilePosUpBtn, function () {
      changeThumbMobilePos(-THUMB_POS_STEP);
    });

    bindPreviewButton(mobilePosDownBtn, function () {
      changeThumbMobilePos(THUMB_POS_STEP);
    });

    keeperForm.querySelectorAll('[data-face-pos-left]').forEach(function (btn) {
      bindPreviewButton(btn, function () { changeFacePos(-FACE_POS_STEP, 0); });
    });
    keeperForm.querySelectorAll('[data-face-pos-right]').forEach(function (btn) {
      bindPreviewButton(btn, function () { changeFacePos(FACE_POS_STEP, 0); });
    });
    keeperForm.querySelectorAll('[data-face-pos-up]').forEach(function (btn) {
      bindPreviewButton(btn, function () { changeFacePos(0, -FACE_POS_STEP); });
    });
    keeperForm.querySelectorAll('[data-face-pos-down]').forEach(function (btn) {
      bindPreviewButton(btn, function () { changeFacePos(0, FACE_POS_STEP); });
    });
    keeperForm.querySelectorAll('[data-face-size-out]').forEach(function (btn) {
      bindPreviewButton(btn, function () { changeFaceSize(-FACE_SIZE_STEP); });
    });
    keeperForm.querySelectorAll('[data-face-size-in]').forEach(function (btn) {
      bindPreviewButton(btn, function () { changeFaceSize(FACE_SIZE_STEP); });
    });

    document.querySelectorAll('#penalty-keeper-form [data-keeper-experience]').forEach(function (wrap) {
      var input = wrap.querySelector('input[name="experience_stars"]');
      var stars = wrap.querySelectorAll('[data-star]');
      if (!input || !stars.length) return;

      function paint(value) {
        var n = parseInt(value, 10) || 1;
        stars.forEach(function (btn) {
          var v = parseInt(btn.getAttribute('data-star'), 10);
          btn.classList.toggle('is-on', v <= n);
        });
        paintPreviewStars(n);
      }

      stars.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var n = parseInt(btn.getAttribute('data-star'), 10);
          input.value = String(n);
          paint(n);
        });
      });

      paint(input.value);
    });

    applyDesktopThumbPreview();
    applyMobileThumbPreview();
    applyFacePreview();
    syncPreviewText();
    paintPreviewStars((keeperForm.querySelector('input[name="experience_stars"]') || {}).value || 1);

    keeperForm.addEventListener('submit', function () {
      applyDesktopThumbPreview();
      applyMobileThumbPreview();
      applyFacePreview();
    });
  })();
</script>

