          <td class="px-2 py-3 font-medium text-white"><%= player.display_name %></td>
          <td class="px-2 py-3"><a href="mailto:<%= player.email %>" class="text-11accent hover:underline"><%= player.email %></a></td>
          <td class="px-2 py-3 whitespace-nowrap text-11muted"><%= fmtAdminDateTime(player.created_at) %></td>
