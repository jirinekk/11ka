    <% playersPagination.pages.forEach(function (p) { %>
      <% if (p.current) { %>
      <span class="min-w-[40px] rounded-lg bg-11accent px-3 py-2 text-center text-sm text-11bg" aria-current="page"><%= p.n %></span>
      <% } else { %>
      <a href="<%= p.url %>#penalty-admin-players" class="min-w-[40px] rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-center text-sm text-slate-200 hover:border-white/20 hover:bg-white/10"><%= p.n %></a>
      <% } %>
    <% }); %>
    <% if (playersPagination.nextUrl) { %>
    <a href="<%= playersPagination.nextUrl %>#penalty-admin-players" rel="next" class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-slate-200 hover:border-white/20 hover:bg-white/10">Další</a>
    <% } else { %>
    <span class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-slate-200 opacity-50" aria-disabled="true">Další</span>
    <% } %>
  </nav>
  <% } %>
  <% } %>
</section>

