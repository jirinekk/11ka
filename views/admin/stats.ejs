<%- include('../partials/admin-layout-start') %>

<%
  var q = typeof searchQuery === 'string' ? searchQuery : '';
  function statsPageLink(pageNum) {
    var ps = ['page=' + encodeURIComponent(String(pageNum))];
    if (q) ps.push('q=' + encodeURIComponent(q));
    return '/administrace/statistiky?' + ps.join('&');
  }
%>

<div class="border-b border-white/10 pb-6">
  <h1 class="text-2xl font-bold text-white md:text-3xl">Statistiky čtenosti</h1>
</div>

<div class="mt-8 grid gap-6 lg:grid-cols-3">
  <div class="card-11 p-6 lg:col-span-1">
    <p class="text-xs font-medium uppercase tracking-wider text-11muted">Zobrazení celkem</p>
    <p class="mt-2 text-3xl font-bold text-11accent"><%= summary.totalViews %></p>
    <p class="mt-1 text-sm text-11muted">u publikovaných článků</p>
  </div>
  <section class="card-11 p-6 lg:col-span-2">
    <h2 class="font-semibold text-white">Po stavech</h2>
    <ul class="mt-3 space-y-1 text-sm text-11muted">
      <% summary.byStatus.forEach(function (row) { %>
      <li><span class="text-white"><%= row.status %></span>: <%= row.c %></li>
      <% }); %>
    </ul>
  </section>
</div>

<section class="card-11 mt-6 overflow-x-auto p-4 sm:p-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 class="font-semibold text-white">Nejčtenější</h2>
    <form method="get" action="/administrace/statistiky" class="flex w-full flex-wrap items-end gap-2 sm:w-auto sm:max-w-md sm:flex-1 sm:justify-end">
      <div class="min-w-0 flex-1 sm:min-w-[14rem]">
        <label for="stats-q" class="text-xs text-11muted">Vyhledávání</label>
        <input
          id="stats-q"
          name="q"
          type="search"
          value="<%= q %>"
          placeholder="Nadpis, kategorie, autor…"
          class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white"
        />
      </div>
      <button type="submit" class="btn-11 btn-11--primary">Hledat</button>
      <% if (q) { %>
      <a href="/administrace/statistiky" class="btn-11 btn-11--ghost">Reset</a>
      <% } %>
    </form>
  </div>

  <% if (!summary.top.length) { %>
  <p class="mt-4 text-sm text-11muted"><%= q ? 'Žádné články neodpovídají zadanému hledání.' : 'Zatím nejsou dostupná data.' %></p>
  <% } else { %>
  <div class="mt-4 space-y-2 sm:hidden">
    <% summary.top.forEach(function (row) { %>
    <article class="rounded-xl border border-white/10 bg-black/20 p-3">
      <a href="/administrace/clanek/<%= row.id %>/edit" class="block text-sm font-semibold leading-snug text-11accent hover:underline"><%= row.title %></a>
      <div class="mt-2 flex items-center justify-between gap-3 text-xs">
        <span class="text-slate-300">Zobrazení: <span class="font-semibold text-white"><%= row.view_count %></span></span>
        <span class="text-11muted"><%= row.published_at || '-' %></span>
      </div>
    </article>
    <% }); %>
  </div>

  <table class="mt-4 hidden w-full min-w-[280px] sm:min-w-[480px] text-left text-sm sm:table">
    <thead>
      <tr class="border-b border-white/10 text-11muted">
        <th class="pb-2">Článek</th>
        <th class="pb-2">Zobrazení</th>
        <th class="pb-2">Publikováno</th>
      </tr>
    </thead>
    <tbody>
      <% summary.top.forEach(function (row) { %>
      <tr class="border-b border-white/5">
        <td class="py-2 pr-2 break-words"><a href="/administrace/clanek/<%= row.id %>/edit" class="text-11accent hover:underline"><%= row.title %></a></td>
        <td class="py-2 text-white"><%= row.view_count %></td>
        <td class="py-2 text-xs text-11muted break-all"><%= row.published_at || '-' %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } %>

  <%
    var p = pagination || { page: 1, perPage: summary.top.length, totalPages: 1, totalItems: summary.top.length, hasPrev: false, hasNext: false };
    var from = p.totalItems === 0 ? 0 : ((p.page - 1) * p.perPage + 1);
    var to = p.totalItems === 0 ? 0 : Math.min(p.page * p.perPage, p.totalItems);
  %>
  <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-11muted">Zobrazeno <%= from %>-<%= to %> z <%= p.totalItems %> článků<%= q ? ' (filtr)' : '' %></p>
    <% if (p.totalPages > 1) { %>
    <nav class="flex items-center gap-2" aria-label="Stránkování statistik">
      <% if (p.hasPrev) { %>
      <a href="<%= statsPageLink(p.page - 1) %>" class="rounded-lg border border-white/15 px-3 py-1.5 text-sm text-slate-200 transition hover:border-11accent/40 hover:text-white">Předchozí</a>
      <% } else { %>
      <span class="rounded-lg border border-white/10 px-3 py-1.5 text-sm text-slate-500">Předchozí</span>
      <% } %>
      <span class="rounded-lg border border-11accent/40 bg-11accent/10 px-3 py-1.5 text-sm font-semibold text-11accent"><%= p.page %> / <%= p.totalPages %></span>
      <% if (p.hasNext) { %>
      <a href="<%= statsPageLink(p.page + 1) %>" class="rounded-lg border border-white/15 px-3 py-1.5 text-sm text-slate-200 transition hover:border-11accent/40 hover:text-white">Další</a>
      <% } else { %>
      <span class="rounded-lg border border-white/10 px-3 py-1.5 text-sm text-slate-500">Další</span>
      <% } %>
    </nav>
    <% } %>
  </div>
</section>

<%- include('../partials/admin-layout-end') %>
