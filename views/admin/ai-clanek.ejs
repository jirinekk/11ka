<%- include('../partials/admin-layout-start') %>
<%
  var item = typeof queueItem !== 'undefined' ? queueItem : {};
  var authorsList = typeof authors !== 'undefined' && authors ? authors : [];
  var cats = typeof categories !== 'undefined' && categories ? categories : [];
  var tags = typeof tagOptions !== 'undefined' && tagOptions ? tagOptions : [];
%>

<div class="border-b border-white/10 pb-6">
  <a href="/administrace/ai-clanky" class="text-sm text-11muted hover:text-white">← Zpět do fronty</a>
  <h1 class="mt-3 text-2xl font-bold text-white md:text-3xl">Kontrola AI článku</h1>
  <p class="mt-1 text-sm text-11muted">Vlevo zdroj, vpravo přepis 11ky. Ulož koncept nebo rovnou vydej na web.</p>
  <%- include('../partials/admin-ai-nav', { aiTab: 'fronta' }) %>
</div>

<% if (typeof error !== 'undefined' && error) { %>
<p class="mt-6 rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200"><%= error %></p>
<% } %>
<% if (typeof success !== 'undefined' && success) { %>
<p class="mt-6 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200"><%= success %></p>
<% } %>

<div class="mt-8 grid gap-6 xl:grid-cols-2">
  <section class="card-11 p-5">
    <p class="inline-flex rounded-full bg-11accent/15 px-3 py-1 text-xs font-semibold text-11accent"><%= item.source_name || 'Zdroj' %></p>
    <h2 class="mt-4 text-xl font-bold leading-tight text-white"><%= item.source_title %></h2>
    <p class="mt-3 text-sm leading-relaxed text-slate-300"><%= item.source_perex %></p>
    <% if (item.source_image) { %>
    <img src="<%= item.source_image %>" alt="" class="mt-5 aspect-[21/9] w-full rounded-xl object-cover ring-1 ring-white/10" />
    <% } %>
    <div class="mt-6 whitespace-pre-wrap text-sm leading-relaxed text-slate-300"><%= item.source_body || 'Z RSS přišel jen perex.' %></div>
    <a href="<%= item.source_url %>" target="_blank" rel="noreferrer" class="mt-6 inline-block text-sm text-11accent hover:underline">Otevřít zdroj</a>
  </section>

  <section class="card-11 p-5">
    <form method="post" action="/administrace/ai-clanky/<%= item.id %>" class="space-y-4">
      <div>
        <label class="text-xs text-11muted" for="title">Titulek</label>
        <input id="title" name="title" required value="<%= item.title || '' %>" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
      </div>
      <div>
        <label class="text-xs text-11muted" for="excerpt">Perex</label>
        <textarea id="excerpt" name="excerpt" rows="4" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white"><%= item.excerpt || '' %></textarea>
      </div>
      <div>
        <label class="text-xs text-11muted" for="body">Text (HTML nebo odstavce)</label>
        <textarea id="body" name="body" rows="14" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white"><%= item.body_html || '' %></textarea>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="text-xs text-11muted" for="category">Rubrika</label>
          <select id="category" name="category" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white">
            <% cats.forEach(function (c) { %>
            <option value="<%= c %>" <%= item.category === c ? 'selected' : '' %>><%= c %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label class="text-xs text-11muted" for="tag">Štítek</label>
          <select id="tag" name="tag" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white">
            <option value="">—</option>
            <% tags.forEach(function (t) { %>
            <option value="<%= t %>" <%= item.tag === t ? 'selected' : '' %>><%= t %></option>
            <% }); %>
          </select>
        </div>
        <div class="sm:col-span-2">
          <label class="text-xs text-11muted" for="author_id">Autor na 11ce</label>
          <select id="author_id" name="author_id" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white">
            <% authorsList.forEach(function (u) { %>
            <option value="<%= u.id %>" <%= String(item.author_id || '') === String(u.id) ? 'selected' : '' %>>
              <%= u.display_name || u.email %>
            </option>
            <% }); %>
          </select>
        </div>
      </div>
      <% if (item.rewrite_error) { %>
      <p class="text-sm text-red-300"><%= item.rewrite_error %></p>
      <% } %>
      <div class="flex flex-wrap gap-2">
        <button class="rounded-xl bg-11accent px-4 py-2.5 text-sm font-semibold text-11bg hover:brightness-110" type="submit" name="action" value="open_editor">Přepsat</button>
        <button class="rounded-xl border border-white/15 px-4 py-2.5 text-sm font-semibold text-white hover:bg-white/5" type="submit" name="action" value="save">Uložit</button>
        <button class="rounded-xl border border-white/15 px-4 py-2.5 text-sm font-semibold text-white hover:bg-white/5" type="submit" name="action" value="rewrite">Přepsat znovu</button>
        <button class="rounded-xl border border-white/15 px-4 py-2.5 text-sm font-semibold text-white hover:bg-white/5" type="submit" name="action" value="draft">Uložit jako koncept</button>
        <button class="rounded-xl bg-emerald-500 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-400" type="submit" name="action" value="publish">Vydat na 11ka.cz</button>
        <button class="rounded-xl border border-red-400/30 px-4 py-2.5 text-sm font-semibold text-red-200 hover:bg-red-500/10" type="submit" name="action" value="reject">Zamítnout</button>
      </div>
    </form>
    <% if (item.published_url) { %>
    <a href="<%= item.published_url %>" class="mt-4 inline-block text-sm text-11accent hover:underline" target="_blank" rel="noreferrer"><%= item.published_url %></a>
    <% } %>
  </section>
</div>

<%- include('../partials/admin-layout-end') %>
