        </div>
        <%- include('../partials/accreditation-status', { accStatus: r.status }) %>
      </div>
      <p class="mt-3 text-sm text-slate-300"><%= r.accreditation_type === 'photo' ? 'Photo' : 'Píšící' %> · podáno <%= fmtCreated(r.created_at) %></p>
      <a href="<%= detailHref(r.id, 1) %>" class="mt-3 inline-flex text-sm font-medium text-11accent hover:underline">Zobrazit akreditaci</a>
    </article>
    <% }); %>
  </div>
  <div class="mt-5 akreditace-admin-desktop-only akreditace-requests-table-wrap">
    <table class="akreditace-requests-table text-left text-sm">
      <thead>
        <tr class="border-b border-white/10 text-xs uppercase tracking-wide text-11muted">
          <th class="px-4 py-2.5 font-medium whitespace-nowrap">Zápas</th>
