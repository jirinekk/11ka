    <dl class="mt-4 grid grid-cols-2 gap-2 text-sm sm:grid-cols-5">
      <div><dt class="text-xs text-11muted">Celkem</dt><dd class="font-semibold tabular-nums text-white"><%= a.total %></dd></div>
      <div><dt class="text-xs text-11muted">Schváleno</dt><dd class="font-semibold tabular-nums text-emerald-300"><%= a.approved %></dd></div>
      <div><dt class="text-xs text-11muted">Zamítnuto</dt><dd class="font-semibold tabular-nums text-red-300"><%= a.rejected %></dd></div>
      <div><dt class="text-xs text-11muted">Zažádáno</dt><dd class="font-semibold tabular-nums text-sky-300"><%= a.requested %></dd></div>
      <div><dt class="text-xs text-11muted">Čeká</dt><dd class="font-semibold tabular-nums text-amber-300"><%= a.pending %></dd></div>
    </dl>
    <a href="<%= spisHref({ email: a.email, page: 1 }) %>" class="mt-4 inline-flex w-full items-center justify-center rounded-lg border border-sky-400/40 bg-sky-500/10 px-3 py-2.5 text-sm font-medium text-sky-200 transition hover:bg-sky-500/20">
      Otevřít spis
    </a>
  </article>
  <% }); %>
</div>

<div class="mt-8 akreditace-admin-desktop-only akreditace-requests-table-wrap">
  <table class="akreditace-requests-table text-left text-sm">
    <thead>
      <tr class="border-b border-white/10 text-xs uppercase tracking-wide text-11muted">
        <th class="px-4 py-2.5 font-medium whitespace-nowrap">Jméno</th>
        <th class="px-4 py-2.5 font-medium whitespace-nowrap">E-mail</th>
        <th class="px-4 py-2.5 font-medium whitespace-nowrap">Telefon</th>
        <th class="px-4 py-2.5 font-medium whitespace-nowrap">Celkem</th>
        <th class="px-4 py-2.5 font-medium whitespace-nowrap">Schváleno</th>
        <th class="px-4 py-2.5 font-medium whitespace-nowrap">Zamítnuto</th>
        <th class="px-4 py-2.5 font-medium whitespace-nowrap">Zažádáno</th>
        <th class="px-4 py-2.5 font-medium whitespace-nowrap">Čeká</th>
        <th class="px-4 py-2.5 font-medium whitespace-nowrap">Poslední</th>
        <th class="px-4 py-2.5 font-medium whitespace-nowrap">Spis</th>
      </tr>
    </thead>
    <tbody>
      <% applicantsList.forEach(function (a) { %>
      <tr class="border-b border-white/5 text-slate-200 <%= selectedEmail && a.email_key === String(selectedEmail).trim().toLowerCase() ? 'bg-sky-500/10' : '' %>">
        <td class="px-4 py-3 align-middle whitespace-nowrap font-medium text-white"><%= a.name %></td>
        <td class="px-4 py-3 align-middle whitespace-nowrap">
          <a href="mailto:<%= a.email %>" class="text-11accent hover:underline"><%= a.email %></a>
        </td>
        <td class="px-4 py-3 align-middle whitespace-nowrap tabular-nums"><%= a.phone %></td>
        <td class="px-4 py-3 align-middle whitespace-nowrap tabular-nums font-semibold text-white"><%= a.total %></td>
        <td class="px-4 py-3 align-middle whitespace-nowrap tabular-nums text-emerald-300"><%= a.approved %></td>
        <td class="px-4 py-3 align-middle whitespace-nowrap tabular-nums text-red-300"><%= a.rejected %></td>
        <td class="px-4 py-3 align-middle whitespace-nowrap tabular-nums text-sky-300"><%= a.requested %></td>
        <td class="px-4 py-3 align-middle whitespace-nowrap tabular-nums text-amber-300"><%= a.pending %></td>
        <td class="px-4 py-3 align-middle whitespace-nowrap tabular-nums"><%= fmtCreated(a.last_created_at) %></td>
        <td class="px-4 py-3 align-middle whitespace-nowrap">
          <a href="<%= spisHref({ email: a.email, page: 1 }) %>" class="inline-flex rounded-lg border border-sky-400/40 px-2.5 py-1 text-xs font-medium text-sky-200 transition hover:bg-sky-500/10">Otevřít</a>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%
  var p = pagination || { page: 1, perPage: applicantsList.length, totalPages: 1, totalItems: applicantsList.length, hasPrev: false, hasNext: false };
  var from = p.totalItems === 0 ? 0 : ((p.page - 1) * p.perPage + 1);
  var to = p.totalItems === 0 ? 0 : Math.min(p.page * p.perPage, p.totalItems);
%>
<div class="mt-6 flex flex-wrap items-center justify-between gap-3">
  <p class="text-sm text-11muted">Zobrazeno <%= from %>-<%= to %> z <%= p.totalItems %> žadatelů</p>
  <% if (p.totalPages > 1) { %>
  <nav class="flex items-center gap-2" aria-label="Stránkování spisu">
    <% if (p.hasPrev) { %>
    <a href="<%= spisHref({ page: p.page - 1, email: selectedEmail || null }) %>" class="rounded-lg border border-white/15 px-3 py-1.5 text-sm text-slate-200 transition hover:border-11accent/40 hover:text-white">Předchozí</a>
    <% } else { %>
    <span class="rounded-lg border border-white/10 px-3 py-1.5 text-sm text-slate-500">Předchozí</span>
    <% } %>
    <span class="rounded-lg border border-sky-400/40 bg-sky-500/10 px-3 py-1.5 text-sm font-semibold text-sky-200"><%= p.page %> / <%= p.totalPages %></span>
    <% if (p.hasNext) { %>
    <a href="<%= spisHref({ page: p.page + 1, email: selectedEmail || null }) %>" class="rounded-lg border border-white/15 px-3 py-1.5 text-sm text-slate-200 transition hover:border-11accent/40 hover:text-white">Další</a>
    <% } else { %>
    <span class="rounded-lg border border-white/10 px-3 py-1.5 text-sm text-slate-500">Další</span>
    <% } %>
  </nav>
  <% } %>
</div>
<% } %>

<% } else { %>

<form method="get" action="/administrace/akreditace" class="mt-6 flex flex-wrap items-end gap-3">
  <% if (activeTab === 'skryte') { %><input type="hidden" name="tab" value="skryte" /><% } %>
  <div>
    <label class="text-xs text-11muted" for="acc-date-from">Datum zápasu od</label>
    <input
      id="acc-date-from"
      name="od"
      type="date"
      value="<%= filterFrom %>"
      class="input-11 mt-1 rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white"
