  <div>
    <label class="text-xs text-11muted" for="acc-date-to">Datum zápasu do</label>
    <input
      id="acc-date-to"
      name="do"
      type="date"
      value="<%= filterTo %>"
      class="input-11 mt-1 rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white"
