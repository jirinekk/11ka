<%- include('../partials/admin-layout-start') %>
<%
  var activeTab = typeof tab !== 'undefined' && (tab === 'skryte' || tab === 'spis') ? tab : 'viditelne';
  var counts = typeof tabCounts !== 'undefined' && tabCounts ? tabCounts : { viditelne: 0, skryte: 0, spis: 0 };
  var applicantsList = typeof applicants !== 'undefined' && applicants ? applicants : [];
  var personList = typeof personRequests !== 'undefined' && personRequests ? personRequests : [];
  var personInfo = typeof personStats !== 'undefined' ? personStats : null;
  var selectedEmail = typeof personEmail !== 'undefined' && personEmail ? personEmail : '';
  var searchQ = typeof spisSearch !== 'undefined' ? spisSearch : '';
  var filterFrom = typeof dateFrom !== 'undefined' ? dateFrom : '';
  var filterTo = typeof dateTo !== 'undefined' ? dateTo : '';
  var hasDateFilter = !!(filterFrom || filterTo);

  function tabHref(t, pageNum, extra) {
    var parts = [];
    if (t === 'skryte') parts.push('tab=skryte');
    if (t === 'spis') parts.push('tab=spis');
    if (t === 'spis' && searchQ) parts.push('q=' + encodeURIComponent(searchQ));
    if (t === 'spis' && selectedEmail && (!extra || !extra.clearPerson)) {
      parts.push('email=' + encodeURIComponent(selectedEmail));
    }
    if (extra && extra.email) parts.push('email=' + encodeURIComponent(extra.email));
    if (extra && extra.q != null) {
      // replace q handled by rebuilding - skip, use searchQ unless clear
    }
    if (t !== 'spis') {
      var od = extra && Object.prototype.hasOwnProperty.call(extra, 'od') ? extra.od : filterFrom;
      var ddo = extra && Object.prototype.hasOwnProperty.call(extra, 'do') ? extra.do : filterTo;
      if (od) parts.push('od=' + encodeURIComponent(od));
      if (ddo) parts.push('do=' + encodeURIComponent(ddo));
    }
    if (pageNum && pageNum > 1) parts.push('page=' + pageNum);
    return '/administrace/akreditace' + (parts.length ? ('?' + parts.join('&')) : '');
  }
  function spisHref(opts) {
    opts = opts || {};
    var parts = ['tab=spis'];
    var q = opts.q != null ? opts.q : searchQ;
    if (q) parts.push('q=' + encodeURIComponent(q));
    if (opts.email) parts.push('email=' + encodeURIComponent(opts.email));
    if (opts.page && opts.page > 1) parts.push('page=' + opts.page);
    return '/administrace/akreditace?' + parts.join('&');
  }
  function detailHref(id, pageNum) {
    var parts = [];
    if (pageNum && pageNum > 1) parts.push('page=' + pageNum);
    if (activeTab === 'skryte') parts.push('tab=skryte');
    if (activeTab === 'spis') {
      parts.push('tab=spis');
      if (searchQ) parts.push('q=' + encodeURIComponent(searchQ));
      if (selectedEmail) parts.push('email=' + encodeURIComponent(selectedEmail));
    } else {
      if (filterFrom) parts.push('od=' + encodeURIComponent(filterFrom));
      if (filterTo) parts.push('do=' + encodeURIComponent(filterTo));
    }
    return '/administrace/akreditace/' + id + (parts.length ? ('?' + parts.join('&')) : '');
  }
  function fmtMatchDate(d) {
    if (!d) return '-';
    var p = String(d).split('-');
    if (p.length !== 3) return d;
    return p[2] + '.' + p[1] + '.' + p[0];
  }
  function fmtCreated(iso) {
    if (!iso) return '-';
    var s = String(iso);
    if (s.length >= 10) {
      var p = s.slice(0, 10).split('-');
      if (p.length === 3) return p[2] + '.' + p[1] + '.' + p[0];
    }
    return s;
  }
%>

<div class="border-b border-white/10 pb-6">
  <h1 class="text-2xl font-bold text-white md:text-3xl">Žádosti o akreditaci</h1>
  <p class="mt-1 text-sm text-11muted">
    <% if (activeTab === 'spis') { %>
    Spis žadatelů podle e-mailu - kolik žádostí, kolik schváleno / zamítnuto / čeká.
    <% } else { %>
    Odeslané formuláře z /akreditace včetně data zápasu, seřazené od nejbližšího termínu.
    <% } %>
  </p>
</div>

<% if (typeof flash !== 'undefined' && flash === 'deleted') { %>
<p class="mt-6 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200">
  Akreditace byla trvale smazána z administrace i z webu.
</p>
<% } else if (typeof flash !== 'undefined' && flash === 'ok') { %>
<p class="mt-6 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200">
  E-mail byl odeslán.
</p>
<% } else if (typeof flash !== 'undefined' && flash === 'fail') { %>
<p class="mt-6 rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200">
  E-mail se nepodařilo odeslat. Zkontrolujte SMTP v .env na serveru (viz návod níže).
</p>
<% } %>

<nav class="mt-8 flex flex-wrap gap-2" aria-label="Filtr akreditací">
  <a
    href="<%= tabHref('viditelne', 1) %>"
    class="inline-flex items-center gap-2 rounded-full border px-3.5 py-1.5 text-sm font-semibold transition <%= activeTab === 'viditelne' ? 'border-11accent/50 bg-11accent/15 text-11accent' : 'border-white/15 text-slate-300 hover:border-white/25 hover:text-white' %>"
  >
    Viditelné
    <span class="rounded-full bg-black/25 px-1.5 py-0.5 text-xs tabular-nums"><%= counts.viditelne %></span>
  </a>
  <a
    href="<%= tabHref('skryte', 1) %>"
    class="inline-flex items-center gap-2 rounded-full border px-3.5 py-1.5 text-sm font-semibold transition <%= activeTab === 'skryte' ? 'border-amber-400/50 bg-amber-500/15 text-amber-200' : 'border-white/15 text-slate-300 hover:border-white/25 hover:text-white' %>"
  >
    Skryté
    <span class="rounded-full bg-black/25 px-1.5 py-0.5 text-xs tabular-nums"><%= counts.skryte %></span>
  </a>
  <a
    href="<%= spisHref({ page: 1 }) %>"
    class="inline-flex items-center gap-2 rounded-full border px-3.5 py-1.5 text-sm font-semibold transition <%= activeTab === 'spis' ? 'border-sky-400/50 bg-sky-500/15 text-sky-200' : 'border-white/15 text-slate-300 hover:border-white/25 hover:text-white' %>"
  >
    Spis
    <span class="rounded-full bg-black/25 px-1.5 py-0.5 text-xs tabular-nums"><%= counts.spis || 0 %></span>
  </a>
</nav>

<style>
  @media (max-width: 767.98px) {
    .akreditace-admin-desktop-only {
      display: none !important;
    }
  }
  @media (min-width: 768px) {
    .akreditace-admin-mobile-only {
      display: none !important;
    }
  }
</style>

<% if (activeTab === 'spis') { %>

<form method="get" action="/administrace/akreditace" class="mt-6 flex flex-wrap items-end gap-3">
  <input type="hidden" name="tab" value="spis" />
  <div class="min-w-[16rem] flex-1">
    <label class="text-xs text-11muted" for="spis-q">Hledat žadatele</label>
    <input
      id="spis-q"
      name="q"
      type="search"
      value="<%= searchQ %>"
      placeholder="Jméno, e-mail nebo telefon"
      class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white"
    />
  </div>
  <button type="submit" class="rounded-xl bg-11accent px-4 py-2 text-sm font-semibold text-11bg">Hledat</button>
  <% if (searchQ) { %>
  <a href="<%= spisHref({ q: '', page: 1 }) %>" class="rounded-xl border border-white/15 px-4 py-2 text-sm text-slate-300 hover:text-white">Zrušit filtr</a>
  <% } %>
</form>

<% if (selectedEmail) { %>
<section class="card-11 mt-8 p-5 sm:p-6">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-sky-300">Kartotéka žadatele</p>
      <h2 class="mt-1 text-xl font-bold text-white"><%= personInfo ? personInfo.name : selectedEmail %></h2>
      <% if (personInfo) { %>
      <p class="mt-1 text-sm text-slate-300">
        <a href="mailto:<%= personInfo.email %>" class="text-11accent hover:underline"><%= personInfo.email %></a>
        · <%= personInfo.phone %>
      </p>
      <% } %>
    </div>
    <a href="<%= spisHref({ page: typeof pagination !== 'undefined' ? pagination.page : 1 }) %>" class="text-sm text-11muted hover:text-white">Zavřít detail</a>
  </div>

  <% if (personInfo) { %>
  <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
    <div class="rounded-xl border border-white/10 bg-black/20 px-3 py-3">
      <p class="text-xs text-11muted">Celkem</p>
      <p class="mt-1 text-2xl font-bold tabular-nums text-white"><%= personInfo.total %></p>
    </div>
    <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/10 px-3 py-3">
