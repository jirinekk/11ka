          <th class="px-4 py-2.5 font-medium whitespace-nowrap">Podáno</th>
          <th class="px-4 py-2.5 font-medium whitespace-nowrap">Detail</th>
        </tr>
      </thead>
      <tbody>
        <% personList.forEach(function (r) { %>
        <tr class="border-b border-white/5 text-slate-200">
          <td class="px-4 py-3 align-middle whitespace-nowrap"><%= r.match_name %></td>
          <td class="px-4 py-3 align-middle whitespace-nowrap font-medium text-white tabular-nums"><%= fmtMatchDate(r.match_date) %></td>
          <td class="px-4 py-3 align-middle whitespace-nowrap"><%= r.accreditation_type === 'photo' ? 'Photo' : 'Píšící' %></td>
          <td class="px-4 py-3 align-middle whitespace-nowrap">
            <%- include('../partials/accreditation-status', { accStatus: r.status, accStatusVariant: 'text' }) %>
          </td>
          <td class="px-4 py-3 align-middle whitespace-nowrap tabular-nums"><%= fmtCreated(r.created_at) %></td>
          <td class="px-4 py-3 align-middle whitespace-nowrap">
            <a href="<%= detailHref(r.id, 1) %>" class="inline-flex rounded-lg border border-11accent/40 px-2.5 py-1 text-xs font-medium text-11accent transition hover:bg-11accent/10">Zobrazit</a>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
<% } %>

<% if (!applicantsList.length) { %>
<p class="mt-8 text-11muted"><%= searchQ ? 'Nikdo neodpovídá hledání.' : 'Zatím žádní žadatelé.' %></p>
<% } else { %>
<div class="mt-8 space-y-3 akreditace-admin-mobile-only">
  <% applicantsList.forEach(function (a) { %>
  <article class="rounded-xl border border-white/10 bg-11card/60 p-4 <%= selectedEmail && a.email_key === String(selectedEmail).trim().toLowerCase() ? 'ring-1 ring-sky-400/40' : '' %>">
