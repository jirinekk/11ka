  <button type="submit" class="rounded-xl bg-11accent px-4 py-2 text-sm font-semibold text-11bg">Filtrovat</button>
  <% if (hasDateFilter) { %>
  <a href="<%= tabHref(activeTab, 1, { od: '', do: '' }) %>" class="rounded-xl border border-white/15 px-4 py-2 text-sm text-slate-300 hover:text-white">Zrušit filtr</a>
  <% } %>
</form>

<% if (!requests.length) { %>
<p class="mt-8 text-11muted"><%= hasDateFilter ? 'V tomto období žádné žádosti.' : (activeTab === 'skryte' ? 'Žádné skryté akreditace.' : 'Zatím žádné viditelné žádosti.') %></p>
<% } else { %>
<div class="mt-8 space-y-3 akreditace-admin-mobile-only">
  <% requests.forEach(function (r) { %>
  <article class="rounded-xl border border-white/10 bg-11card/60 p-4">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0 flex-1">
        <p class="text-base font-semibold text-white"><%= r.name %></p>
        <p class="mt-1 text-sm text-slate-200"><%= r.match_name %></p>
        <p class="mt-0.5 text-xs text-11muted">Datum zápasu: <%= fmtMatchDate(r.match_date) %></p>
      </div>
      <%- include('../partials/accreditation-status', { accStatus: r.status }) %>
    </div>
    <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-11muted">Typ</dt>
        <dd class="mt-0.5 text-slate-200"><%= r.accreditation_type === 'photo' ? 'Photo' : 'Píšící' %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-11muted">Telefon</dt>
        <dd class="mt-0.5 text-slate-200">
          <a href="tel:<%= r.phone %>" class="hover:text-11accent"><%= r.phone %></a>
        </dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-xs font-medium uppercase tracking-wide text-11muted">E-mail</dt>
        <dd class="mt-0.5 break-all">
          <a href="mailto:<%= r.email %>" class="text-11accent hover:underline"><%= r.email %></a>
        </dd>
      </div>
    </dl>
    <div class="mt-4 flex flex-col gap-2 sm:flex-row">
      <a
        href="<%= detailHref(r.id, typeof pagination !== 'undefined' ? pagination.page : 1) %>"
        class="inline-flex flex-1 items-center justify-center rounded-lg border border-11accent/40 bg-11accent/10 px-3 py-2.5 text-sm font-medium text-11accent transition hover:bg-11accent/20"
      >
        Zobrazit akreditaci
      </a>
      <a
        href="<%= spisHref({ email: r.email, page: 1 }) %>"
        class="inline-flex flex-1 items-center justify-center rounded-lg border border-sky-400/40 bg-sky-500/10 px-3 py-2.5 text-sm font-medium text-sky-200 transition hover:bg-sky-500/20"
      >
        Spis žadatele
      </a>
    </div>
  </article>
  <% }); %>
</div>

<div class="mt-8 akreditace-admin-desktop-only akreditace-requests-table-wrap">
  <table class="akreditace-requests-table text-left text-sm">
    <thead>
      <tr class="border-b border-white/10 text-xs uppercase tracking-wide text-11muted">
        <th class="px-4 py-2.5 font-medium whitespace-nowrap">Jméno</th>
        <th class="px-4 py-2.5 font-medium whitespace-nowrap">Zápas</th>
        <th class="px-4 py-2.5 font-medium whitespace-nowrap">Datum zápasu</th>
        <th class="px-4 py-2.5 font-medium whitespace-nowrap">Typ</th>
        <th class="px-4 py-2.5 font-medium whitespace-nowrap">Stav žádosti</th>
        <th class="px-4 py-2.5 font-medium whitespace-nowrap">E-mail</th>
        <th class="px-4 py-2.5 font-medium whitespace-nowrap">Telefon</th>
        <th class="px-4 py-2.5 font-medium whitespace-nowrap">Detail</th>
      </tr>
    </thead>
    <tbody>
      <% requests.forEach(function (r) { %>
      <tr class="border-b border-white/5 text-slate-200">
        <td class="px-4 py-3 align-middle whitespace-nowrap">
          <a href="<%= spisHref({ email: r.email, page: 1 }) %>" class="font-medium text-white hover:text-11accent" title="Otevřít spis"><%= r.name %></a>
        </td>
        <td class="px-4 py-3 align-middle whitespace-nowrap"><%= r.match_name %></td>
        <td class="px-4 py-3 align-middle whitespace-nowrap font-medium text-white tabular-nums"><%= fmtMatchDate(r.match_date) %></td>
        <td class="px-4 py-3 align-middle whitespace-nowrap"><%= r.accreditation_type === 'photo' ? 'Photo' : 'Píšící' %></td>
        <td class="px-4 py-3 align-middle whitespace-nowrap">
          <%- include('../partials/accreditation-status', { accStatus: r.status, accStatusVariant: 'text' }) %>
        </td>
        <td class="px-4 py-3 align-middle whitespace-nowrap">
          <a href="mailto:<%= r.email %>" class="text-11accent hover:underline" title="<%= r.email %>"><%= r.email %></a>
        </td>
        <td class="px-4 py-3 align-middle whitespace-nowrap tabular-nums"><%= r.phone %></td>
        <td class="px-4 py-3 align-middle whitespace-nowrap">
          <a
            href="<%= detailHref(r.id, typeof pagination !== 'undefined' ? pagination.page : 1) %>"
            class="inline-flex rounded-lg border border-11accent/40 px-2.5 py-1 text-xs font-medium text-11accent transition hover:bg-11accent/10"
          >
            Zobrazit akreditaci
          </a>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%
  var p = pagination || { page: 1, perPage: requests.length, totalPages: 1, totalItems: requests.length, hasPrev: false, hasNext: false };
  var from = p.totalItems === 0 ? 0 : ((p.page - 1) * p.perPage + 1);
  var to = p.totalItems === 0 ? 0 : Math.min(p.page * p.perPage, p.totalItems);
%>
<div class="mt-6 flex flex-wrap items-center justify-between gap-3">
  <p class="text-sm text-11muted">Zobrazeno <%= from %>-<%= to %> z <%= p.totalItems %> <%= activeTab === 'skryte' ? 'skrytých' : 'viditelných' %> žádostí</p>
  <% if (p.totalPages > 1) { %>
  <nav class="flex items-center gap-2" aria-label="Stránkování akreditací">
    <% if (p.hasPrev) { %>
    <a href="<%= tabHref(activeTab, p.page - 1) %>" class="rounded-lg border border-white/15 px-3 py-1.5 text-sm text-slate-200 transition hover:border-11accent/40 hover:text-white">Předchozí</a>
    <% } else { %>
    <span class="rounded-lg border border-white/10 px-3 py-1.5 text-sm text-slate-500">Předchozí</span>
    <% } %>
    <span class="rounded-lg border border-11accent/40 bg-11accent/10 px-3 py-1.5 text-sm font-semibold text-11accent"><%= p.page %> / <%= p.totalPages %></span>
    <% if (p.hasNext) { %>
    <a href="<%= tabHref(activeTab, p.page + 1) %>" class="rounded-lg border border-white/15 px-3 py-1.5 text-sm text-slate-200 transition hover:border-11accent/40 hover:text-white">Další</a>
    <% } else { %>
    <span class="rounded-lg border border-white/10 px-3 py-1.5 text-sm text-slate-500">Další</span>
    <% } %>
  </nav>
  <% } %>
</div>
<% } %>

<% } %>

<%- include('../partials/admin-layout-end') %>
