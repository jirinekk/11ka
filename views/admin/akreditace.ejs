      <p class="text-xs text-red-200/80">Zamítnuto</p>
      <p class="mt-1 text-2xl font-bold tabular-nums text-red-300"><%= personInfo.rejected %></p>
    </div>
    <div class="rounded-xl border border-sky-500/20 bg-sky-500/10 px-3 py-3">
      <p class="text-xs text-sky-200/80">Zažádáno</p>
      <p class="mt-1 text-2xl font-bold tabular-nums text-sky-300"><%= personInfo.requested %></p>
    </div>
    <div class="rounded-xl border border-amber-500/20 bg-amber-500/10 px-3 py-3">
      <p class="text-xs text-amber-200/80">Čeká</p>
      <p class="mt-1 text-2xl font-bold tabular-nums text-amber-300"><%= personInfo.pending %></p>
    </div>
  </div>
  <% } %>

  <% if (!personList.length) { %>
  <p class="mt-5 text-sm text-11muted">Pro tohoto žadatele nebyly nalezeny žádné žádosti.</p>
  <% } else { %>
  <div class="mt-5 space-y-3 akreditace-admin-mobile-only">
    <% personList.forEach(function (r) { %>
