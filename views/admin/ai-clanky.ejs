<%- include('../partials/admin-layout-start') %>
<%
  var items = typeof queueItems !== 'undefined' && queueItems ? queueItems : [];
  var status = typeof currentStatus !== 'undefined' ? currentStatus : 'inbox';
  var counts = typeof statusCounts !== 'undefined' && statusCounts ? statusCounts : {};
  var configured = typeof aiConfigured !== 'undefined' ? aiConfigured : false;
  var stale = typeof feedStale !== 'undefined' ? feedStale : false;
  var intervalMs = typeof feedIntervalMs !== 'undefined' ? feedIntervalMs : 15 * 60 * 1000;
%>

<div class="border-b border-white/10 pb-6">
  <h1 class="text-2xl font-bold text-white md:text-3xl">AI články</h1>
  <p class="mt-1 text-sm text-11muted">
    Feed se obnovuje každých 15 minut. Přepsat otevře editor článku s AI textem a zdrojem z RSS.
  </p>
  <p class="mt-2 text-xs text-11muted" id="feed-status">
    <% if (typeof lastFetchedLabel !== 'undefined' && lastFetchedLabel) { %>
    Poslední obnova: <%= lastFetchedLabel %>
    <% } else { %>
    Feed se ještě nenačetl.
    <% } %>
  </p>
  <%- include('../partials/admin-ai-nav', { aiTab: 'fronta' }) %>
</div>

<% if (typeof error !== 'undefined' && error) { %>
<p class="mt-6 rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200"><%= error %></p>
<% } %>
<% if (typeof success !== 'undefined' && success) { %>
<p class="mt-6 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200"><%= success %></p>
<% } %>

<% if (!configured) { %>
<p class="mt-6 rounded-lg border border-amber-500/40 bg-amber-500/10 px-4 py-3 text-sm text-amber-200">
  AI přepis není nastavený. <%= typeof aiSetupHint !== 'undefined' && aiSetupHint ? aiSetupHint : 'Doplňte GEMINI_API_KEY v .env.' %>
</p>
<% } %>

<div class="mt-8 flex flex-wrap gap-2">
  <form method="post" action="/administrace/ai-clanky">
    <input type="hidden" name="action" value="ingest" />
    <button class="rounded-xl bg-11accent px-4 py-2.5 text-sm font-semibold text-11bg hover:brightness-110" type="submit">Obnovit feed</button>
  </form>
</div>

<section class="card-11 mt-6 p-5">
  <h2 class="text-lg font-semibold text-white">Přidat článek z webu</h2>
  <form method="post" action="/administrace/ai-clanky" class="mt-4 flex flex-col gap-3 sm:flex-row">
    <input type="hidden" name="action" value="ingest_url" />
    <input name="url" type="url" required placeholder="https://… odkaz na článek" class="input-11 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
    <button class="shrink-0 rounded-xl bg-11accent px-4 py-2.5 text-sm font-semibold text-11bg" type="submit">Přidat</button>
  </form>
</section>

<div class="mt-8 flex flex-wrap gap-2">
  <% ['inbox','queue','published','rejected','failed'].forEach(function (key) { %>
  <% var labels = { inbox: 'Feed', queue: 'Ke kontrole', published: 'Vydané', rejected: 'Zamítnuté', failed: 'Chyba' }; %>
  <a href="/administrace/ai-clanky?stav=<%= key %>" class="rounded-full border px-3 py-1.5 text-xs font-semibold <%= status === key ? 'border-11accent/50 bg-11accent/15 text-11accent' : 'border-white/10 text-slate-300 hover:text-white' %>">
    <%= labels[key] %> (<%= counts[key] || 0 %>)
  </a>
  <% }); %>
</div>

<% if (!items.length) { %>
<div class="card-11 mt-8 p-10 text-center">
  <p class="text-xl font-semibold text-white">Zatím prázdno.</p>
  <p class="mt-2 text-sm text-11muted">Feed se načte automaticky, nebo klikni na Obnovit feed.</p>
</div>
<% } else { %>
<div class="mt-8 grid gap-6 md:grid-cols-2">
  <% items.forEach(function (item) { %>
  <article class="card-11 overflow-hidden">
    <div class="relative aspect-[16/9] bg-[#0f1729]">
      <% if (item.source_image) { %>
      <img src="<%= item.source_image %>" alt="" class="h-full w-full object-cover" />
      <% } else { %>
      <div class="flex h-full items-center justify-center text-5xl font-bold text-white/10">11</div>
      <% } %>
      <span class="absolute left-3 top-3 rounded-full bg-11accent/15 px-3 py-1 text-xs font-semibold text-11accent"><%= item.source_name || 'Zdroj' %></span>
    </div>
    <div class="space-y-3 p-5">
      <% if (item.category || item.tag) { %>
      <p class="text-[11px] font-semibold uppercase tracking-wider text-11accent">
        <%= item.category || '' %><% if (item.category && item.tag) { %> · <% } %><%= item.tag || '' %>
      </p>
      <% } %>
      <h3 class="text-lg font-bold leading-tight text-white"><%= item.source_title || item.title %></h3>
      <p class="line-clamp-3 text-sm leading-relaxed text-slate-300"><%= item.source_perex || item.excerpt %></p>
      <div class="flex flex-wrap items-center gap-2 pt-1">
        <% if (item.status === 'published' && item.published_url) { %>
        <a href="<%= item.published_url %>" class="rounded-xl bg-11accent px-4 py-2.5 text-sm font-semibold text-11bg" target="_blank" rel="noreferrer">Otevřít článek</a>
        <% } else { %>
        <form method="post" action="/administrace/ai-clanky/<%= item.id %>" class="js-ai-rewrite-form">
          <input type="hidden" name="action" value="open_editor" />
          <button class="rounded-xl bg-11accent px-4 py-2.5 text-sm font-semibold text-11bg hover:brightness-110" type="submit">Přepsat</button>
        </form>
        <% } %>
        <a href="<%= item.source_url %>" class="rounded-xl border border-white/15 px-3 py-2.5 text-sm text-white hover:bg-white/5" target="_blank" rel="noreferrer">Zdroj</a>
      </div>
    </div>
  </article>
  <% }); %>
</div>
<% } %>

<div id="ai-rewrite-wait" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-6">
  <div class="card-11 max-w-sm p-6 text-center">
    <p class="text-lg font-semibold text-white">Přepisuji článek…</p>
    <p class="mt-2 text-sm text-11muted">Otevře se editor s AI textem a vyplněným zdrojem.</p>
  </div>
</div>

<script>
(function () {
  var intervalMs = <%= Number(intervalMs) || 900000 %>;
  var stale = <%= stale ? 'true' : 'false' %>;
  var statusEl = document.getElementById('feed-status');
  var waitEl = document.getElementById('ai-rewrite-wait');

  document.querySelectorAll('.js-ai-rewrite-form').forEach(function (form) {
    form.addEventListener('submit', function () {
      if (waitEl) {
        waitEl.classList.remove('hidden');
        waitEl.classList.add('flex');
      }
      var btn = form.querySelector('button');
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Přepisuji…';
      }
    });
  });

  function refreshFeed() {
    if (statusEl) statusEl.textContent = 'Obnovuji feed…';
    return fetch('/administrace/ai-clanky?ajax=1', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Accept': 'application/json',
      },
      body: 'action=ingest',
      credentials: 'same-origin',
    }).then(function () {
      window.location.reload();
    }).catch(function () {
      window.location.reload();
    });
  }

  if (stale) {
    refreshFeed();
    return;
  }
  window.setTimeout(refreshFeed, intervalMs);
})();
</script>

<%- include('../partials/admin-layout-end') %>
