<%- include('../partials/admin-layout-start') %>

<div class="flex flex-wrap items-end justify-between gap-4 border-b border-white/10 pb-6">
  <div>
    <h1 class="text-2xl font-bold text-white md:text-3xl">Články</h1>
    <p class="mt-1 text-sm text-11muted">Přehled všech článků v systému</p>
  </div>
  <a href="/administrace/clanek/novy" class="btn-11 btn-11--primary">Nový článek</a>
</div>

<%
  var f = filters || { q: '', status: '' };
  var statusVals = statusOptions || ['draft', 'pending', 'published', 'scheduled'];
  function pageLink(pageNum) {
    var ps = [];
    ps.push('page=' + encodeURIComponent(String(pageNum)));
    if (f.q) ps.push('q=' + encodeURIComponent(f.q));
    if (f.status) ps.push('status=' + encodeURIComponent(f.status));
    return '/administrace/clanky?' + ps.join('&');
  }
%>
<form method="get" action="/administrace/clanky" class="mt-6 grid gap-3 rounded-xl border border-white/10 bg-[#111827]/60 p-4 sm:grid-cols-[minmax(0,1fr)_200px_auto]">
  <div>
    <label for="q" class="text-xs text-11muted">Vyhledávání</label>
    <input id="q" name="q" type="search" value="<%= f.q %>" placeholder="Nadpis, perex, autor, e-mail" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
  </div>
  <div>
    <label for="status" class="text-xs text-11muted">Stav</label>
    <select id="status" name="status" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white">
      <option value="">Všechny</option>
      <% statusVals.forEach(function (s) { %>
      <option value="<%= s %>" <%= f.status === s ? 'selected' : '' %>><%= s %></option>
      <% }); %>
    </select>
  </div>
  <div class="flex items-end gap-2">
    <button type="submit" class="btn-11 btn-11--primary">Filtrovat</button>
    <% if (f.q || f.status) { %>
    <a href="/administrace/clanky" class="btn-11 btn-11--ghost">Reset</a>
    <% } %>
  </div>
</form>

<ul class="mt-8 space-y-2">
  <% if (!articles.length) { %>
  <li class="card-11 px-4 py-6 text-sm text-11muted">Žádné články neodpovídají zadanému filtru.</li>
  <% } %>
  <% articles.forEach(function (a) { 
    var del = currentUser && (
      (typeof hasAnyRole === 'function' ? hasAnyRole(currentUser, 'vedeni', 'sefredaktor') : (currentUser.role === 'vedeni' || currentUser.role === 'sefredaktor'))
      || ((typeof isRedaktorWorkflow === 'function' ? isRedaktorWorkflow(currentUser) : currentUser.role === 'redaktor') && a.author_id === currentUser.id && a.status === 'draft')
    );
  %>
  <li class="card-11 flex flex-wrap items-center justify-between gap-3 px-4 py-3">
    <div>
      <span class="font-medium text-white"><%= a.title %></span>
      <span class="ml-2 text-xs text-11accent"><%= a.status %></span>
      <p class="text-xs text-11muted"><%= a.author_display || a.author_email %></p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <a href="/administrace/clanek/<%= a.id %>/edit" class="text-sm text-11accent hover:underline">Upravit</a>
      <% if (del) { %>
      <form method="post" action="/administrace/clanek/<%= a.id %>/smazat" class="inline" onsubmit="return confirm('Smazat článek?');">
        <button type="submit" class="text-sm text-red-400 hover:underline">Smazat</button>
      </form>
      <% } %>
    </div>
  </li>
  <% }); %>
</ul>

<%
  var p = pagination || { page: 1, totalPages: 1, totalItems: articles.length, hasPrev: false, hasNext: false };
  var from = p.totalItems === 0 ? 0 : ((p.page - 1) * p.perPage + 1);
  var to = p.totalItems === 0 ? 0 : Math.min(p.page * p.perPage, p.totalItems);
%>
<div class="mt-6 flex flex-wrap items-center justify-between gap-3">
  <p class="text-sm text-11muted">Zobrazeno <%= from %>-<%= to %> z <%= p.totalItems %> článků</p>
  <% if (p.totalPages > 1) { %>
  <nav class="flex items-center gap-2" aria-label="Stránkování článků">
    <% if (p.hasPrev) { %>
    <a href="<%= pageLink(p.page - 1) %>" class="rounded-lg border border-white/15 px-3 py-1.5 text-sm text-slate-200 transition hover:border-11accent/40 hover:text-white">Předchozí</a>
    <% } else { %>
    <span class="rounded-lg border border-white/10 px-3 py-1.5 text-sm text-slate-500">Předchozí</span>
    <% } %>
    <span class="rounded-lg border border-11accent/40 bg-11accent/10 px-3 py-1.5 text-sm font-semibold text-11accent"><%= p.page %> / <%= p.totalPages %></span>
    <% if (p.hasNext) { %>
    <a href="<%= pageLink(p.page + 1) %>" class="rounded-lg border border-white/15 px-3 py-1.5 text-sm text-slate-200 transition hover:border-11accent/40 hover:text-white">Další</a>
    <% } else { %>
    <span class="rounded-lg border border-white/10 px-3 py-1.5 text-sm text-slate-500">Další</span>
    <% } %>
  </nav>
  <% } %>
</div>

<%- include('../partials/admin-layout-end') %>
