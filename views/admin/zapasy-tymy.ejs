<%- include('../partials/admin-layout-start') %>

<%
  var teamsListHref =
    pagination && pagination.page && pagination.page > 1
      ? '/administrace/zapasy/tymy?page=' + pagination.page
      : '/administrace/zapasy/tymy';
%>
<%- include('../partials/admin-zapasy-back', { zapasyBackHref: editingTeam ? teamsListHref : undefined }) %>
<div class="mt-4 border-b border-white/10 pb-6">
  <h1 class="text-2xl font-bold text-white md:text-3xl"><%= editingTeam ? 'Upravit tým' : 'Seznam týmů' %></h1>
</div>
<%- include('../partials/admin-zapasy-alerts') %>

<% if (editingTeam) { %>
<%- include('../partials/admin-zapasy-team-form', {
  editingTeam: editingTeam,
  formAction: '/administrace/zapasy/tymy',
  cancelHref: teamsListHref,
  pagination: pagination
}) %>
<% } else { %>
<%- include('../partials/admin-zapasy-team-list') %>
<%- include('../partials/admin-zapasy-pagination', { listAnchor: '#zapasy-admin-teams' }) %>

<script>
  (function () {
    if (window.location.hash === '#zapasy-admin-teams') {
      var el = document.getElementById('zapasy-admin-teams');
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  })();
</script>
<% } %>

<%- include('../partials/admin-layout-end') %>
