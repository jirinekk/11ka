<%- include('../partials/admin-layout-start') %>

<div class="border-b border-white/10 pb-6">
  <h1 class="text-2xl font-bold text-white md:text-3xl">Bio</h1>
  <p class="mt-1 text-sm text-11muted">
    Texty O autorovi pro profily na <span class="text-slate-400">/redaktor/…</span>.
    Na webu je jen schválené bio.
    <% if (pendingCount > 0) { %>
    · <span class="text-amber-300"><%= pendingCount %> ke schválení</span>
    <% } %>
  </p>
</div>

<% if (error) { %><p class="mt-6 rounded-lg border border-red-500/40 bg-red-500/10 px-3 py-2 text-sm text-red-200"><%= error %></p><% } %>
<% if (success) { %><p class="mt-6 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-3 py-2 text-sm text-emerald-200"><%= success %></p><% } %>

<%
  function roleName(r) {
    if (r === 'sefredaktor') return 'Šéfredaktor';
    if (r === 'redaktor') return 'Redaktor';
    if (r === 'vedeni') return 'Vedení';
    if (r === 'spravce_akreditace') return 'Správce Akreditace';
    return r;
  }
  function rolesLabel(item) {
    var list = (item.roles && item.roles.length) ? item.roles : (item.role ? [item.role] : []);
    return list.map(roleName).join(', ');
  }
  function statusLabel(s) {
    if (s === 'pending') return 'Ke schválení';
    if (s === 'approved') return 'Na webu';
    return 'Prázdné';
  }
%>

<section class="mt-8 grid gap-3 sm:grid-cols-3">
  <div class="card-11 p-4">
    <p class="text-xs text-11muted">Ke schválení</p>
    <p class="mt-1 text-2xl font-bold text-amber-300"><%= items.filter(function (i) { return i.status === 'pending'; }).length %></p>
  </div>
  <div class="card-11 p-4">
    <p class="text-xs text-11muted">Na webu</p>
    <p class="mt-1 text-2xl font-bold text-white"><%= items.filter(function (i) { return i.status === 'approved'; }).length %></p>
  </div>
  <div class="card-11 p-4">
    <p class="text-xs text-11muted">Bez bio</p>
    <p class="mt-1 text-2xl font-bold text-slate-400"><%= items.filter(function (i) { return i.status === 'empty'; }).length %></p>
  </div>
</section>

<section class="mt-8 space-y-4">
  <% if (!items.length) { %>
  <p class="text-sm text-11muted">Žádní redakční uživatelé.</p>
  <% } %>
  <% items.forEach(function (item) { %>
  <article class="card-11 p-5<%= item.status === 'pending' ? ' ring-1 ring-amber-500/30' : '' %>">
    <div class="flex flex-wrap items-start justify-between gap-3 border-b border-white/10 pb-4">
      <div class="min-w-0">
        <p class="font-semibold text-white"><%= item.display_name || item.email %></p>
        <p class="mt-0.5 text-xs text-11muted"><%= item.email %> · <%= rolesLabel(item) %></p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full border px-2.5 py-1 text-xs font-semibold <%= item.status === 'pending' ? 'border-amber-500/40 bg-amber-500/10 text-amber-200' : item.status === 'approved' ? 'border-emerald-500/40 bg-emerald-500/10 text-emerald-200' : 'border-white/15 text-slate-400' %>"><%= statusLabel(item.status) %></span>
        <a href="/redaktor/<%= item.id %>" class="text-xs text-11accent hover:underline" target="_blank" rel="noopener">Profil na webu</a>
      </div>
    </div>

    <form method="post" action="/administrace/bio" class="mt-4 space-y-4">
      <input type="hidden" name="id" value="<%= item.id %>" />
      <% if (item.bioPending) { %>
      <div class="rounded-lg border border-amber-500/35 bg-amber-500/10 p-3">
        <p class="text-xs font-semibold text-amber-200">Návrh od autora</p>
        <p class="author-bio-preview mt-2 text-sm leading-relaxed text-slate-200"><%= item.bioPending %></p>
      </div>
      <% } %>
      <div>
        <label class="text-xs text-11muted">Text pro web (upravte před schválením)</label>
        <textarea
          name="author_bio"
          rows="5"
          maxlength="<%= authorBioMax %>"
          placeholder="Schválený text O autorovi…"
          class="input-11 mt-1 w-full resize-y rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm leading-relaxed text-white"
        ><%= item.bioPending || item.bioLive || '' %></textarea>
      </div>
      <% if (item.bioLive && item.bioPending) { %>
      <div class="rounded-lg border border-white/10 bg-white/[0.03] p-3">
        <p class="text-xs text-11muted">Aktuálně na webu</p>
        <p class="author-bio-preview mt-2 text-sm leading-relaxed text-slate-300"><%= item.bioLive %></p>
      </div>
      <% } %>
      <div class="flex flex-wrap gap-2">
        <% if (item.bioPending) { %>
        <button type="submit" name="action" value="approve" class="rounded-lg bg-11accent px-4 py-2 text-sm font-semibold text-11bg">Schválit a zveřejnit</button>
        <button type="submit" name="action" value="reject" formnovalidate class="rounded-lg border border-white/15 px-4 py-2 text-sm text-slate-200 hover:bg-white/5">Zamítnout návrh</button>
        <% } else { %>
        <button type="submit" name="action" value="save" class="rounded-lg bg-11accent px-4 py-2 text-sm font-semibold text-11bg">Uložit a zveřejnit</button>
        <% } %>
        <% if (item.bioLive) { %>
        <button type="submit" name="action" value="clear" formnovalidate onclick="return confirm('Odebrat bio z webu?');" class="rounded-lg border border-red-500/40 px-4 py-2 text-sm text-red-300 hover:bg-red-500/10">Odebrat z webu</button>
        <% } %>
      </div>
    </form>
  </article>
  <% }); %>
</section>

<%- include('../partials/admin-layout-end') %>
