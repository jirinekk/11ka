<%- include('../partials/admin-layout-start') %>
<%
  var listTab = typeof backTab !== 'undefined' && (backTab === 'skryte' || backTab === 'spis')
    ? backTab
    : (Number(request.hidden_from_web) === 1 ? 'skryte' : 'viditelne');
  var listPage = typeof backPage !== 'undefined' && backPage > 1 ? backPage : 1;
  var listEmail = typeof backEmail !== 'undefined' && backEmail ? String(backEmail) : '';
  var backParts = [];
  if (listTab === 'skryte') backParts.push('tab=skryte');
  if (listTab === 'spis') {
    backParts.push('tab=spis');
    if (listEmail) backParts.push('email=' + encodeURIComponent(listEmail));
  }
  if (listPage > 1) backParts.push('page=' + listPage);
  var backHref = '/administrace/akreditace' + (backParts.length ? ('?' + backParts.join('&')) : '');
  var backLabel = listTab === 'spis' ? '← Zpět na spis' : '← Zpět na seznam';
%>

<div class="border-b border-white/10 pb-6">
  <a href="<%= backHref %>" class="text-sm text-11muted transition hover:text-11accent"><%= backLabel %></a>
  <h1 class="mt-3 text-2xl font-bold text-white md:text-3xl">Žádost o akreditaci</h1>
  <p class="mt-1 text-sm text-11muted">#<%= request.id %> · <%= new Date(request.created_at).toLocaleString('cs-CZ', { dateStyle: 'long', timeStyle: 'short' }) %></p>
  <% if (listTab !== 'spis') { %>
  <p class="mt-2">
    <a href="/administrace/akreditace?tab=spis&email=<%= encodeURIComponent(request.email) %>" class="text-sm font-medium text-sky-300 hover:underline">Otevřít spis žadatele</a>
  </p>
  <% } %>
</div>

<% if (typeof flash !== 'undefined' && flash === 'ok') { %>
<p class="mt-6 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200">
  E-mail byl odeslán.
</p>
<% } else if (typeof flash !== 'undefined' && flash === 'fail') { %>
<p class="mt-6 rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200">
  E-mail se nepodařilo odeslat.
</p>
<% } else if (typeof flash !== 'undefined' && flash === 'approved') { %>
<p class="mt-6 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200">
  Žádost byla označena jako schválená.
</p>
<% } else if (typeof flash !== 'undefined' && flash === 'rejected') { %>
<p class="mt-6 rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200">
  Žádost byla označena jako zamítnutá.
</p>
<% } else if (typeof flash !== 'undefined' && flash === 'requested') { %>
<p class="mt-6 rounded-lg border border-sky-500/40 bg-sky-500/10 px-4 py-3 text-sm text-sky-200">
  Žádost byla označena jako zažádáno.
</p>
<% } else if (typeof flash !== 'undefined' && flash === 'web-hidden') { %>
<p class="mt-6 rounded-lg border border-amber-500/40 bg-amber-500/10 px-4 py-3 text-sm text-amber-200">
  Akreditace byla odebrána z webu. V administraci zůstává v záložce Skryté.
</p>
<% } else if (typeof flash !== 'undefined' && flash === 'web-shown') { %>
<p class="mt-6 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200">
  Akreditace je znovu viditelná na webu.
</p>
<% } %>

<%
  var st = String(request.status || 'pending').trim().toLowerCase();
  if (st !== 'approved' && st !== 'rejected' && st !== 'requested' && st !== 'pending') st = 'pending';
  var isHiddenFromWeb = Number(request.hidden_from_web) === 1;
  function fmtMatchDate(d) {
    if (!d) return '-';
    var p = String(d).split('-');
    if (p.length !== 3) return d;
    return p[2] + '.' + p[1] + '.' + p[0];
  }
%>

<div class="card-11 mt-8 p-6 sm:p-8">
  <dl class="grid gap-5 sm:grid-cols-2">
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-11muted">Jméno</dt>
      <dd class="mt-1 text-base font-medium text-white"><%= request.name %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-11muted">E-mail</dt>
      <dd class="mt-1">
        <a href="mailto:<%= request.email %>" class="text-11accent hover:underline"><%= request.email %></a>
      </dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-11muted">Telefonní číslo</dt>
      <dd class="mt-1 text-white">
        <a href="tel:<%= request.phone %>" class="hover:text-11accent"><%= request.phone %></a>
      </dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-11muted">Typ akreditace</dt>
      <dd class="mt-1 text-white"><%= request.accreditation_type === 'photo' ? 'Photo' : 'Píšící' %></dd>
    </div>
    <div class="sm:col-span-2">
      <dt class="text-xs font-medium uppercase tracking-wide text-11muted">Zápas</dt>
      <dd class="mt-1 text-lg font-semibold text-white"><%= request.match_name %></dd>
      <dd class="mt-1 text-sm text-11muted">Datum zápasu: <span class="font-medium text-slate-200"><%= fmtMatchDate(request.match_date) %></span></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-11muted">Stav žádosti</dt>
      <dd class="mt-1">
        <%- include('../partials/accreditation-status', { accStatus: request.status, accStatusVariant: 'detail', accStatusLong: true }) %>
      </dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-11muted">Zobrazení na webu</dt>
      <dd class="mt-1">
        <% if (isHiddenFromWeb) { %>
        <span class="inline-flex rounded-full border border-amber-500/40 bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-200">Odebráno z webu</span>
        <% } else { %>
        <span class="inline-flex rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-200">Viditelné na webu</span>
        <% } %>
      </dd>
    </div>
  </dl>

  <div class="mt-8 flex flex-wrap gap-3 border-t border-white/10 pt-6">
    <% if (!request.email_sent) { %>
    <form method="post" action="/administrace/akreditace/<%= request.id %>/odeslat-email" class="inline">
      <input type="hidden" name="page" value="<%= listPage %>" />
      <input type="hidden" name="tab" value="<%= listTab %>" />
      <% if (listEmail) { %><input type="hidden" name="email" value="<%= listEmail %>" /><% } %>
      <button type="submit" class="rounded-xl bg-11accent px-4 py-2 text-sm font-semibold text-11bg transition hover:brightness-110">
        Odeslat e-mail
      </button>
    </form>
    <% } %>
    <a
      href="mailto:<%= request.email %>?subject=<%= encodeURIComponent('Akreditace - ' + request.match_name) %>"
      class="rounded-xl border border-white/15 px-4 py-2 text-sm font-medium text-slate-200 transition hover:border-11accent/40 hover:text-white"
    >
      Odpovědět žadateli
    </a>
    <form method="post" action="/administrace/akreditace/<%= request.id %>/zazadano" class="inline">
      <input type="hidden" name="page" value="<%= listPage %>" />
      <input type="hidden" name="tab" value="<%= listTab %>" />
      <% if (listEmail) { %><input type="hidden" name="email" value="<%= listEmail %>" /><% } %>
      <button
        type="submit"
        class="rounded-xl border border-sky-500/50 bg-sky-500/15 px-4 py-2 text-sm font-semibold text-sky-200 transition hover:bg-sky-500/25<%= st === 'requested' ? ' ring-2 ring-sky-300/80' : '' %>"
      >
        Zažádáno
      </button>
    </form>
    <form method="post" action="/administrace/akreditace/<%= request.id %>/schvalit" class="inline">
      <input type="hidden" name="page" value="<%= listPage %>" />
      <input type="hidden" name="tab" value="<%= listTab %>" />
      <% if (listEmail) { %><input type="hidden" name="email" value="<%= listEmail %>" /><% } %>
      <button
        type="submit"
        class="rounded-xl bg-emerald-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-400<%= st === 'approved' ? ' ring-2 ring-emerald-300/80' : '' %>"
      >
        Schválit
      </button>
    </form>
    <form method="post" action="/administrace/akreditace/<%= request.id %>/zamitnout" class="inline">
      <input type="hidden" name="page" value="<%= listPage %>" />
      <input type="hidden" name="tab" value="<%= listTab %>" />
      <% if (listEmail) { %><input type="hidden" name="email" value="<%= listEmail %>" /><% } %>
      <button
        type="submit"
        class="rounded-xl border border-red-500/50 bg-red-500/15 px-4 py-2 text-sm font-semibold text-red-200 transition hover:bg-red-500/25<%= st === 'rejected' ? ' ring-1 ring-red-400/60' : '' %>"
      >
        Zamítnout
      </button>
    </form>
    <% if (isHiddenFromWeb) { %>
    <form method="post" action="/administrace/akreditace/<%= request.id %>/vratit-na-web" class="inline">
      <input type="hidden" name="page" value="<%= listPage %>" />
      <input type="hidden" name="tab" value="<%= listTab %>" />
      <% if (listEmail) { %><input type="hidden" name="email" value="<%= listEmail %>" /><% } %>
      <button
        type="submit"
        class="rounded-xl border border-amber-500/50 bg-amber-500/15 px-4 py-2 text-sm font-semibold text-amber-200 transition hover:bg-amber-500/25"
      >
        Vrátit na web
      </button>
    </form>
    <% } else { %>
    <form
      method="post"
      action="/administrace/akreditace/<%= request.id %>/odebrat-z-webu"
      class="inline"
      onsubmit="return confirm('Odebrat tuto akreditaci z veřejného webu? V administraci zůstane v záložce Skryté.');"
    >
      <input type="hidden" name="page" value="<%= listPage %>" />
      <input type="hidden" name="tab" value="<%= listTab %>" />
      <% if (listEmail) { %><input type="hidden" name="email" value="<%= listEmail %>" /><% } %>
      <button
        type="submit"
        class="rounded-xl border border-amber-500/50 bg-amber-500/15 px-4 py-2 text-sm font-semibold text-amber-200 transition hover:bg-amber-500/25"
      >
        Odebrat z webu
      </button>
    </form>
    <% } %>
    <form
      method="post"
      action="/administrace/akreditace/<%= request.id %>/smazat"
      class="inline"
      onsubmit="return confirm('Opravdu trvale smazat tuto akreditaci z administrace i z webu?');"
    >
      <input type="hidden" name="page" value="<%= listPage %>" />
      <input type="hidden" name="tab" value="<%= listTab %>" />
      <% if (listEmail) { %><input type="hidden" name="email" value="<%= listEmail %>" /><% } %>
      <button
        type="submit"
        class="rounded-xl border border-red-500/40 px-4 py-2 text-sm font-medium text-red-300 transition hover:bg-red-500/10"
      >
        Smazat akreditaci
      </button>
    </form>
  </div>
</div>

<%- include('../partials/admin-layout-end') %>
