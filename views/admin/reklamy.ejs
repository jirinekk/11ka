<%- include('../partials/admin-layout-start') %>

<div class="border-b border-white/10 pb-6">
  <h1 class="text-2xl font-bold text-white md:text-3xl">Reklamy</h1>
  <p class="mt-2 text-sm text-11muted">Nahrajte více kreativ do slotu — na webu se náhodně střídají.</p>
</div>

<% if (error) { %><p class="mt-6 rounded-lg border border-red-500/40 bg-red-500/10 px-3 py-2 text-sm text-red-200"><%= error %></p><% } %>
<% if (success) { %><p class="mt-6 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-3 py-2 text-sm text-emerald-200"><%= success %></p><% } %>

<% (slots || []).forEach(function (slotMeta) { %>
<section class="card-11 mt-8 space-y-5 p-4 sm:p-6">
  <div>
    <h2 class="text-lg font-semibold text-white"><%= slotMeta.label %></h2>
    <p class="mt-1 text-xs text-11muted">Slot: <code class="text-slate-400"><%= slotMeta.slot %></code></p>
  </div>

  <form method="post" action="/administrace/reklamy" enctype="multipart/form-data" class="grid gap-3 rounded-xl border border-white/10 bg-black/20 p-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto_auto]">
    <input type="hidden" name="action" value="create" />
    <input type="hidden" name="slot" value="<%= slotMeta.slot %>" />
    <div>
      <label class="text-xs text-11muted" for="image-<%= slotMeta.slot %>">Obrázek</label>
      <input id="image-<%= slotMeta.slot %>" name="image" type="file" accept="image/jpeg,image/png,image/webp,image/gif" required class="mt-1 block w-full min-w-0 text-sm text-11muted file:mr-3 file:rounded-lg file:border-0 file:bg-11accent file:px-3 file:py-2 file:text-sm file:font-medium file:text-11bg" />
    </div>
    <div>
      <label class="text-xs text-11muted" for="link-<%= slotMeta.slot %>">Odkaz</label>
      <input id="link-<%= slotMeta.slot %>" name="link_url" type="url" required placeholder="https://..." class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
    </div>
    <label class="flex items-end gap-2 pb-2 text-sm text-slate-300">
      <input type="checkbox" name="is_active" value="1" checked class="rounded border-white/20 bg-[#0b1220] text-11accent focus:ring-11accent/40" />
      Aktivní
    </label>
    <div class="flex items-end">
      <button type="submit" class="btn-11 btn-11--primary">Přidat</button>
    </div>
  </form>

  <% if (!slotMeta.creatives || !slotMeta.creatives.length) { %>
  <p class="text-sm text-11muted">Zatím žádné kreativy v tomto slotu.</p>
  <% } else { %>
  <ul class="space-y-4">
    <% slotMeta.creatives.forEach(function (c) { %>
    <li class="rounded-xl border border-white/10 bg-black/15 p-4">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
        <a href="<%= c.link_url %>" target="_blank" rel="noopener noreferrer" class="block shrink-0 overflow-hidden rounded-lg border border-white/10 bg-[#0b1220]">
          <img src="<%= c.image_path %>" alt="" class="h-28 w-auto max-w-[220px] object-contain" loading="lazy" />
        </a>
        <div class="min-w-0 flex-1 space-y-3">
          <form method="post" action="/administrace/reklamy" enctype="multipart/form-data" class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto]">
            <input type="hidden" name="action" value="update" />
            <input type="hidden" name="id" value="<%= c.id %>" />
            <input type="hidden" name="slot" value="<%= slotMeta.slot %>" />
            <div class="space-y-3">
              <div>
                <label class="text-xs text-11muted">Odkaz</label>
                <input name="link_url" type="url" required value="<%= c.link_url %>" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
              </div>
              <div>
                <label class="text-xs text-11muted">Nový obrázek (volitelné)</label>
                <input name="image" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="mt-1 block w-full min-w-0 text-sm text-11muted file:mr-3 file:rounded-lg file:border-0 file:bg-11accent file:px-3 file:py-2 file:text-sm file:font-medium file:text-11bg" />
              </div>
              <label class="inline-flex items-center gap-2 text-sm text-slate-300">
                <input type="checkbox" name="is_active" value="1" <%= c.is_active ? 'checked' : '' %> class="rounded border-white/20 bg-[#0b1220] text-11accent focus:ring-11accent/40" />
                Aktivní
              </label>
            </div>
            <div class="flex flex-wrap items-end gap-2">
              <button type="submit" class="btn-11 btn-11--primary">Uložit</button>
            </div>
          </form>
          <div class="flex flex-wrap gap-2">
            <form method="post" action="/administrace/reklamy">
              <input type="hidden" name="action" value="toggle" />
              <input type="hidden" name="id" value="<%= c.id %>" />
              <button type="submit" class="btn-11 btn-11--ghost"><%= c.is_active ? 'Vypnout' : 'Zapnout' %></button>
            </form>
            <form method="post" action="/administrace/reklamy" onsubmit="return confirm('Smazat tuto reklamu?');">
              <input type="hidden" name="action" value="delete" />
              <input type="hidden" name="id" value="<%= c.id %>" />
              <button type="submit" class="btn-11 btn-11--ghost text-red-300 hover:text-red-200">Smazat</button>
            </form>
          </div>
        </div>
      </div>
    </li>
    <% }); %>
  </ul>
  <% } %>
</section>
<% }); %>

<%- include('../partials/admin-layout-end') %>
