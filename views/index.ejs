<%- include('partials/header') %>

<main id="main-content" class="flex-1" tabindex="-1">
  <div class="mx-auto max-w-[1400px] px-4 py-6 lg:px-6 lg:py-8">
    <h1 class="sr-only">11ka.cz - hlavní přehled článků</h1>

    <div class="site-shell">
      <div class="site-shell__main min-w-0 space-y-8">
        <% var slides = (typeof heroSlides !== 'undefined' && heroSlides && heroSlides.length) ? heroSlides : [hero]; %>
        <%- include('partials/home-featured', { slides: slides }) %>

        <%- include('partials/home-mobile-ad') %>

        <% (typeof homeSections !== 'undefined' ? homeSections : []).forEach(function (section, sectionIndex) { %>
        <%- include('partials/home-category-section', Object.assign({}, section, { sectionIndex: sectionIndex, showSectionAd: section.title === 'Český Fotbal' })) %>
        <% if (section && section.title === 'Český Fotbal' && typeof homeLeaderboardPlacementsBySlug !== 'undefined' && homeLeaderboardPlacementsBySlug['cesky-fotbal']) { %>
        <%- include('partials/home-leaderboard-ad', homeLeaderboardPlacementsBySlug['cesky-fotbal']) %>
        <% } %>
        <% if (section && section.title === 'Český Fotbal') { %>
        <%- include('partials/chance-liga-board', { chanceMatchLeagues: typeof chanceMatchLeagues !== 'undefined' ? chanceMatchLeagues : [], chanceLigaHref: '/zapasy/live' }) %>
        <% } %>
        <% }); %>
      </div>

      <aside class="site-shell__rail space-y-6">
        <div class="news-rail">
          <%- include('partials/sidebar-most-read', { items: typeof sidebarMostRead !== 'undefined' ? sidebarMostRead : [], mostReadLimit: 4 }) %>
        </div>

        <%- include('partials/sidebar-ssp-ad') %>

        <%- include('partials/sidebar-kitswaps', { kitswaps: typeof kitswaps !== 'undefined' ? kitswaps : [] }) %>

        <%- include('partials/chance-liga-table', { standings: typeof chanceStandings !== 'undefined' ? chanceStandings : [], compactTable: true, tableRail: true, tableHref: '/zapasy/live#tabulka' }) %>

        <div class="card-11 p-4 perf-cv">
          <h2 class="mb-2 text-lg font-bold text-11accent">Newsletter</h2>
          <p class="text-sm text-11muted"><%= newsletter.description %></p>
          <% if (typeof newsletterStatus !== 'undefined' && newsletterStatus === 'ok') { %>
          <p class="mt-3 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-3 py-2 text-xs text-emerald-200">Jste přihlášeni k odběru novinek.</p>
          <% } else if (typeof newsletterStatus !== 'undefined' && newsletterStatus === 'dupe') { %>
          <p class="mt-3 rounded-lg border border-amber-500/40 bg-amber-500/10 px-3 py-2 text-xs text-amber-200">Tento e-mail už v odběru je.</p>
          <% } else if (typeof newsletterStatus !== 'undefined' && newsletterStatus === 'bad') { %>
          <p class="mt-3 rounded-lg border border-red-500/40 bg-red-500/10 px-3 py-2 text-xs text-red-200">Zadejte platný e-mail.</p>
          <% } %>
          <form class="mt-4 space-y-2" action="/newsletter" method="post">
            <label class="sr-only" for="newsletter-email">E-mail</label>
            <input id="newsletter-email" name="email" type="email" required autocomplete="email" placeholder="váš@email.cz" class="input-11 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2.5 text-sm text-white placeholder:text-11muted focus:border-11accent/50 focus:outline-none focus:ring-1 focus:ring-11accent/40" />
            <button type="submit" class="btn-11 btn-11--primary btn-11--block">Přihlásit se</button>
          </form>
        </div>

        <%- include('partials/promo-banner', { promoBanner: typeof homeBelowSocialAd !== 'undefined' ? homeBelowSocialAd : null }) %>
        <% if (typeof sidebarFavorites !== 'undefined' && sidebarFavorites && sidebarFavorites.length) { %>
        <div class="news-rail">
          <%- include('partials/sidebar-favorites', { items: sidebarFavorites }) %>
        </div>
        <% } %>
        <%- include('partials/sidebar-social') %>
      </aside>
    </div>
  </div>
</main>

  <div
    id="recruitment-modal"
    class="recruitment-modal"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-labelledby="recruitment-modal-title"
    data-recruitment-modal
  >
    <button type="button" class="recruitment-modal-backdrop absolute inset-0 focus:outline-none" aria-hidden="true" tabindex="-1" data-recruitment-close></button>
    <div class="recruitment-modal-card relative w-full max-w-lg rounded-2xl border border-white/15 bg-[#0f1729] p-6 shadow-xl shadow-black/60 ring-1 ring-white/10 sm:p-7">
      <button
        type="button"
        class="recruitment-modal__close"
        aria-label="Zavřít náborové okno"
        data-recruitment-close
        data-recruitment-focus
      >
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.22 4.22a.75.75 0 011.06 0L10 8.94l4.72-4.72a.75.75 0 111.06 1.06L11.06 10l4.72 4.72a.75.75 0 11-1.06 1.06L10 11.06l-4.72 4.72a.75.75 0 11-1.06-1.06L8.94 10 4.22 5.28a.75.75 0 010-1.06z" clip-rule="evenodd"/></svg>
      </button>
      <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-11accent">Nábor do redakce</p>
      <h2 id="recruitment-modal-title" class="text-2xl font-bold leading-tight text-white sm:text-3xl">Hledáme redaktory</h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-200 sm:text-base">
        Chceš psát články o novém dění okolo českého i světového fotbalu? Přidej se k nám do redakce 11ka.cz.
      </p>
      <p class="mt-5 text-sm font-medium uppercase tracking-wide text-slate-300">Ozvi se nám na e-mail:</p>
      <a href="mailto:kjehne@11ka.cz" class="mt-1 inline-block text-xl font-extrabold tracking-wide text-white hover:text-11accent sm:text-2xl">
        kjehne@11ka.cz
      </a>
    </div>
  </div>

<% if (typeof homeLeaderboardPlacements !== 'undefined' && homeLeaderboardPlacements && homeLeaderboardPlacements.length) { %>
<div
  id="home-leaderboard-ads-data"
  hidden
  data-placements="<%= Buffer.from(JSON.stringify(homeLeaderboardPlacements), 'utf8').toString('base64') %>"
></div>
<script src="/js/home-leaderboard-ads.js?v=<%= encodeURIComponent(typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" defer></script>
<% } %>

<% if (typeof kitswaps !== 'undefined' && kitswaps && kitswaps.length > 1) { %>
<script src="/js/kitswap-carousel.js?v=<%= encodeURIComponent(typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" defer></script>
<% } %>

<% if (typeof heroSlides !== 'undefined' && heroSlides && heroSlides.length) { %>
<script src="/js/hero-slider.js?v=<%= encodeURIComponent((typeof assetVersion !== 'undefined' ? assetVersion : '1') + '-hero5') %>" defer></script>
<% } %>

<%- include('partials/footer') %>
