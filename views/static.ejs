<%- include('partials/header') %>

<main id="main-content" class="flex-1" tabindex="-1">
  <div class="mx-auto max-w-7xl px-4 py-6 lg:px-6 lg:py-8">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-start">
      <div class="min-w-0 space-y-6">
        <article class="min-w-0 space-y-6">
          <header class="card-11 p-6">
            <h1 class="text-2xl font-bold leading-tight text-white sm:text-3xl"><%= pageTitle %></h1>
          </header>

          <% (sections || []).forEach(function (sec) { %>
          <section class="card-11 p-6"<% if (sec.events) { %> id="pomaha-events"<% } else if (sec.id) { %> id="<%= sec.id %>"<% } %>>
            <% if (sec.partner) { %>
            <div class="flex flex-col items-center gap-4 text-center sm:flex-row sm:text-left">
              <% if (sec.partner.logo) { %>
              <img
                src="<%= sec.partner.logo %>"
                alt="<%= sec.partner.name || 'Partner' %>"
                class="h-24 w-24 shrink-0 object-contain sm:h-28 sm:w-28"
                width="112"
                height="112"
                loading="lazy"
                decoding="async"
              />
              <% } %>
              <div class="min-w-0">
                <p class="text-lg font-semibold text-white sm:text-xl"><%= sec.partner.text || ('Jsme hrdým partnerem ' + (sec.partner.name || '')) %></p>
              </div>
            </div>
            <% } else { %>
            <% if (sec.heading) { %>
            <h2 class="text-lg font-bold text-11accent"><%= sec.heading %></h2>
            <% } %>
            <% if (sec.events) { %>
            <% if (sec.events.length) { %>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              <% sec.events.forEach(function (ev) { %>
              <article class="rounded-2xl border border-white/10 bg-black/10 p-4 transition hover:border-white/20">
                <div class="flex flex-wrap items-center gap-2 border-b border-white/10 pb-3">
                  <% if (ev.status) { %>
                  <% var statusNorm = String(ev.status || '').toLowerCase(); %>
                  <% var statusCls = 'border-11accent/40 bg-11accent/10 text-11accent'; %>
                  <% if (statusNorm.indexOf('byli') !== -1) statusCls = 'border-emerald-500/40 bg-emerald-500/10 text-emerald-200'; %>
                  <% if (statusNorm.indexOf('bud') !== -1) statusCls = 'border-sky-500/40 bg-sky-500/10 text-sky-200'; %>
                  <% if (statusNorm.indexOf('sponzor') !== -1) statusCls = 'border-amber-500/40 bg-amber-500/10 text-amber-200'; %>
                  <span class="rounded-full border px-2.5 py-1 text-xs font-semibold <%= statusCls %>"><%= ev.status %></span>
                  <% } %>
                  <% if (ev.date) { %>
                  <span class="rounded-full border border-white/15 bg-white/5 px-2.5 py-1 text-xs font-medium text-slate-300"><%= ev.date %></span>
                  <% } %>
                </div>
                <h3 class="mt-3 text-base font-semibold leading-snug text-white"><%= ev.title %></h3>
                <div class="mt-2 space-y-1.5">
                  <% if (ev.place) { %>
                  <p class="text-sm text-slate-300"><span class="text-11muted">Místo:</span> <%= ev.place %></p>
                  <% } %>
                  <% if (ev.note) { %>
                  <p class="text-sm leading-relaxed text-slate-300"><span class="text-11muted">Poznámka:</span> <%= ev.note %></p>
                  <% } %>
                </div>
                <% if (ev.link) { %>
                <p class="mt-4">
                  <a href="<%= ev.link %>" target="_blank" rel="noopener" class="inline-flex items-center gap-1 rounded-lg border border-11accent/40 bg-11accent/10 px-3 py-1.5 text-sm font-medium text-11accent transition hover:border-11accent/60 hover:bg-11accent/15">
                    Více informací
                    <span aria-hidden="true">↗</span>
                  </a>
                </p>
                <% } %>
              </article>
              <% }); %>
            </div>
            <% if (sec.pagination) { %>
            <nav class="mt-5 flex flex-wrap items-center justify-center gap-2" aria-label="Stránkování akcí">
              <% if (sec.pagination.prevUrl) { %>
              <a href="<%= sec.pagination.prevUrl %>#pomaha-events" rel="prev" class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-slate-200 hover:border-white/20 hover:bg-white/10">Předchozí</a>
              <% } else { %>
              <span class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-slate-200 opacity-50" aria-disabled="true">Předchozí</span>
              <% } %>
              <% sec.pagination.pages.forEach(function (p) { %>
              <% if (p.current) { %>
              <span class="min-w-[40px] rounded-lg bg-11accent px-3 py-2 text-center text-sm text-11bg" aria-current="page"><%= p.n %></span>
              <% } else { %>
              <a href="<%= p.url %>#pomaha-events" class="min-w-[40px] rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-center text-sm text-slate-200 hover:border-white/20 hover:bg-white/10"><%= p.n %></a>
              <% } %>
              <% }); %>
              <% if (sec.pagination.nextUrl) { %>
              <a href="<%= sec.pagination.nextUrl %>#pomaha-events" rel="next" class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-slate-200 hover:border-white/20 hover:bg-white/10">Další</a>
              <% } else { %>
              <span class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-slate-200 opacity-50" aria-disabled="true">Další</span>
              <% } %>
            </nav>
            <% } %>
            <% } else { %>
            <p class="mt-3 text-sm leading-relaxed text-slate-300 sm:text-base"><%= sec.emptyText || 'Zatím bez akcí.' %></p>
            <% } %>
            <% } %>
            <% (sec.paragraphs || []).forEach(function (p) { %>
            <p class="mt-3 text-sm leading-relaxed text-slate-300 sm:text-base"><%= p %></p>
            <% }); %>
            <% } %>
          </section>
          <% }); %>
        </article>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24">
        <%- include('partials/sidebar-ssp-ad') %>

        <%- include('partials/sidebar-live-matches') %>

        <%- include('partials/chance-liga-table', { standings: typeof chanceStandings !== 'undefined' ? chanceStandings : [], compactTable: true, tableRail: true, tableHref: '/zapasy/live#tabulka' }) %>

        <div class="card-11 p-4">
          <h2 class="mb-2 text-lg font-bold text-11accent">Newsletter</h2>
          <p class="text-sm text-11muted"><%= newsletter.description %></p>
          <% if (typeof newsletterStatus !== 'undefined' && newsletterStatus === 'ok') { %>
          <p class="mt-3 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-3 py-2 text-xs text-emerald-200">
            Jste přihlášeni k odběru novinek.
          </p>
          <% } else if (typeof newsletterStatus !== 'undefined' && newsletterStatus === 'dupe') { %>
          <p class="mt-3 rounded-lg border border-amber-500/40 bg-amber-500/10 px-3 py-2 text-xs text-amber-200">
            Tento e-mail už v odběru je.
          </p>
          <% } else if (typeof newsletterStatus !== 'undefined' && newsletterStatus === 'bad') { %>
          <p class="mt-3 rounded-lg border border-red-500/40 bg-red-500/10 px-3 py-2 text-xs text-red-200">
            Zadejte platný e-mail.
          </p>
          <% } %>
          <form class="mt-4 space-y-2" action="/newsletter" method="post">
            <label class="sr-only" for="newsletter-email">E-mail</label>
            <input
              id="newsletter-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="váš@email.cz"
              class="input-11 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2.5 text-sm text-white placeholder:text-11muted focus:border-11accent/50 focus:outline-none focus:ring-1 focus:ring-11accent/40"
            />
            <button type="submit" class="w-full rounded-xl bg-11accent py-2.5 text-sm font-semibold text-11bg transition hover:brightness-110">
              Přihlásit se
            </button>
          </form>
        </div>

        <%- include('partials/sidebar-social') %>
      </aside>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

