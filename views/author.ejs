<%- include('partials/header') %>

<main id="main-content" class="flex-1" tabindex="-1">
  <div class="mx-auto max-w-[1400px] px-4 py-6 lg:px-6 lg:py-8">
      <article class="min-w-0 space-y-6">
        <header class="author-profile-header card-11 p-6 sm:p-8">
          <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
            <img
              src="<%= author.avatar || '/logo.png' %>"
              alt="<%= author.name %>"
              class="author-profile-header__avatar h-20 w-20 shrink-0 rounded-full ring-2 ring-11accent/30 <%= author.avatar ? 'object-cover' : 'bg-11bg object-contain p-2' %>"
              width="80"
              height="80"
            />
            <div class="min-w-0 flex-1">
              <h1 class="text-2xl font-bold leading-tight text-white sm:text-3xl"><%= author.name %></h1>
              <p class="mt-2 text-sm text-11muted">
                <% if (author.articleCount === 1) { %>1 publikovaný článek<% } else if (author.articleCount >= 2 && author.articleCount <= 4) { %><%= author.articleCount %> publikované články<% } else { %><%= author.articleCount %> publikovaných článků<% } %>
              </p>
              <% if (author.bio) { %>
              <p class="author-bio-preview mt-4 text-sm leading-relaxed text-slate-200"><%= author.bio %></p>
              <% } %>
            </div>
          </div>
        </header>

        <% if (articles && articles.length) { %>
        <section class="space-y-4 perf-cv" aria-label="Články autora">
          <% articles.forEach(function (a) { %>
          <article class="card-11 overflow-hidden p-0 transition hover:border-11accent/25">
            <a href="/clanek/<%= encodeURIComponent(a.slug) %>" class="block">
              <div class="flex flex-col gap-4 p-5 sm:flex-row">
                <img
                  src="<%= a.hero_image_path || 'https://images.unsplash.com/photo-1574629810360-7efbbe195018?w=600&q=80' %>"
                  alt="<%= a.title %>"
                  loading="lazy"
                  fetchpriority="low"
                  decoding="async"
                  class="h-40 w-full rounded-xl object-cover ring-1 ring-white/10 sm:h-24 sm:w-40"
                  style="object-position: <%= a.hero_card_position || a.hero_position || '50% 50%' %>;"
                />
                <div class="min-w-0">
                  <h2 class="text-lg font-bold leading-snug text-white hover:text-11accent"><%= a.title %></h2>
                  <% if (a.excerpt) { %>
                  <p class="mt-2 line-clamp-2 text-sm text-11muted"><%= a.excerpt %></p>
                  <% } %>
                  <time class="mt-3 block text-xs text-slate-500" datetime="<%= a.published_at || a.created_at || '' %>"><%= relativeTime(a.published_at || a.created_at) %></time>
                </div>
              </div>
            </a>
          </article>
          <% }); %>
        </section>

        <% if (pagination) { %>
        <nav class="mt-6 flex flex-wrap items-center justify-center gap-2" aria-label="Stránkování">
          <% if (pagination.prevUrl) { %>
          <a href="<%= pagination.prevUrl %>" rel="prev" class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-slate-200 hover:border-white/20 hover:bg-white/10">Předchozí</a>
          <% } else { %>
          <span class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-slate-200 opacity-50" aria-disabled="true">Předchozí</span>
          <% } %>
          <% pagination.pages.forEach(function (p) { %>
          <% if (p.current) { %>
          <span class="min-w-[40px] rounded-lg bg-11accent px-3 py-2 text-center text-sm text-11bg transition" aria-current="page"><%= p.n %></span>
          <% } else { %>
          <a href="<%= p.url %>" class="min-w-[40px] rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-center text-sm text-slate-200 transition hover:border-white/20 hover:bg-white/10"><%= p.n %></a>
          <% } %>
          <% }); %>
          <% if (pagination.nextUrl) { %>
          <a href="<%= pagination.nextUrl %>" rel="next" class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-slate-200 hover:border-white/20 hover:bg-white/10">Další</a>
          <% } else { %>
          <span class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-slate-200 opacity-50" aria-disabled="true">Další</span>
          <% } %>
        </nav>
        <% } %>

        <% } else { %>
        <section class="card-11 p-6 text-center">
          <p class="text-sm font-medium text-slate-200">Tento autor zatím nemá žádné publikované články.</p>
        </section>
        <% } %>
      </article>
  </div>
</main>

<%- include('partials/footer') %>
