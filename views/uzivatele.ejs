<%- include('partials/header') %>

<main id="main-content" class="flex-1" tabindex="-1">
  <div class="mx-auto max-w-3xl px-4 py-8 lg:px-6 lg:py-10">
    <header class="mb-6">
      <h1 class="font-display text-2xl font-bold text-white sm:text-3xl">Uživatelé</h1>
      <p class="mt-2 text-sm text-11muted">Nejnovější veřejné profily na 11ce.</p>
    </header>
    <% if (profiles && profiles.length) { %>
    <ul class="space-y-3">
      <% profiles.forEach(function (item) { %>
      <li>
        <a href="<%= item.href %>" class="card-11 flex items-center gap-3 p-4 transition hover:border-11accent/30">
          <% if (item.avatar_path) { %>
          <img src="<%= item.avatar_path %>" alt="" class="h-12 w-12 rounded-full object-cover ring-1 ring-white/10" width="48" height="48" />
          <% } else { %>
          <img src="/logo.png" alt="" class="h-12 w-12 rounded-full bg-11bg object-contain p-1.5 ring-1 ring-white/10" width="48" height="48" />
          <% } %>
          <span class="min-w-0 flex-1">
            <span class="block truncate font-semibold text-white"><%= item.display_name %></span>
            <% if (item.favoriteTeam) { %>
            <span class="mt-0.5 flex items-center gap-1.5 text-xs text-11muted">
              <img src="<%= item.favoriteTeam.logo %>" alt="" class="h-4 w-4 object-contain" width="16" height="16" />
              <%= item.favoriteTeam.name %>
            </span>
            <% } %>
          </span>
        </a>
      </li>
      <% }); %>
    </ul>
    <% } else { %>
    <div class="card-11 p-6 text-center text-sm text-11muted">Zatím tu nikdo není. <a href="/registrace" class="text-11accent hover:underline">Registrovat se</a></div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
