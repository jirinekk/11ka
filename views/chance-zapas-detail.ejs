<%- include('partials/header') %>
<%
  var m = typeof match !== 'undefined' && match ? match : {};
  var homeLineup = m.lineups && m.lineups.home;
  var awayLineup = m.lineups && m.lineups.away;
  var hasStarters = (homeLineup && homeLineup.starters && homeLineup.starters.length) || (awayLineup && awayLineup.starters && awayLineup.starters.length);
  var hasCoaches = (homeLineup && homeLineup.coach) || (awayLineup && awayLineup.coach);
  var hasScorers = (m.scorers && m.scorers.home && m.scorers.home.length) || (m.scorers && m.scorers.away && m.scorers.away.length);
  var hasStats = m.stats && m.stats.some(function (s) {
    return String(s.home || '') !== '' && !/^0+(\.0+)?%?$/.test(String(s.home).replace(/\s/g,''));
  });
  var events = (m.events || []).filter(function (e) {
    return e.kind === 'goal' || e.kind === 'own' || e.kind === 'yellow' || e.kind === 'red' || e.kind === 'sub' || e.kind === 'var';
  });
  function eventPeriodKey(e) {
    var p = String(e.period || '').toLowerCase();
    if (/prodl|et\b/.test(p)) return 'et';
    if (/penalt/.test(p) && !/g[oó]l/.test(p)) return 'pen';
    if (/2/.test(p) && /polo/.test(p)) return '2';
    if (/1/.test(p) && /polo/.test(p)) return '1';
    var min = parseInt(String(e.minute || ''), 10);
    if (Number.isFinite(min) && min > 45) return '2';
    return '1';
  }
  var periodLabels = { '1': '1. poločas', '2': '2. poločas', et: 'Prodloužení', pen: 'Penalty' };
  var periodGroups = [];
  var periodMap = {};
  events.forEach(function (e) {
    var key = eventPeriodKey(e);
    if (!periodMap[key]) {
      periodMap[key] = { key: key, label: periodLabels[key] || e.period || 'Poločas', events: [], score: '' };
      periodGroups.push(periodMap[key]);
    }
    periodMap[key].events.push(e);
    if (e.score) periodMap[key].score = String(e.score).replace(':', ' - ');
  });
  function fmtMin(raw) {
    var min = raw || '';
    if (min && !/['′’]$/.test(String(min))) min += "'";
    return min;
  }
  function kickoffLabel(iso) {
    if (!iso) return '';
    try {
      return new Date(iso).toLocaleString('cs-CZ', { weekday: 'short', day: 'numeric', month: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Prague' });
    } catch (_) { return ''; }
  }
  function statNum(v) {
    var n = parseFloat(String(v || '').replace('%', '').replace(',', '.').replace(/\s/g, ''));
    return Number.isFinite(n) ? n : 0;
  }
  function isPct(v) { return /%/.test(String(v || '')); }
  var scoreLine = m.scoreLine || String(m.score || '0:0').replace(':', ' - ');
  var isChanceLiga = /chance liga/i.test(String(m.league || '')) && !/narodni/i.test(String(m.league || ''));
  var isEurope = /liga mistr|evropsk|konferenc/i.test(String(m.league || ''));
  var europeStandings = m.standings && m.standings.length ? m.standings : [];
  var hasEuropeTable = isEurope && europeStandings.length;
  var tabs = [
    { id: 'prehled', label: 'Přehled' },
    { id: 'sestavy', label: 'Sestavy' },
    (isChanceLiga || hasEuropeTable) ? { id: 'tabulka', label: 'Tabulka' } : null,
    { id: 'statistiky', label: 'Statistiky' },
  ].filter(Boolean);
%>

<main id="main-content" class="flex-1" tabindex="-1">
  <div class="mc-page mx-auto max-w-[1400px] px-4 py-6 lg:px-6 lg:py-8">
    <div class="mc-layout">
      <div class="mc-layout__main min-w-0" data-mc-hub data-mc-hash>
        <section class="mc-hero">
          <div class="mc-hero__top">
            <a href="/zapasy/live" class="mc-hero__back">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Zápasy
            </a>
            <p class="mc-hero__comp"><%= m.league || 'Zápas' %><% if (m.stage) { %> · <%= m.stage %><% } %><% if (m.round) { %> · <%= m.round %><% } %></p>
            <span class="mc-hero__spacer" aria-hidden="true"></span>
          </div>
          <p class="mc-hero__meta">
            <%= kickoffLabel(m.kickoff || m.date) %>
            <% if (m.venue) { %> · <%= m.venue %><% if (m.city) { %>, <%= m.city %><% } %><% } %>
          </p>

          <div class="mc-hero__duel">
            <% var homeTag = m.homeHref ? 'a' : 'div'; %>
            <<%= homeTag %><% if (m.homeHref) { %> href="<%= m.homeHref %>"<% } %> class="mc-hero__club mc-hero__club--home">
              <span class="mc-hero__name"><%= m.home %></span>
              <% if (m.homeLogo) { %>
              <img class="mc-hero__crest" src="<%= m.homeLogo %>" alt="" referrerpolicy="no-referrer" data-ini="<%= (m.homeInitials || m.home || '?').slice(0,2) %>" onerror="this.classList.add('is-hidden'); if(this.nextElementSibling) this.nextElementSibling.hidden=false;" />
              <span class="mc-hero__crest-ph" hidden><%= (m.homeInitials || m.home || '?').slice(0,2) %></span>
              <% } else { %>
              <span class="mc-hero__crest-ph"><%= (m.homeInitials || m.home || '?').slice(0,2) %></span>
              <% } %>
            </<%= homeTag %>>
            <div class="mc-hero__mid">
              <p class="mc-hero__score"><%= scoreLine %></p>
              <p class="mc-hero__status<%= m.isLive ? ' is-live' : '' %>"><%= m.statusLabel || '' %></p>
            </div>
            <% var awayTag = m.awayHref ? 'a' : 'div'; %>
            <<%= awayTag %><% if (m.awayHref) { %> href="<%= m.awayHref %>"<% } %> class="mc-hero__club mc-hero__club--away">
              <% if (m.awayLogo) { %>
              <img class="mc-hero__crest" src="<%= m.awayLogo %>" alt="" referrerpolicy="no-referrer" data-ini="<%= (m.awayInitials || m.away || '?').slice(0,2) %>" onerror="this.classList.add('is-hidden'); if(this.nextElementSibling) this.nextElementSibling.hidden=false;" />
              <span class="mc-hero__crest-ph" hidden><%= (m.awayInitials || m.away || '?').slice(0,2) %></span>
              <% } else { %>
              <span class="mc-hero__crest-ph"><%= (m.awayInitials || m.away || '?').slice(0,2) %></span>
              <% } %>
              <span class="mc-hero__name"><%= m.away %></span>
            </<%= awayTag %>>
          </div>

          <% if (hasScorers) { %>
          <div class="mc-hero__goals">
            <div class="mc-hero__goals-side">
              <% (m.scorers.home || []).forEach(function (g) { %>
              <p>
                <%- include('partials/mc-ico', { kind: /vl\.g/i.test(g.player) ? 'own' : 'goal' }) %>
                <span><%= g.player %></span>
                <time><%= g.minute %><%= /['′’]$/.test(String(g.minute || '')) ? '' : "'" %></time>
              </p>
              <% }); %>
            </div>
            <div class="mc-hero__goals-side mc-hero__goals-side--away">
              <% (m.scorers.away || []).forEach(function (g) { %>
              <p>
                <time><%= g.minute %><%= /['′’]$/.test(String(g.minute || '')) ? '' : "'" %></time>
                <span><%= g.player %></span>
                <%- include('partials/mc-ico', { kind: /vl\.g/i.test(g.player) ? 'own' : 'goal' }) %>
              </p>
              <% }); %>
            </div>
          </div>
          <% } %>

          <div class="mc-tabs" role="tablist" aria-label="Přehled zápasu">
            <% tabs.forEach(function (tab, i) { %>
            <button
              type="button"
              class="mc-tabs__tab<%= i === 0 ? ' is-active' : '' %>"
              role="tab"
              aria-selected="<%= i === 0 ? 'true' : 'false' %>"
              data-cl-tab="<%= tab.id %>"
            ><%= tab.label %></button>
            <% }); %>
          </div>
        </section>

        <div class="mc-tabs__pane is-active mt-4" data-cl-pane="prehled" role="tabpanel">
          <% if (typeof matchArticles !== 'undefined' && matchArticles && matchArticles.length) { %>
          <section class="mc-reports" aria-labelledby="match-report-heading">
            <h2 id="match-report-heading" class="mc-facts__title"><%= matchArticles.length === 1 ? 'Report' : 'Reporty' %></h2>
            <div class="mc-reports__list">
              <% matchArticles.forEach(function (item, idx) { %>
              <a href="<%= item.href %>" class="mc-report<%= idx === 0 ? ' is-featured' : '' %>">
                <% if (item.image) { %>
                <img src="<%= item.image %>" alt="" loading="lazy" decoding="async" style="object-position: <%= item.heroPosition || '50% 50%' %>;" />
                <% } %>
                <div class="mc-report__body">
                  <span class="mc-report__cat"><%= item.tag || item.category || 'Report' %></span>
                  <h3 class="mc-report__title font-article-title"><%= item.title %></h3>
                  <% if (item.excerpt) { %>
                  <p class="mc-report__excerpt"><%= item.excerpt %></p>
                  <% } %>
                </div>
              </a>
              <% }); %>
            </div>
          </section>
          <% } %>

          <% if (hasStats) { %>
          <section class="mc-facts">
            <h2 class="mc-facts__title">Top statistiky</h2>
            <ul class="mc-facts__stats">
              <% m.stats.slice(0, 6).forEach(function (s) { %>
              <% var hv = statNum(s.home); var av = statNum(s.away); var pct = isPct(s.home) || isPct(s.away) || /držen|possession|míče/i.test(s.label); %>
              <% var sum = hv + av; var hw = pct ? hv : (sum ? (hv / sum) * 100 : 50); var aw = pct ? av : (sum ? (av / sum) * 100 : 50); %>
              <li class="<%= pct ? 'is-bar' : 'is-num' %>">
                <div class="mc-facts__row">
                  <span class="<%= hv >= av ? 'is-lead' : '' %>"><%= s.home %></span>
                  <span class="mc-facts__label"><%= s.label %></span>
                  <span class="<%= av > hv ? 'is-lead' : '' %>"><%= s.away %></span>
                </div>
                <div class="mc-facts__bar" aria-hidden="true"><i style="width: <%= Math.max(0, Math.min(100, hw)) %>%"></i><b style="width: <%= Math.max(0, Math.min(100, aw)) %>%"></b></div>
              </li>
              <% }); %>
            </ul>
          </section>
          <% } %>

          <% if (periodGroups.length) { %>
          <section class="mc-facts mc-facts--events mt-4">
            <h2 class="mc-facts__title">Události</h2>
            <% periodGroups.forEach(function (group) { %>
            <div class="mc-ev-half">
              <div class="mc-ev-half__head">
                <h3><%= group.label %></h3>
                <% if (group.score) { %><span><%= group.score %></span><% } %>
              </div>
              <ol class="mc-ev">
                <% group.events.forEach(function (e) { %>
                <% var min = fmtMin(e.minute); %>
                <% var who = e.kind === 'sub' ? (e.playerIn || e.player) : e.player; %>
                <% var extra = e.kind === 'sub' ? (e.playerOut || '') : (e.assist ? '(' + e.assist + ')' : (e.kind === 'own' ? '(vl.g.)' : (e.reason ? '(' + e.reason + ')' : ''))); %>
                <% var isGoal = e.kind === 'goal' || e.kind === 'own'; %>
                <li class="mc-ev__row<%= isGoal ? ' is-goal' : '' %>">
                  <div class="mc-ev__side is-home">
                    <% if (e.side === 'home') { %>
                    <span class="mc-ev__min"><%= min %></span>
                    <span class="mc-ev__icons"><%- include('partials/mc-ico', { kind: e.kind === 'sub' ? 'swap' : e.kind }) %></span>
                    <span class="mc-ev__copy">
                      <% if (isGoal && e.score) { %><b class="mc-ev__score"><%= String(e.score).replace(':', '-') %></b><% } %>
                      <% if (e.penalty) { %><em class="mc-ev__tag">Penalta</em><% } %>
                      <span class="mc-ev__who"><%= who %></span>
                      <% if (extra) { %><span class="mc-ev__assist"><%= extra %></span><% } %>
                    </span>
                    <% } %>
                  </div>
                  <div class="mc-ev__side is-away">
                    <% if (e.side === 'away') { %>
                    <span class="mc-ev__copy">
                      <% if (e.penalty) { %><em class="mc-ev__tag">Penalta</em><% } %>
                      <span class="mc-ev__who"><%= who %></span>
                      <% if (extra) { %><span class="mc-ev__assist"><%= extra %></span><% } %>
                      <% if (isGoal && e.score) { %><b class="mc-ev__score"><%= String(e.score).replace(':', '-') %></b><% } %>
                    </span>
                    <span class="mc-ev__icons"><%- include('partials/mc-ico', { kind: e.kind === 'sub' ? 'swap' : e.kind }) %></span>
                    <span class="mc-ev__min"><%= min %></span>
                    <% } %>
                  </div>
                </li>
                <% }); %>
              </ol>
            </div>
            <% }); %>
          </section>
          <% } %>

        </div>

        <div class="mc-tabs__pane mt-4" data-cl-pane="sestavy" role="tabpanel" hidden>
          <% if (hasStarters || hasCoaches) { %>
          <%- include('partials/mc-lineup-board', { homeLineup: homeLineup, awayLineup: awayLineup, homeLogo: m.homeLogo, awayLogo: m.awayLogo }) %>
          <% } else { %>
          <section class="mc-facts">
            <h2 class="mc-facts__title">Sestavy</h2>
            <p class="mc-empty">Sestavy zatím nejsou k dispozici.</p>
          </section>
          <% } %>
        </div>

        <% if (isChanceLiga) { %>
        <div class="mc-tabs__pane mt-4" data-cl-pane="tabulka" role="tabpanel" hidden>
          <%- include('partials/chance-liga-table', {
            standings: typeof chanceStandings !== 'undefined' ? chanceStandings : [],
            highlightCodes: [m.homeCode, m.awayCode].filter(Boolean)
          }) %>
        </div>
        <% } else if (hasEuropeTable) { %>
        <div class="mc-tabs__pane mt-4" data-cl-pane="tabulka" role="tabpanel" hidden>
          <%- include('partials/chance-liga-table', {
            standings: europeStandings,
            tableTitle: 'Tabulka · ' + (m.league || 'Evropa'),
            highlightCodes: [m.homeTeamId, m.awayTeamId, m.homeCode, m.awayCode].filter(Boolean),
            chanceTableZoneClass: function (rank) {
              var r = Number(rank);
              if (r <= 8) return 'is-cl';
              if (r <= 24) return 'is-el';
              return 'is-down';
            },
            chanceTableLegend: [
              { className: 'is-cl', label: 'Přímo osmifinále', shortLabel: 'Osmifinále' },
              { className: 'is-el', label: 'Play-off', shortLabel: 'Play-off' },
              { className: 'is-down', label: 'Konec základní fáze', shortLabel: 'Konec' }
            ]
          }) %>
        </div>
        <% } %>

        <div class="mc-tabs__pane mt-4" data-cl-pane="statistiky" role="tabpanel" hidden>
          <% if (hasStats) { %>
          <section class="mc-facts">
            <h2 class="mc-facts__title">Statistiky</h2>
            <ul class="mc-facts__stats">
              <% m.stats.forEach(function (s) { %>
              <% var hv = statNum(s.home); var av = statNum(s.away); var pct = isPct(s.home) || isPct(s.away); %>
              <li class="<%= pct ? 'is-bar' : 'is-num' %>">
                <div class="mc-facts__row">
                  <span class="<%= hv >= av ? 'is-lead' : '' %>"><%= s.home %></span>
                  <span class="mc-facts__label"><%= s.label %></span>
                  <span class="<%= av > hv ? 'is-lead' : '' %>"><%= s.away %></span>
                </div>
                <% var sum = hv + av; var hw = pct ? hv : (sum ? (hv / sum) * 100 : 50); var aw = pct ? av : (sum ? (av / sum) * 100 : 50); %>
                <div class="mc-facts__bar" aria-hidden="true"><i style="width: <%= Math.max(0, Math.min(100, hw)) %>%"></i><b style="width: <%= Math.max(0, Math.min(100, aw)) %>%"></b></div>
              </li>
              <% }); %>
            </ul>
          </section>
          <% } else { %>
          <p class="mc-empty">Statistiky se objeví po začátku zápasu.</p>
          <% } %>
        </div>
      </div>

      <aside class="mc-layout__rail">
        <% if (m.venue || m.city || m.attendance || m.referee) { %>
        <section class="mc-side">
          <h2 class="mc-side__title">Zápas</h2>
          <% if (m.venue || m.city) { %>
          <p class="mc-side__name"><%= m.venue || 'Stadion' %></p>
          <% if (m.city) { %><p class="mc-side__muted"><%= m.city %></p><% } %>
          <% } %>
          <% if (m.attendance) { %><p class="mc-side__muted">Návštěva <%= m.attendance %></p><% } %>
          <% if (m.referee) { %><p class="mc-side__muted">Rozhodčí <%= m.referee %></p><% } %>
        </section>
        <% } %>
        <% if (typeof roundMates !== 'undefined' && roundMates && roundMates.length) { %>
        <section class="mc-side">
          <h2 class="mc-side__title"><%= m.round || 'Kolo' %></h2>
          <div class="mc-side__round">
            <% roundMates.forEach(function (row) { %>
            <%- include('partials/fotmob-match-row', { match: row }) %>
            <% }); %>
          </div>
        </section>
        <% } %>
      </aside>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
