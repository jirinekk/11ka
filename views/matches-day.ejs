<%- include('partials/header') %>

<main id="main-content" class="flex-1" tabindex="-1">
  <div class="mx-auto max-w-[1400px] px-4 py-6 lg:px-6 lg:py-8">
    <div class="site-shell">
      <div class="site-shell__main min-w-0 space-y-6">
        <header>
          <h1 class="text-2xl font-bold leading-tight text-white sm:text-3xl">Zápasy dne</h1>
          <p class="mt-2 text-sm text-11muted">Nadcházející, aktuální i dohrané zápasy dne.</p>
        </header>

        <section class="card-11 p-4 sm:p-5">
          <% var list = matches; %>
          <% if (list && list.length) { %>
          <ul class="divide-y divide-white/5">
            <% list.forEach(function (m) { %>
            <li class="flex flex-wrap items-center justify-between gap-3 py-3">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2 text-sm font-semibold text-slate-200">
                  <% if (m.id) { %>
                    <a href="/zive-skore/<%= encodeURIComponent(m.id) %>" class="hover:text-white">
                      <%= m.home %> - <%= m.away %>
                    </a>
                  <% } else { %>
                    <span><%= m.home %> - <%= m.away %></span>
                  <% } %>
                </div>
                <% if (m.date) { %>
                  <p class="mt-1 text-xs text-slate-400">
                    <%= new Date(m.date).toLocaleString('cs-CZ', { dateStyle: 'medium', timeStyle: 'short' }) %>
                  </p>
                <% } %>
              </div>

              <div class="flex items-center gap-3">
                <span class="text-sm font-semibold text-11accent"><%= m.score %></span>
                <span class="live-pill"><%= m.status || '-' %></span>
              </div>
            </li>
            <% }); %>
          </ul>
          <% } else { %>
          <div class="text-center">
            <p class="text-sm font-medium text-slate-200">Pro dnešní den nejsou dostupné žádné zápasy.</p>
          </div>
          <% } %>
        </section>
      </div>

      <aside class="site-shell__rail space-y-6">
        <%- include('partials/sidebar-ssp-ad') %>
      </aside>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

<script>
  (function () {
    const REFRESH_MS = 30000;

    function pragueDayKey() {
      try {
        return new Intl.DateTimeFormat('en-CA', {
          timeZone: 'Europe/Prague',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
        }).format(new Date());
      } catch {
        return new Date().toISOString().slice(0, 10);
      }
    }

    function shouldSkipRefresh() {
      if (document.hidden) return true;
      const el = document.activeElement;
      if (!el) return false;
      const tag = (el.tagName || '').toLowerCase();
      return tag === 'input' || tag === 'textarea' || tag === 'select';
    }

    const initialDayKey = pragueDayKey();

    function reloadIfDayChanged() {
      const nowKey = pragueDayKey();
      if (nowKey !== initialDayKey) {
        window.location.reload();
        return true;
      }
      return false;
    }

    setInterval(function () {
      if (reloadIfDayChanged()) return;
      if (shouldSkipRefresh()) return;
      window.location.reload();
    }, REFRESH_MS);

    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) reloadIfDayChanged();
    });
  })();
</script>

