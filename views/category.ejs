<%- include('partials/header') %>

<main id="main-content" class="flex-1" tabindex="-1">
  <div class="mx-auto max-w-7xl px-4 py-6 lg:px-6 lg:py-8">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-start">
      <div class="min-w-0 space-y-6">
        <header>
          <h1 class="font-display text-2xl font-bold leading-tight text-white sm:text-3xl">
            <%= pageTitle %>
          </h1>
          <% if (pageSubtitle && pageSubtitle !== 'Seřazeno od nejnovějších.') { %>
          <p class="mt-2 text-sm text-11muted"><%= pageSubtitle %></p>
          <% } %>
          <% var _tagPillsMode = (typeof tagPillsMode !== 'undefined' && tagPillsMode) ? tagPillsMode : 'full'; %>
          <% var _showTagBar = _tagPillsMode !== 'none' && (_tagPillsMode === 'all-only' || (tagOptions && tagOptions.length)); %>
          <% if (_showTagBar) { %>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            <a
              href="<%= (typeof requestPath !== 'undefined' && requestPath) ? requestPath : '' %>"
              class="tag-pill<%= !tag ? ' tag-pill--active' : '' %>"
            >Vše</a>
            <% if (_tagPillsMode !== 'all-only') { %>
            <% (tagOptions || []).forEach(function (t) { %>
            <a
              href="<%= ((typeof requestPath !== 'undefined' && requestPath) ? requestPath : '') + '?tag=' + encodeURIComponent(t) %>"
              class="tag-pill<%= tag === t ? ' tag-pill--active' : '' %>"
            ><%= t %></a>
            <% }); %>
            <% } %>
          </div>
          <% } %>
        </header>

        <% if (typeof heroSlides !== 'undefined' && heroSlides && heroSlides.length) { %>
        <section aria-labelledby="category-most-read-heading">
          <h2 id="category-most-read-heading" class="font-display mb-4 text-xl font-bold text-11accent sm:text-2xl">Nejčtenější články</h2>
          <article class="card-11 overflow-hidden p-0">
            <%- include('partials/hero-slider', { slides: heroSlides, ariaLabel: 'Nejčtenější články' }) %>
          </article>
        </section>
        <% } %>

        <%- include('partials/article-mobile-ad', { domId: 'ssp-zone-411438-category', marginClass: 'mt-0' }) %>

        <section class="perf-cv">
          <% if (articles && articles.length) { %>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            <% articles.forEach(function (item) { %>
            <article class="card-11 flex flex-col overflow-hidden p-0 transition hover:border-white/15">
              <a href="<%= item.href %>" class="block overflow-hidden">
                <img
                  src="<%= item.image %>"
                  alt="<%= item.title %>"
                  loading="lazy"
                  fetchpriority="low"
                  decoding="async"
                  class="aspect-video w-full object-cover transition duration-300 hover:scale-[1.03]"
                  style="object-position: <%= item.heroPosition || '50% 50%' %>;"
                />
              </a>
              <div class="flex flex-1 flex-col p-4">
                <h3 class="text-base font-semibold leading-snug text-white">
                  <a href="<%= item.href %>" class="hover:text-11accent"><%= item.title %></a>
                </h3>
                <p class="mt-2 line-clamp-3 flex-1 text-sm text-11muted"><%= item.excerpt %></p>
                <time class="mt-3 text-xs text-slate-500" datetime="<%= item.isoTime || '' %>"><%= item.timeAgo %></time>
              </div>
            </article>
            <% }); %>
          </div>

          <% if (typeof pagination !== 'undefined' && pagination && pagination.totalPages && pagination.totalPages > 1) { %>
          <nav class="mt-8 flex flex-wrap items-center justify-center gap-2" aria-label="Stránkování">
            <% if (pagination.hasPrev) { %>
            <a
              href="<%= pagination.prevUrl %>"
              class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-slate-200 transition hover:border-white/20 hover:bg-white/10"
              rel="prev"
            >Předchozí</a>
            <% } else { %>
            <span
              class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-slate-200 opacity-50"
              aria-disabled="true"
            >Předchozí</span>
            <% } %>

            <div class="flex flex-wrap items-center justify-center gap-1">
              <% pagination.pages.forEach(function (p) { %>
                <% if (p.current) { %>
                <span
                  class="min-w-[40px] rounded-lg bg-11accent px-3 py-2 text-center text-sm text-11bg transition"
                  aria-current="page"
                ><%= p.n %></span>
                <% } else { %>
                <a
                  href="<%= p.url %>"
                  class="min-w-[40px] rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-center text-sm text-slate-200 transition hover:border-white/20 hover:bg-white/10"
                ><%= p.n %></a>
                <% } %>
              <% }); %>
            </div>

            <% if (pagination.hasNext) { %>
            <a
              href="<%= pagination.nextUrl %>"
              class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-slate-200 transition hover:border-white/20 hover:bg-white/10"
              rel="next"
            >Další</a>
            <% } else { %>
            <span
              class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-slate-200 opacity-50"
              aria-disabled="true"
            >Další</span>
            <% } %>
          </nav>
          <% } %>
          <% } else if (!(typeof heroSlides !== 'undefined' && heroSlides && heroSlides.length)) { %>
          <div class="card-11 p-6 text-center">
            <p class="text-sm font-medium text-slate-200"><%= (typeof emptyTitle !== 'undefined' && emptyTitle) ? emptyTitle : 'V této rubrice zatím nejsou žádné články.' %></p>
            <p class="mt-1 text-xs text-11muted"><%= (typeof emptySubtitle !== 'undefined' && emptySubtitle) ? emptySubtitle : 'Zkuste se podívat později.' %></p>
          </div>
          <% } %>
        </section>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24">
        <div class="card-11 p-4 perf-cv home-side-ad-card">
          <p class="mb-2 text-center text-xs font-medium uppercase tracking-wide text-11muted">Reklama</p>
          <div
            id="ssp-zone-411438"
            class="home-side-ad-wrap mx-auto h-[600px] w-[300px] overflow-hidden"
            data-ssp-zone="411438"
            data-ssp-width="300"
            data-ssp-height="600"
          ></div>
        </div>

        <%- include('partials/sidebar-live-matches') %>

        <div class="card-11 p-4">
          <h2 class="mb-2 text-lg font-bold text-11accent">Newsletter</h2>
          <p class="text-sm text-11muted"><%= newsletter.description %></p>
          <% if (typeof newsletterStatus !== 'undefined' && newsletterStatus === 'ok') { %>
          <p class="mt-3 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-3 py-2 text-xs text-emerald-200">
            Jste přihlášeni k odběru novinek.
          </p>
          <% } else if (typeof newsletterStatus !== 'undefined' && newsletterStatus === 'dupe') { %>
          <p class="mt-3 rounded-lg border border-amber-500/40 bg-amber-500/10 px-3 py-2 text-xs text-amber-200">
            Tento e-mail už v odběru je.
          </p>
          <% } else if (typeof newsletterStatus !== 'undefined' && newsletterStatus === 'bad') { %>
          <p class="mt-3 rounded-lg border border-red-500/40 bg-red-500/10 px-3 py-2 text-xs text-red-200">
            Zadejte platný e-mail.
          </p>
          <% } %>
          <form class="mt-4 space-y-2" action="/newsletter" method="post">
            <label class="sr-only" for="newsletter-email">E-mail</label>
            <input
              id="newsletter-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="váš@email.cz"
              class="input-11 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2.5 text-sm text-white placeholder:text-11muted focus:border-11accent/50 focus:outline-none focus:ring-1 focus:ring-11accent/40"
            />
            <button type="submit" class="btn-11 btn-11--primary btn-11--block">
              Přihlásit se
            </button>
          </form>
        </div>

        <%- include('partials/sidebar-social') %>
      </aside>
    </div>
  </div>
</main>

<% if (typeof heroSlides !== 'undefined' && heroSlides && heroSlides.length) { %>
<script src="/js/hero-slider.js?v=<%= encodeURIComponent(typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" defer></script>
<% } %>

<%- include('partials/footer') %>

