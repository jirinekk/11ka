<% var sectionTitle = typeof title !== 'undefined' ? title : ''; %>
<% var sectionHref = typeof href !== 'undefined' ? href : '#'; %>
<% var sectionArticles = typeof articles !== 'undefined' && articles ? articles : []; %>
<% var sectionId = (sectionHref || 'section').replace(/^\//, '').replace(/[^a-z0-9-]+/gi, '-') || 'section'; %>
<% var isFirstSection = typeof sectionIndex !== 'undefined' && sectionIndex === 0; %>
<section class="home-category-section" aria-labelledby="home-section-<%= sectionId %>">
  <div class="home-section-head">
    <h2 id="home-section-<%= sectionId %>" class="font-display text-xl font-bold text-white sm:text-2xl"><%= sectionTitle %></h2>
    <a href="<%= sectionHref %>" class="btn-11 btn-11--sm btn-11--accent-outline shrink-0">Ukázat vše</a>
  </div>
  <% if (sectionArticles.length) { %>
  <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <% sectionArticles.forEach(function (item, idx) { %>
    <article class="card-11 home-category-card flex flex-col overflow-hidden p-0 transition hover:border-white/15">
      <a href="<%= item.href %>" class="block overflow-hidden">
        <img
          src="<%= item.image %>"
          alt="<%= item.title %>"
          loading="<%= isFirstSection && idx === 0 ? 'eager' : 'lazy' %>"
          fetchpriority="<%= isFirstSection && idx === 0 ? 'high' : 'low' %>"
          decoding="<%= isFirstSection && idx === 0 ? 'sync' : 'async' %>"
          class="aspect-video w-full object-cover transition duration-300 hover:scale-[1.03]"
          data-object-position="<%= item.heroPosition || '50% 50%' %>"
        />
      </a>
      <div class="flex flex-1 flex-col p-4">
        <% if (item.tag) { %>
        <div class="home-category-card__tag">
          <a href="/stitky/<%= encodeURIComponent(item.tag) %>" class="tag-pill tag-pill--sm"><%= item.tag %></a>
        </div>
        <% } %>
        <h3 class="home-category-card__title text-base font-semibold leading-snug text-white">
          <a href="<%= item.href %>" class="hover:text-11accent"><%= item.title %></a>
        </h3>
        <p class="home-category-card__excerpt mt-2 line-clamp-2 flex-1 text-sm text-11muted"><%= item.excerpt %></p>
        <time class="mt-3 text-xs text-slate-500" datetime="<%= item.isoTime || '' %>"><%= item.timeAgo %></time>
      </div>
    </article>
    <% }); %>
  </div>
  <% } %>
  <% if (typeof showSectionAd !== 'undefined' && showSectionAd) { %>
  <%- include('article-mobile-ad', { domId: 'ssp-zone-414237-section-' + sectionId, zoneId: 414237, marginClass: 'mt-6' }) %>
  <% } %>
</section>
