<% var _teams = (typeof teamOptions !== 'undefined' && teamOptions) ? teamOptions : []; %>
<% var _kickoff = (typeof kickoffInputValue !== 'undefined' && kickoffInputValue) ? kickoffInputValue : ''; %>
<% function teamSelectHtml(fieldName, selectedValue) {
  var val = selectedValue || '';
  var opts = _teams.slice();
  if (val && opts.indexOf(val) === -1) opts.unshift(val);
  if (!opts.length) {
    return '<input name="' + fieldName + '" required value="' + (val.replace(/"/g, '&quot;')) + '" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />';
  }
  var html = '<select name="' + fieldName + '" required class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white">';
  html += '<option value="">- vyberte tým -</option>';
  opts.forEach(function (name) {
    html += '<option value="' + String(name).replace(/"/g, '&quot;') + '"' + (val === name ? ' selected' : '') + '>' + name + '</option>';
  });
  html += '</select>';
  return html;
} %>
<section class="card-11 mt-8 p-6">
  <h2 class="text-lg font-semibold text-white"><%= editingItem ? 'Spravovat zápas' : 'Vytvořit zápas' %></h2>
  <% if (!_teams.length && !editingItem) { %>
  <p class="mt-2 text-sm text-amber-200">Nejdřív vytvořte týmy v sekci Vytvořit tým, nebo zadejte názvy ručně.</p>
  <% } %>
  <form class="mt-4 grid gap-3 sm:grid-cols-2" method="post" action="<%= formAction %>">
    <input type="hidden" name="action" value="<%= editingItem ? 'update' : 'create' %>" />
    <input type="hidden" name="page" value="<%= (pagination && pagination.page) || 1 %>" />
    <% if (editingItem) { %><input type="hidden" name="id" value="<%= editingItem.id %>" /><% } %>

    <div class="sm:col-span-2">
      <label class="text-xs text-11muted">Soutěž</label>
      <input name="competition" value="<%= (editingItem && editingItem.competition) || '' %>" placeholder="např. Chance Liga" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
    </div>
    <div>
      <label class="text-xs text-11muted">Domácí tým *</label>
      <%- teamSelectHtml('home_team', editingItem && editingItem.home_team) %>
    </div>
    <div>
      <label class="text-xs text-11muted">Hostující tým *</label>
      <%- teamSelectHtml('away_team', editingItem && editingItem.away_team) %>
    </div>
    <div class="sm:col-span-2">
      <label class="text-xs text-11muted" for="match-kickoff-at">Datum a čas</label>
      <input
        id="match-kickoff-at"
        name="kickoff_at"
        type="datetime-local"
        value="<%= _kickoff %>"
        class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white [color-scheme:dark]"
      />
      <p class="mt-1 text-xs text-11muted">Zadejte datum i čas (časová zóna Praha, CET/CEST).</p>
    </div>
    <div class="sm:col-span-2">
      <label class="text-xs text-11muted">Místo / stadion</label>
      <input name="venue" value="<%= (editingItem && editingItem.venue) || '' %>" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
    </div>
    <div class="sm:col-span-2 flex flex-wrap gap-2">
      <button type="submit" class="rounded-xl bg-11accent px-4 py-2 text-sm font-semibold text-11bg"><%= editingItem ? 'Uložit změny' : 'Vytvořit zápas' %></button>
      <% if (editingItem) { %>
      <a href="<%= cancelHref %>" class="rounded-xl border border-white/15 px-4 py-2 text-sm text-slate-200 hover:bg-white/5">Zrušit úpravu</a>
      <% } %>
    </div>
  </form>
</section>
