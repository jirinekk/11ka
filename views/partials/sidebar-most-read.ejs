<% var list = typeof items !== 'undefined' && items ? items : []; %>
<% if (!list.length) { return; } %>
<% var scope = typeof mostReadScope !== 'undefined' ? mostReadScope : 'global'; %>
<% var categoryKey = typeof mostReadCategory !== 'undefined' ? mostReadCategory : ''; %>
<% var tagKey = typeof mostReadTag !== 'undefined' ? mostReadTag : ''; %>
<% var queryKey = typeof mostReadQuery !== 'undefined' ? mostReadQuery : ''; %>
<% var limitKey = typeof mostReadLimit !== 'undefined' && mostReadLimit ? String(mostReadLimit) : ''; %>
<div
  class="card-11 p-4"
  data-most-read-root
  data-most-read-layout="sidebar"
  data-most-read-scope="<%= scope %>"
  data-most-read-category="<%= categoryKey %>"
  data-most-read-tag="<%= tagKey %>"
  data-most-read-query="<%= queryKey %>"
  <% if (limitKey) { %>data-most-read-limit="<%= limitKey %>"<% } %>
  data-most-read-signature="<%= list.filter(function (i) { return i.id != null; }).map(function (i) { return i.id + ':' + (i.viewCount || 0); }).join('|') %>"
>
  <h2 class="mb-1 text-lg font-bold text-11accent">Nejčtenější</h2>
  <ul class="most-read-sidebar" data-most-read-target>
    <%- include('most-read-sidebar-list', { items: list }) %>
  </ul>
</div>
