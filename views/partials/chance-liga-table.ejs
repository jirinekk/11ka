<%
  var rows = typeof standings !== 'undefined' && standings ? standings : [];
  var compact = typeof compactTable !== 'undefined' && compactTable;
  var highlights = {};
  if (typeof highlightCode !== 'undefined' && highlightCode) highlights[String(highlightCode)] = true;
  if (typeof highlightCodes !== 'undefined' && highlightCodes && highlightCodes.length) {
    highlightCodes.forEach(function (code) {
      if (code) highlights[String(code)] = true;
    });
  }
  var tableHref = typeof tableHref !== 'undefined' && tableHref ? tableHref : '/zapasy/live#tabulka';
  var heading =
    typeof tableTitle !== 'undefined' && tableTitle
      ? tableTitle
      : compact
        ? 'Tabulka'
        : 'Tabulka Chance Ligy';
  var tableClass = 'cl-table';
  if (compact) tableClass += ' cl-table--compact';
  if (typeof tableRail !== 'undefined' && tableRail) tableClass += ' cl-table--rail';
  var zoneFn = typeof chanceTableZoneClass === 'function' ? chanceTableZoneClass : function (rank) {
    var r = Number(rank);
    if (r <= 2) return 'is-cl';
    if (r === 3) return 'is-el';
    if (r === 4) return 'is-ecl';
    if (r === 14 || r === 15) return 'is-playoff';
    if (r >= 16) return 'is-down';
    return '';
  };
  var legendItems = typeof chanceTableLegend !== 'undefined' && chanceTableLegend && chanceTableLegend.length
    ? chanceTableLegend
    : [
        { className: 'is-cl', label: 'Liga mistrů', shortLabel: 'LM' },
        { className: 'is-el', label: 'Evropská liga', shortLabel: 'EL' },
        { className: 'is-ecl', label: 'Konferenční liga', shortLabel: 'KL' },
        { className: 'is-playoff', label: 'Baráž', shortLabel: 'Baráž' },
        { className: 'is-down', label: 'Sestup', shortLabel: 'Sestup' },
      ];
%>
<% if (rows.length) { %>
<section class="<%= tableClass %>" aria-label="<%= heading %>">
  <div class="home-section-head cl-table__head">
    <h2 class="cl-matches__title"><%= heading %></h2>
    <% if (compact) { %>
    <a href="<%= tableHref %>" class="btn-11 btn-11--sm btn-11--accent-outline shrink-0">Celá tabulka</a>
    <% } %>
  </div>
  <div class="cl-table__wrap">
    <table class="cl-table__grid">
      <thead>
        <tr>
          <th class="cl-table__rank" title="Pořadí">#</th>
          <th class="cl-table__team">Tým</th>
          <th title="Zápasy">Z</th>
          <% if (!compact) { %>
          <th title="Výhry">V</th>
          <th title="Remízy">R</th>
          <th title="Prohry">P</th>
          <% } %>
          <th title="Góly">Góly</th>
          <th title="Rozdíl gólů">+/-</th>
          <th title="Body">B</th>
          <% if (!compact) { %>
          <th class="cl-table__form" title="Posledních 5 zápasů">Forma</th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (row) { %>
        <% var zone = zoneFn(row.rank); %>
        <tr class="<%= highlights[row.code] ? 'is-active' : '' %> <%= zone %>">
          <td class="cl-table__rank"><%= row.rank %></td>
          <td class="cl-table__team">
            <a href="<%= row.href %>">
              <% if (row.logo) { %>
              <img src="<%= row.logo %>" alt="" width="22" height="22" referrerpolicy="no-referrer" />
              <% } %>
              <span><%= compact ? (row.short || row.name) : row.name %></span>
            </a>
          </td>
          <td><%= row.played %></td>
          <% if (!compact) { %>
          <td><%= row.won %></td>
          <td><%= row.drawn %></td>
          <td><%= row.lost %></td>
          <% } %>
          <td class="cl-table__goals"><%= row.goalsLabel %></td>
          <td class="cl-table__gd"><%= row.gdLabel %></td>
          <td class="cl-table__pts"><%= row.pts %></td>
          <% if (!compact) { %>
          <td class="cl-table__form">
            <% (row.form || []).forEach(function (f) { %>
            <span class="cl-form cl-form--<%= f === 'W' ? 'w' : f === 'D' ? 'd' : 'l' %>"><%= f === 'W' ? 'V' : f === 'D' ? 'R' : 'P' %></span>
            <% }); %>
          </td>
          <% } %>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <p class="cl-table__legend">
    <% legendItems.forEach(function (item) { %>
    <span class="cl-table__legend-item <%= item.className %>"><%= compact ? item.shortLabel : item.label %></span>
    <% }); %>
  </p>
</section>
<% } %>
