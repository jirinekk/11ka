<%- include('head') %>
<% var admNav = typeof adminNav !== 'undefined' ? adminNav : ''; %>
<% var role = currentUser && currentUser.role; %>
<% var akreditaceOnly = typeof isAkreditaceOnly === 'function' ? isAkreditaceOnly(currentUser) : role === 'spravce_akreditace'; %>
<% var fotografOnly = typeof isFotografOnly === 'function' ? isFotografOnly(currentUser) : role === 'fotograf'; %>
<% var canVedeni = typeof hasRole === 'function' ? hasRole(currentUser, 'vedeni') : role === 'vedeni'; %>
<% var canSef = typeof hasAnyRole === 'function' ? hasAnyRole(currentUser, 'vedeni', 'sefredaktor') : (role === 'vedeni' || role === 'sefredaktor'); %>
<% var canRedaktorFlow = typeof isRedaktorWorkflow === 'function' ? isRedaktorWorkflow(currentUser) : role === 'redaktor'; %>
<% var canAkreditace = typeof hasAnyRole === 'function' ? hasAnyRole(currentUser, 'vedeni', 'spravce_akreditace') : (role === 'vedeni' || role === 'spravce_akreditace'); %>
<% var canAiDrafts = typeof canAccessAiDrafts === 'function' ? canAccessAiDrafts(currentUser) : false; %>
<% var canFoto = typeof canAccessFoto === 'function' ? canAccessFoto(currentUser) : !akreditaceOnly; %>
<% var canGrafici = typeof hasAnyRole === 'function' ? hasAnyRole(currentUser, 'vedeni', 'sefredaktor', 'redaktor', 'fotograf') : !akreditaceOnly; %>
<% var canUsers = typeof canCreateFotografUsers === 'function' ? canCreateFotografUsers(currentUser) : canVedeni; %>
<% var adminHomeHref = akreditaceOnly ? '/administrace/akreditace' : (fotografOnly ? '/foto' : '/administrace'); %>
<% function admLink(k) { return admNav === k ? 'bg-11accent/10 text-11accent' : 'text-slate-300 hover:bg-white/5 hover:text-white'; } %>
<body data-admin="1" class="site-v2 flex min-h-screen flex-col bg-11bg font-sans text-slate-200 antialiased">
  <header class="admin-bar--liquid sticky top-0 z-[55] shrink-0 overflow-visible">
    <div class="flex min-h-14 items-center justify-between gap-3 px-4 py-2 lg:px-6">
      <div class="flex min-w-0 flex-1 items-center gap-3 sm:gap-4">
        <a href="<%= adminHomeHref %>" class="inline-flex shrink-0 items-center gap-2" aria-label="Přehled administrace">
          <img src="/logo.png" alt="11ka" class="h-7 w-auto md:h-8" />
          <span class="hidden text-sm font-semibold tracking-tight text-white sm:inline">Administrace</span>
        </a>
      </div>
      <div class="flex items-center gap-2 md:hidden">
        <details class="nav-mobile-dd relative">
          <summary
            class="inline-flex h-10 list-none items-center justify-center gap-1 rounded-xl px-3 text-sm font-medium text-slate-200 transition [&::-webkit-details-marker]:hidden"
            aria-label="Admin menu"
          >
            Menu
            <svg class="h-4 w-4 shrink-0 text-11muted transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div class="absolute left-1/2 top-full z-[70] mt-2 w-[min(22rem,calc(100vw-1rem))] -translate-x-1/2 overflow-hidden rounded-xl bg-[#111827] py-1 shadow-xl shadow-black/50">
            <% if (canFoto) { %>
            <a href="/foto" class="block px-4 py-2.5 text-sm leading-tight whitespace-normal <%= admNav === 'foto' ? 'font-semibold text-11accent' : 'text-slate-200 hover:bg-white/5' %>">Foták</a>
            <% } %>
            <% if (!akreditaceOnly && !fotografOnly) { %>
            <a href="/administrace" class="block px-4 py-2.5 text-sm leading-tight whitespace-normal <%= admNav === 'dashboard' ? 'font-semibold text-11accent' : 'text-slate-200 hover:bg-white/5' %>">Přehled</a>
            <a href="/administrace/clanek/novy" class="adm-nav-new block px-4 py-2.5 text-sm leading-tight whitespace-normal <%= admNav === 'editor' ? 'is-on' : '' %>">Nový článek</a>
            <% if (canSef) { %>
            <a href="/administrace/clanky" class="block px-4 py-2.5 text-sm leading-tight whitespace-normal <%= admNav === 'clanky' ? 'font-semibold text-11accent' : 'text-slate-200 hover:bg-white/5' %>">Všechny články</a>
            <a href="/administrace/zadosti" class="block px-4 py-2.5 text-sm leading-tight whitespace-normal <%= admNav === 'zadosti' ? 'font-semibold text-11accent' : 'text-slate-200 hover:bg-white/5' %>">Žádosti</a>
            <% } %>
            <% if (canRedaktorFlow) { %>
            <a href="/administrace/moje-clanky" class="block px-4 py-2.5 text-sm leading-tight whitespace-normal <%= admNav === 'moje' ? 'font-semibold text-11accent' : 'text-slate-200 hover:bg-white/5' %>">Moje články</a>
            <% } %>
            <% } %>
            <% if (canGrafici) { %>
            <a href="/administrace/grafici" class="block px-4 py-2.5 text-sm leading-tight whitespace-normal <%= admNav === 'grafici' ? 'font-semibold text-11accent' : 'text-slate-200 hover:bg-white/5' %>">Grafici</a>
            <% } %>
            <% if (canAkreditace) { %>
            <a href="/administrace/akreditace" class="block px-4 py-2.5 text-sm leading-tight whitespace-normal <%= admNav === 'akreditace' ? 'font-semibold text-11accent' : 'text-slate-200 hover:bg-white/5' %>">Akreditace</a>
            <% } %>
            <% if (canAiDrafts) { %>
            <a href="/administrace/ai-clanky" class="block px-4 py-2.5 text-sm leading-tight whitespace-normal <%= admNav === 'ai-clanky' ? 'font-semibold text-11accent' : 'text-slate-200 hover:bg-white/5' %>">AI články</a>
            <% } %>
            <% if (canUsers) { %>
            <a href="/administrace/uzivatele" class="block px-4 py-2.5 text-sm leading-tight whitespace-normal <%= admNav === 'uzivatele' ? 'font-semibold text-11accent' : 'text-slate-200 hover:bg-white/5' %>">Uživatelé</a>
            <% } %>
            <% if (canVedeni) { %>
            <a href="/administrace/bio" class="block px-4 py-2.5 text-sm leading-tight whitespace-normal <%= admNav === 'bio' ? 'font-semibold text-11accent' : 'text-slate-200 hover:bg-white/5' %>">Bio</a>
            <a href="/administrace/pomaha" class="block px-4 py-2.5 text-sm leading-tight whitespace-normal <%= admNav === 'pomaha' ? 'font-semibold text-11accent' : 'text-slate-200 hover:bg-white/5' %>">11ka Pomáhá</a>
            <a href="/administrace/reklamy" class="block px-4 py-2.5 text-sm leading-tight whitespace-normal <%= admNav === 'reklamy' ? 'font-semibold text-11accent' : 'text-slate-200 hover:bg-white/5' %>">Reklamy</a>
            <a href="/administrace/statistiky" class="block px-4 py-2.5 text-sm leading-tight whitespace-normal <%= admNav === 'statistiky' ? 'font-semibold text-11accent' : 'text-slate-200 hover:bg-white/5' %>">Statistiky</a>
            <% } %>
            <% if (!akreditaceOnly && canSef) { %>
            <a href="/administrace/rubriky" class="block px-4 py-2.5 text-sm leading-tight whitespace-normal <%= admNav === 'rubriky' ? 'font-semibold text-11accent' : 'text-slate-200 hover:bg-white/5' %>">Rubriky</a>
            <a href="/administrace/kitswapy" class="block px-4 py-2.5 text-sm leading-tight whitespace-normal <%= admNav === 'kitswapy' ? 'font-semibold text-11accent' : 'text-slate-200 hover:bg-white/5' %>">Kitswapy</a>
            <a href="/administrace/zapasy" class="block px-4 py-2.5 text-sm leading-tight whitespace-normal <%= admNav === 'zapasy' ? 'font-semibold text-11accent' : 'text-slate-200 hover:bg-white/5' %>">Zápasy</a>
            <a href="/administrace/penalty" class="block px-4 py-2.5 text-sm leading-tight whitespace-normal <%= admNav === 'penalty' ? 'font-semibold text-11accent' : 'text-slate-200 hover:bg-white/5' %>">Penalty</a>
            <% } %>
            <a href="/ucet" class="block px-4 py-2.5 text-sm leading-tight whitespace-normal text-slate-200 hover:bg-white/5">Účet</a>
          </div>
        </details>
      </div>
      <a href="/" class="hidden shrink-0 rounded-lg px-3 py-1.5 text-sm font-medium text-slate-200 transition md:flex">Zpět na web</a>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <% var accountMenuInAdmin = true; %>
      <div class="relative z-[60] flex shrink-0 items-center">
        <%- include('user-account-menu') %>
      </div>
      <% } %>
    </div>
    <div class="px-4 pb-2 pt-1 md:hidden">
      <a href="/" class="inline-flex text-xs font-medium text-11muted transition hover:text-11accent">Zpět na web</a>
    </div>
  </header>

  <div class="flex min-h-0 flex-1 flex-col md:flex-row">
    <aside class="hidden shrink-0 bg-11card/80 md:block md:w-56 md:bg-[#0d121c]">
      <nav class="hidden md:flex md:flex-col md:gap-0.5 md:p-4" aria-label="Navigace administrace">
        <% if (canFoto) { %>
        <a href="/foto" class="block rounded-lg px-3 py-2 text-sm font-medium transition <%= admLink('foto') %>">Foták</a>
        <% } %>
        <% if (!akreditaceOnly && !fotografOnly) { %>
        <a href="/administrace" class="block rounded-lg px-3 py-2 text-sm font-medium transition <%= admLink('dashboard') %>">Přehled</a>
        <a href="/administrace/clanek/novy" class="adm-nav-new block rounded-lg px-3 py-2 text-sm font-medium transition <%= admNav === 'editor' ? 'is-on' : '' %>">Nový článek</a>
        <% if (canSef) { %>
        <a href="/administrace/clanky" class="block rounded-lg px-3 py-2 text-sm font-medium transition <%= admLink('clanky') %>">Všechny články</a>
        <% } %>
        <% if (canRedaktorFlow) { %>
        <a href="/administrace/moje-clanky" class="block rounded-lg px-3 py-2 text-sm font-medium transition <%= admLink('moje') %>">Moje články</a>
        <% } %>
        <% if (canSef) { %>
        <a href="/administrace/zadosti" class="block rounded-lg px-3 py-2 text-sm font-medium transition <%= admLink('zadosti') %>">Žádosti</a>
        <% } %>
        <% } %>
        <% if (canGrafici) { %>
        <a href="/administrace/grafici" class="block rounded-lg px-3 py-2 text-sm font-medium transition <%= admLink('grafici') %>">Grafici</a>
        <% } %>
        <% if (canAkreditace) { %>
        <a href="/administrace/akreditace" class="block rounded-lg px-3 py-2 text-sm font-medium transition <%= admLink('akreditace') %>">Akreditace</a>
        <% } %>
        <% if (canAiDrafts) { %>
        <a href="/administrace/ai-clanky" class="block rounded-lg px-3 py-2 text-sm font-medium transition <%= admLink('ai-clanky') %>">AI články</a>
        <% } %>
        <% if (canUsers) { %>
        <a href="/administrace/uzivatele" class="block rounded-lg px-3 py-2 text-sm font-medium transition <%= admLink('uzivatele') %>">Uživatelé</a>
        <% } %>
        <% if (canVedeni) { %>
        <a href="/administrace/bio" class="block rounded-lg px-3 py-2 text-sm font-medium transition <%= admLink('bio') %>">Bio</a>
        <a href="/administrace/pomaha" class="block rounded-lg px-3 py-2 text-sm font-medium transition <%= admLink('pomaha') %>">11ka Pomáhá</a>
        <a href="/administrace/reklamy" class="block rounded-lg px-3 py-2 text-sm font-medium transition <%= admLink('reklamy') %>">Reklamy</a>
        <a href="/administrace/statistiky" class="block rounded-lg px-3 py-2 text-sm font-medium transition <%= admLink('statistiky') %>">Statistiky</a>
        <% } %>
        <% if (!akreditaceOnly && canSef) { %>
        <a href="/administrace/rubriky" class="block rounded-lg px-3 py-2 text-sm font-medium transition <%= admLink('rubriky') %>">Rubriky</a>
        <a href="/administrace/kitswapy" class="block rounded-lg px-3 py-2 text-sm font-medium transition <%= admLink('kitswapy') %>">Kitswapy</a>
        <a href="/administrace/zapasy" class="block rounded-lg px-3 py-2 text-sm font-medium transition <%= admLink('zapasy') %>">Zápasy</a>
        <a href="/administrace/penalty" class="block rounded-lg px-3 py-2 text-sm font-medium transition <%= admLink('penalty') %>">Penalty</a>
        <% } %>
        <div class="my-2 hidden h-px w-full bg-white/10 md:block" aria-hidden="true"></div>
        <a href="/ucet" class="block rounded-lg px-3 py-2 text-sm font-medium transition text-slate-300 hover:bg-white/5 hover:text-white">Účet</a>
      </nav>
    </aside>

    <main class="min-h-0 min-w-0 flex-1 overflow-auto">
      <div class="mx-auto w-full max-w-6xl px-4 py-8 lg:px-6">
