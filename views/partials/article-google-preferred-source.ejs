<% if (typeof googlePreferredSource !== 'undefined' && googlePreferredSource) { %>
<% var googleCompact = typeof compact !== 'undefined' && compact; %>
<section class="article-google-cta<%= googleCompact ? ' article-google-cta--sidebar' : ' mt-8' %>" aria-labelledby="article-google-cta-heading">
  <div class="card-11 article-google-cta__card<%= googleCompact ? ' p-3' : ' p-5 sm:p-7' %>">
    <div class="article-google-cta__inner">
      <p class="article-google-cta__eyebrow">
        <svg class="article-google-cta__eyebrow-g" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Google zprávy
      </p>
      <h2 id="article-google-cta-heading" class="article-google-cta__title">
        Chceš vědět o fotbale dřív než ostatní?
      </h2>
      <p class="article-google-cta__text">
        Nastav si <span class="article-google-cta__brand"><%= googlePreferredSource.siteName %></span> jako preferovaný zdroj v Google a buď u fotbalových novinek vždy o krok napřed.
      </p>
      <div class="article-google-cta__divider" aria-hidden="true"></div>
      <div class="article-google-cta__actions-wrap">
        <div class="article-google-cta__actions">
          <a
            href="<%= googlePreferredSource.followUrl %>"
            class="btn-11 btn-11--sm btn-11--accent-outline article-google-cta__btn"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="article-google-cta__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
            </svg>
            Sledovat
          </a>
          <a
            href="<%= googlePreferredSource.preferredSourceUrl %>"
            class="btn-11 btn-11--sm btn-11--primary article-google-cta__btn"
            target="_blank"
            rel="noopener noreferrer"
          >
            Preferovaný zdroj
          </a>
          <a
            href="<%= googlePreferredSource.googleNewsUrl %>"
            class="btn-11 btn-11--sm btn-11--ghost article-google-cta__btn article-google-cta__btn--news"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="article-google-cta__google-g" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            <span class="article-google-cta__news-text">
              <span>Ještě více zpráv</span>
              <span><%= googlePreferredSource.siteName %> na Google</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
<% } %>
