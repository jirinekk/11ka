  >
    <h2 id="match-red-modal-title" class="match-manage-modal__title text-lg font-semibold text-white">Zapsat červenou kartu</h2>
    <form method="post" action="/administrace/zapasy/seznam?mk=red_home" class="match-manage-modal__form mt-4 space-y-4" id="match-red-modal-form">
      <input type="hidden" name="action" value="add_match_event" />
      <input type="hidden" name="id" value="<%= editingFixture.id %>" />
      <input type="hidden" name="page" value="<%= _page %>" />
      <input type="hidden" name="mk" id="match-red-event-key" value="red_home" />
      <div class="flex gap-2">
        <div class="flex-1">
          <label class="text-xs text-11muted" for="match-red-minute">Minuta</label>
          <input id="match-red-minute" name="minute" type="number" min="1" max="90" placeholder="např. 45" required class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
        </div>
        <div class="w-24">
          <label class="text-xs text-11muted" for="match-red-minute-extra">+ nastavení</label>
          <input id="match-red-minute-extra" name="minute_extra" type="number" min="0" max="20" placeholder="0" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
        </div>
