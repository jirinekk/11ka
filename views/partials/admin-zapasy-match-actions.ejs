<script>
  (function () {
    var FORFEIT_TEAM_LABELS = {
      forfeit_home: <%- JSON.stringify(_homeTeam) %>,
      forfeit_away: <%- JSON.stringify(_awayTeam) %>
    };

    var modal = document.getElementById('match-forfeit-modal');
    if (!modal) return;

    var form = document.getElementById('match-forfeit-modal-form');
    var textEl = document.getElementById('match-forfeit-modal-text');
    var keyInput = document.getElementById('match-forfeit-event-key');
    var lastFocus = null;

    function openModal(btn) {
      if (!btn || !form) return;
      var key = btn.getAttribute('data-forfeit-open') || 'forfeit_home';
      var team = FORFEIT_TEAM_LABELS[key] || 'tým';
      lastFocus = btn;
      keyInput.value = key;
      form.action = '/administrace/zapasy/seznam?mk=' + encodeURIComponent(key);
      if (textEl) {
        textEl.textContent =
          'Potvrzujete kontumaci ve prospěch ' + team + ' podle reálného zápasu?';
      }
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('match-manage-modal-open');
      var confirmBtn = modal.querySelector('button[type="submit"]');
      if (confirmBtn) confirmBtn.focus();
    }

    function closeModal() {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('match-manage-modal-open');
      if (lastFocus && typeof lastFocus.focus === 'function') {
        lastFocus.focus();
      }
    }

    document.querySelectorAll('[data-forfeit-open]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        openModal(btn);
      });
    });

    modal.querySelectorAll('[data-forfeit-close]').forEach(function (el) {
      el.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', function (e) {
      if (modal.hidden) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
      }
    });

    modal.addEventListener('click', function (e) {
      if (e.target === modal.querySelector('.match-manage-modal__backdrop')) {
        closeModal();
      }
    });
  })();
</script>

