    document.querySelectorAll('.match-manage-modal__form').forEach(function (form) {
      var actionInput = form.querySelector('input[name="action"]');
      if (!actionInput || actionInput.value !== 'add_match_event') return;
      form.addEventListener('submit', function () {
        var keyInput = form.querySelector('input[name="mk"]');
        if (!keyInput || String(keyInput.value || '').trim()) return;
        var fallback = form.getAttribute('data-default-event-key');
        if (fallback) keyInput.value = fallback;
      });
    });

    var firstHalfModal = document.getElementById('match-first-half-extra-modal');
    var liveClock = document.querySelector('.match-board-manage__live-clock[data-match-live-clock]');
    if (!firstHalfModal || !liveClock) return;

    var extraTitle = document.getElementById('match-first-half-extra-title');
    var extraActionInput = document.getElementById('match-extra-action');
    var firstHalfLastFocus = null;
    var firstHalfMinutesInput = firstHalfModal.querySelector('[data-first-half-extra-minutes]');
    var firstHalfModeInputs = firstHalfModal.querySelectorAll('[data-first-half-extra-mode]');
    var startedAt = liveClock.getAttribute('data-match-live-clock');
    var startMs = Date.parse(startedAt || '');
    if (!Number.isFinite(startMs)) return;

    var firstHalfSet = liveClock.getAttribute('data-match-live-clock-first-half-set') === '1';
    var secondHalfSet = liveClock.getAttribute('data-match-live-clock-second-half-set') === '1';
    var firstHalfShown = false;
    var secondHalfShown = false;
    var currentHalfPhase = 1;

    function syncFirstHalfMinutesState() {
      var selected = firstHalfModal.querySelector('[data-first-half-extra-mode]:checked');
      var enableMinutes = !selected || selected.value === 'set';
      if (firstHalfMinutesInput) firstHalfMinutesInput.disabled = !enableMinutes;
    }

    function openExtraModal(halfPhase, trigger) {
      if (halfPhase === 1 && (firstHalfSet || firstHalfShown)) return;
      if (halfPhase === 2 && (secondHalfSet || secondHalfShown)) return;
      currentHalfPhase = halfPhase === 2 ? 2 : 1;
      if (currentHalfPhase === 1) firstHalfShown = true;
      if (currentHalfPhase === 2) secondHalfShown = true;
      firstHalfLastFocus = trigger || null;
      if (extraActionInput) extraActionInput.value = currentHalfPhase === 2 ? 'save_second_half_extra' : 'save_first_half_extra';
      if (extraTitle) extraTitle.textContent = currentHalfPhase === 2 ? 'Nastavení 2. poločasu' : 'Nastavení 1. poločasu';
      firstHalfModal.hidden = false;
      firstHalfModal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('match-manage-modal-open');
      syncFirstHalfMinutesState();
      window.setTimeout(function () {
        if (firstHalfMinutesInput && !firstHalfMinutesInput.disabled) firstHalfMinutesInput.focus();
      }, 0);
    }

    function closeFirstHalfModal() {
      firstHalfModal.hidden = true;
      firstHalfModal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('match-manage-modal-open');
      if (firstHalfLastFocus && typeof firstHalfLastFocus.focus === 'function') firstHalfLastFocus.focus();
    }

    firstHalfModal.querySelectorAll('[data-first-half-extra-close]').forEach(function (el) {
      el.addEventListener('click', closeFirstHalfModal);
    });

    firstHalfModeInputs.forEach(function (input) {
      input.addEventListener('change', syncFirstHalfMinutesState);
    });

    var clockEditModal = document.getElementById('match-clock-edit-modal');
    if (clockEditModal) {
      var clockEditForm = document.getElementById('match-clock-edit-form');
      var clockEditMinuteInput = document.getElementById('match-clock-edit-minute');
      var clockEditPreview = document.getElementById('match-clock-edit-preview');
      var clockEditLive = document.getElementById('match-clock-edit-live');
      var clockEditLastFocus = null;
      var clockEditLiveTicker = null;

      function pad2(n) { return String(n).padStart(2, '0'); }

      function tickClockEditLive() {
        if (!clockEditLive) return;
        var elapsed = Date.now() - startMs;
        var totalSec = Math.max(0, Math.floor(elapsed / 1000));
        var min = Math.floor(totalSec / 60);
        var sec = totalSec % 60;
        clockEditLive.textContent = min + ':' + pad2(sec);
      }

      function formatClockPreview(mins) {
        if (mins == null || isNaN(mins) || mins < 0) return '-';
        return Math.floor(mins) + ':00';
      }

      function updateClockPreview() {
        if (!clockEditMinuteInput || !clockEditPreview) return;
        var v = parseInt(clockEditMinuteInput.value, 10);
        clockEditPreview.textContent = Number.isFinite(v) && v >= 0 ? formatClockPreview(v) : '-';
      }

      function openClockEditModal(trigger) {
        clockEditLastFocus = trigger || null;
        if (clockEditMinuteInput) {
          var elapsed = Date.now() - startMs;
          var currentMin = Math.max(0, Math.floor(elapsed / 60000));
          clockEditMinuteInput.value = currentMin;
        }
        updateClockPreview();
        tickClockEditLive();
        clockEditModal.hidden = false;
        clockEditModal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('match-manage-modal-open');
        clockEditLiveTicker = window.setInterval(tickClockEditLive, 1000);
        window.setTimeout(function () {
          if (clockEditMinuteInput) clockEditMinuteInput.focus();
        }, 0);
      }

      function closeClockEditModal() {
        if (clockEditLiveTicker) { window.clearInterval(clockEditLiveTicker); clockEditLiveTicker = null; }
        clockEditModal.hidden = true;
        clockEditModal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('match-manage-modal-open');
        if (clockEditLastFocus && typeof clockEditLastFocus.focus === 'function') clockEditLastFocus.focus();
      }

      document.querySelectorAll('[data-clock-edit-open]').forEach(function (btn) {
        btn.addEventListener('click', function () { openClockEditModal(btn); });
      });

      clockEditModal.querySelectorAll('[data-clock-edit-close]').forEach(function (el) {
        el.addEventListener('click', closeClockEditModal);
      });

      if (clockEditMinuteInput) {
        clockEditMinuteInput.addEventListener('input', updateClockPreview);
      }

      document.addEventListener('keydown', function (e) {
        if (clockEditModal.hidden) return;
        if (e.key === 'Escape') { e.preventDefault(); closeClockEditModal(); }
      });
    }

    var firstHalfTimer = window.setInterval(function () {
      var elapsedMs = Date.now() - startMs;
      if (elapsedMs >= 90 * 60 * 1000 && !secondHalfSet && !secondHalfShown) {
        openExtraModal(2);
        return;
      }
      if (elapsedMs >= 45 * 60 * 1000 && elapsedMs < 90 * 60 * 1000 && !firstHalfSet && !firstHalfShown) {
        openExtraModal(1);
      }
    }, 1000);
  })();
</script>
<% } %>

<% if (_canPostpone || _canCancel) { %>
<div
  id="match-action-modal"
  class="match-manage-modal"
  hidden
  aria-hidden="true"
  role="presentation"
>
  <div class="match-manage-modal__backdrop" data-match-action-close tabindex="-1" aria-hidden="true"></div>
  <div
    class="match-manage-modal__panel card-11"
    role="dialog"
    aria-modal="true"
    aria-labelledby="match-action-modal-title"
  >
    <h2 id="match-action-modal-title" class="match-manage-modal__title text-lg font-semibold text-white"></h2>
    <form method="post" action="/administrace/zapasy/seznam" class="match-manage-modal__form mt-4 space-y-4">
      <input type="hidden" name="action" id="match-action-modal-action" value="" />
      <input type="hidden" name="id" value="<%= editingFixture.id %>" />
      <input type="hidden" name="page" value="<%= _page %>" />
      <div>
        <label for="match-action-modal-reason" class="match-manage-modal__label text-xs text-11muted" id="match-action-modal-reason-label">Důvod</label>
        <textarea
          id="match-action-modal-reason"
          name="reason"
          rows="4"
          placeholder="Napište důvod…"
          class="input-11 mt-1 w-full resize-y rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white placeholder:text-11muted"
        ></textarea>
      </div>
      <div class="flex flex-wrap justify-end gap-2">
        <button
          type="button"
          class="rounded-xl border border-white/15 px-4 py-2 text-sm text-slate-200 hover:bg-white/5"
          data-match-action-close
        >
          Zavřít
        </button>
        <button
          type="submit"
          id="match-action-modal-submit"
          class="rounded-xl bg-11accent px-4 py-2 text-sm font-semibold text-11bg"
        >
          Potvrdit
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    var modal = document.getElementById('match-action-modal');
    if (!modal) return;

    var titleEl = document.getElementById('match-action-modal-title');
    var actionInput = document.getElementById('match-action-modal-action');
    var reasonLabel = document.getElementById('match-action-modal-reason-label');
    var reasonInput = document.getElementById('match-action-modal-reason');
    var submitBtn = document.getElementById('match-action-modal-submit');
    var panel = modal.querySelector('.match-manage-modal__panel');
    var lastFocus = null;

    function openModal(btn) {
      if (!btn) return;
      lastFocus = btn;
      actionInput.value = btn.getAttribute('data-match-action-open') || '';
      titleEl.textContent = btn.getAttribute('data-match-action-title') || '';
      reasonLabel.textContent = btn.getAttribute('data-match-action-label') || 'Důvod';
      submitBtn.textContent = btn.getAttribute('data-match-action-submit') || 'Potvrdit';
      reasonInput.value = '';
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('match-manage-modal-open');
      window.setTimeout(function () {
        reasonInput.focus();
      }, 0);
    }

    function closeModal() {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('match-manage-modal-open');
      if (lastFocus && typeof lastFocus.focus === 'function') {
        lastFocus.focus();
      }
    }

    document.querySelectorAll('[data-match-action-open]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        openModal(btn);
      });
    });

    modal.querySelectorAll('[data-match-action-close]').forEach(function (el) {
      el.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', function (e) {
      if (modal.hidden) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
      }
    });

    modal.addEventListener('click', function (e) {
      if (e.target === modal.querySelector('.match-manage-modal__backdrop')) {
        closeModal();
      }
    });
  })();
</script>
<% } %>
