<%
  var _page = (pagination && pagination.page) || 1;
  var _status = editingFixture.status || 'Nadcházející';
  var _canStart = _status !== 'Probíhá' && _status !== 'Poločas' && _status !== 'Odehráno' && _status !== 'Kontumace' && _status !== 'Zrušeno';
  var _canPostpone = _status !== 'Probíhá' && _status !== 'Odloženo' && _status !== 'Odehráno' && _status !== 'Kontumace' && _status !== 'Zrušeno';
  var _canCancel = _status !== 'Probíhá' && _status !== 'Poločas' && _status !== 'Kontumace' && _status !== 'Zrušeno' && _status !== 'Odehráno';
  var _lineup = (editingFixture && editingFixture.lineup) || {};
  var _lineupHomeGroups = Array.isArray(_lineup.home) ? _lineup.home : (Array.isArray(_lineup) ? _lineup : []);
  var _lineupAwayGroups = Array.isArray(_lineup.away) ? _lineup.away : [];
  function _collectLineupPlayers(groups, outPlayers, outByNumber) {
    (groups || []).forEach(function (groupBlock) {
      if (!groupBlock || groupBlock.group === 'Hrát nebudou') return;
      (groupBlock.positions || []).forEach(function (positionBlock) {
        (positionBlock.players || []).forEach(function (player) {
          if (!player || !player.name) return;
          var number = player.number != null ? String(player.number).trim() : '';
          var name = String(player.name || '').trim();
          if (!name) return;
          outPlayers.push({ number: number, name: name });
          if (number && !outByNumber[number]) outByNumber[number] = name;
        });
      });
    });
  }
  function _collectLineupGroup(groups, groupName, outPlayers, outByNumber) {
    (groups || []).forEach(function (groupBlock) {
      if (!groupBlock || groupBlock.group !== groupName) return;
      (groupBlock.positions || []).forEach(function (positionBlock) {
        (positionBlock.players || []).forEach(function (player) {
          if (!player || !player.name) return;
          var number = player.number != null ? String(player.number).trim() : '';
          var name = String(player.name || '').trim();
          if (!name) return;
          outPlayers.push({ number: number, name: name });
          if (number && !outByNumber[number]) outByNumber[number] = name;
        });
      });
    });
  }
  var _lineupHomePlayers = [];
  var _lineupAwayPlayers = [];
  var _lineupHomeByNumber = {};
  var _lineupAwayByNumber = {};
  var _lineupHomeStarters = [];
  var _lineupHomeStartersByNumber = {};
  var _lineupHomeSubs = [];
  var _lineupHomeSubsByNumber = {};
  var _lineupAwayStarters = [];
  var _lineupAwayStartersByNumber = {};
  var _lineupAwaySubs = [];
  var _lineupAwaySubsByNumber = {};
  var _homeTeamLabel = (editingFixture && editingFixture.homeTeam) || 'Domácí';
  var _awayTeamLabel = (editingFixture && editingFixture.awayTeam) || 'Hosté';
  var _events = Array.isArray(editingFixture && editingFixture.events) ? editingFixture.events : [];
  var _homeGoalEvents = [];
  var _awayGoalEvents = [];
  var _allGoalEvents = [];
  function _normalizeEventKey(rawKey) {
    if (rawKey == null) return '';
    var k = String(rawKey).trim();
    if (!k) return '';
    while (k.length >= 2 && ((k[0] === '"' && k[k.length - 1] === '"') || (k[0] === "'" && k[k.length - 1] === "'"))) {
      k = k.slice(1, -1).trim();
    }
    k = k.replace(/^["'\\]+|["'\\]+$/g, '').trim();
    return k;
  }
  _collectLineupPlayers(_lineupHomeGroups, _lineupHomePlayers, _lineupHomeByNumber);
  _collectLineupPlayers(_lineupAwayGroups, _lineupAwayPlayers, _lineupAwayByNumber);
  _collectLineupGroup(_lineupHomeGroups, 'Základní sestava', _lineupHomeStarters, _lineupHomeStartersByNumber);
  _collectLineupGroup(_lineupHomeGroups, 'Náhradníci', _lineupHomeSubs, _lineupHomeSubsByNumber);
  _collectLineupGroup(_lineupAwayGroups, 'Základní sestava', _lineupAwayStarters, _lineupAwayStartersByNumber);
  _collectLineupGroup(_lineupAwayGroups, 'Náhradníci', _lineupAwaySubs, _lineupAwaySubsByNumber);
  _events.forEach(function (event) {
    if (!event || !event.key || !event.at) return;
    var key = _normalizeEventKey(event.key);
    var isHomeGoal = key === 'goal_home' || key === 'penalty_scored_home';
    var isAwayGoal = key === 'goal_away' || key === 'penalty_scored_away';
    if (!isHomeGoal && !isAwayGoal) return;
    var d = new Date(event.at);
    var timeLabel = Number.isNaN(d.getTime())
      ? event.at
      : d.toLocaleTimeString('cs-CZ', { hour: '2-digit', minute: '2-digit' });
    var details = event.details || {};
    if (details.disallowed) return;
    var scorer = details.scorer_name || details.player_name || null;
    var number = details.scorer_number || details.player_number || null;
    var scorerLabel = scorer
      ? (number ? '#' + number + ' ' + scorer : scorer)
      : event.label;
    var item = { at: event.at, label: timeLabel + ' - ' + scorerLabel };
    if (isHomeGoal) {
      _homeGoalEvents.push(item);
      _allGoalEvents.push({ at: item.at, label: _homeTeamLabel + ' - ' + item.label });
    }
    if (isAwayGoal) {
      _awayGoalEvents.push(item);
      _allGoalEvents.push({ at: item.at, label: _awayTeamLabel + ' - ' + item.label });
    }
  });
  _homeGoalEvents.reverse();
  _awayGoalEvents.reverse();
  _allGoalEvents.reverse();
%>
<% if (_canStart || _canPostpone || _canCancel) { %>
<div class="match-manage-actions mt-6 flex flex-wrap justify-center gap-3">
  <% if (_canStart) { %>
  <form method="post" action="/administrace/zapasy/seznam">
    <input type="hidden" name="action" value="start_match" />
    <input type="hidden" name="id" value="<%= editingFixture.id %>" />
    <input type="hidden" name="page" value="<%= _page %>" />
    <button type="submit" class="match-manage-actions__btn match-manage-actions__btn--start rounded-xl bg-11accent px-4 py-2.5 text-sm font-semibold text-11bg">
      Startnout zápas
    </button>
  </form>
  <% } %>

  <% if (_canPostpone) { %>
  <button
    type="button"
    class="match-manage-actions__btn match-manage-actions__btn--postpone rounded-xl bg-amber-500/10 px-4 py-2.5 text-sm font-semibold text-amber-200 hover:bg-amber-500/15"
    data-match-action-open="postpone_match"
    data-match-action-title="Odložit zápas"
    data-match-action-label="Důvod odložení"
    data-match-action-submit="Odložit zápas"
  >
    Odložit zápas
  </button>
  <% } %>

  <% if (_canCancel) { %>
  <button
    type="button"
    class="match-manage-actions__btn match-manage-actions__btn--cancel rounded-xl bg-red-500/10 px-4 py-2.5 text-sm font-semibold text-red-200 hover:bg-red-500/15"
    data-match-action-open="cancel_match"
    data-match-action-title="Zrušit zápas"
    data-match-action-label="Důvod zrušení"
    data-match-action-submit="Zrušit zápas"
  >
    Zrušit zápas
  </button>
  <% } %>
</div>
<% } %>

<% if (_status === 'Probíhá' || _status === 'Poločas') { %>
<%
  var _homeTeam = editingFixture.homeTeam || 'Domácí';
  var _awayTeam = editingFixture.awayTeam || 'Hosté';
  var _homeEvents = [
    ['goal_home', 'Gól'],
    ['yellow_home', 'Žlutá karta'],
    ['red_home', 'Červená karta'],
    ['sub_home', 'Střídání'],
    ['disallowed_goal_home', 'Neuznaný gól'],
    ['penalty_scored_home', 'Proměněná penalta'],
    ['penalty_missed_home', 'Neproměněná penalta'],
    ['forfeit_home', 'Kontumace']
  ];
  var _awayEvents = [
    ['goal_away', 'Gól'],
    ['yellow_away', 'Žlutá karta'],
    ['red_away', 'Červená karta'],
    ['sub_away', 'Střídání'],
    ['disallowed_goal_away', 'Neuznaný gól'],
    ['penalty_scored_away', 'Proměněná penalta'],
    ['penalty_missed_away', 'Neproměněná penalta'],
    ['forfeit_away', 'Kontumace']
  ];
%>
<section class="match-live-events mt-5 card-11 p-4">
  <h3 class="match-live-events__title">Akce v zápase</h3>
  <div class="match-live-events__phase-actions mt-3">
    <% if (_status === 'Probíhá') { %>
    <form method="post" action="/administrace/zapasy/seznam" class="match-live-events__item">
      <input type="hidden" name="action" value="halftime_match" />
      <input type="hidden" name="id" value="<%= editingFixture.id %>" />
      <input type="hidden" name="page" value="<%= _page %>" />
      <button type="submit" class="match-live-events__btn">Poločas</button>
    </form>
    <% } %>
    <% if (_status === 'Poločas') { %>
    <form method="post" action="/administrace/zapasy/seznam" class="match-live-events__item">
      <input type="hidden" name="action" value="resume_match" />
      <input type="hidden" name="id" value="<%= editingFixture.id %>" />
      <input type="hidden" name="page" value="<%= _page %>" />
      <button type="submit" class="match-live-events__btn">Pokračovat v zápase (od 45')</button>
    </form>
    <% } %>
    <button type="button" class="match-live-events__btn" data-finish-match-open>Konec zápasu</button>
    <button type="button" class="match-live-events__btn" data-clock-edit-open>Upravit čas</button>
  </div>
  <%
    var _fhSet = editingFixture.firstHalfExtraSet && editingFixture.firstHalfExtraMinutes != null;
    var _shSet = editingFixture.secondHalfExtraSet && editingFixture.secondHalfExtraMinutes != null;
  %>
  <% if (_fhSet || _shSet) { %>
  <div class="flex flex-wrap gap-2 mt-2">
    <% if (_fhSet) { %>
    <span class="rounded-lg bg-white/5 border border-white/10 px-3 py-1 text-xs text-slate-300">
      1. pol. nastavení: <strong class="text-white"><%= editingFixture.firstHalfExtraMinutes %>'</strong>
    </span>
    <% } %>
    <% if (_shSet) { %>
    <span class="rounded-lg bg-white/5 border border-white/10 px-3 py-1 text-xs text-slate-300">
      2. pol. nastavení: <strong class="text-white"><%= editingFixture.secondHalfExtraMinutes %>'</strong>
    </span>
    <% } %>
  </div>
  <% } %>
  <% if (_status === 'Probíhá') { %>
  <div class="match-live-events__groups mt-3">
    <div class="match-live-events__group match-live-events__group--home">
      <h4 class="match-live-events__group-title"><%= _homeTeam %></h4>
      <div class="match-live-events__grid">
        <% _homeEvents.forEach(function (item) { %>
        <form method="post" action="/administrace/zapasy/seznam?mk=<%= encodeURIComponent(item[0]) %>" class="match-live-events__item">
          <input type="hidden" name="action" value="add_match_event" />
          <input type="hidden" name="id" value="<%= editingFixture.id %>" />
          <input type="hidden" name="page" value="<%= _page %>" />
          <input type="hidden" name="mk" value="<%= item[0] %>" />
          <button
            type="<%= (item[0] === 'goal_home' || item[0] === 'yellow_home' || item[0] === 'red_home' || item[0] === 'sub_home' || item[0] === 'disallowed_goal_home' || item[0] === 'forfeit_home' || item[0] === 'penalty_scored_home' || item[0] === 'penalty_missed_home') ? 'button' : 'submit' %>"
            class="match-live-events__btn <%= item[0] === 'forfeit_home' ? 'match-live-events__btn--danger' : '' %>"
            <%- item[0] === 'goal_home' ? 'data-goal-event-open="goal_home"' : '' %>
            <%- item[0] === 'yellow_home' ? 'data-yellow-event-open="yellow_home"' : '' %>
            <%- item[0] === 'red_home' ? 'data-red-event-open="red_home"' : '' %>
            <%- item[0] === 'sub_home' ? 'data-sub-event-open="sub_home"' : '' %>
            <%- item[0] === 'disallowed_goal_home' ? 'data-disallowed-open="disallowed_goal_home"' : '' %>
            <%- item[0] === 'forfeit_home' ? 'data-forfeit-open="forfeit_home"' : '' %>
            <%- item[0] === 'penalty_scored_home' ? 'data-penalty-event-open="penalty_scored_home"' : '' %>
            <%- item[0] === 'penalty_missed_home' ? 'data-penalty-event-open="penalty_missed_home"' : '' %>
          ><%= item[1] %></button>
        </form>
        <% }); %>
      </div>
    </div>
    <div class="match-live-events__group match-live-events__group--away">
      <h4 class="match-live-events__group-title"><%= _awayTeam %></h4>
      <div class="match-live-events__grid">
        <% _awayEvents.forEach(function (item) { %>
        <form method="post" action="/administrace/zapasy/seznam?mk=<%= encodeURIComponent(item[0]) %>" class="match-live-events__item">
          <input type="hidden" name="action" value="add_match_event" />
          <input type="hidden" name="id" value="<%= editingFixture.id %>" />
          <input type="hidden" name="page" value="<%= _page %>" />
          <input type="hidden" name="mk" value="<%= item[0] %>" />
          <button
            type="<%= (item[0] === 'goal_away' || item[0] === 'yellow_away' || item[0] === 'red_away' || item[0] === 'sub_away' || item[0] === 'disallowed_goal_away' || item[0] === 'forfeit_away' || item[0] === 'penalty_scored_away' || item[0] === 'penalty_missed_away') ? 'button' : 'submit' %>"
            class="match-live-events__btn <%= item[0] === 'forfeit_away' ? 'match-live-events__btn--danger' : '' %>"
            <%- item[0] === 'goal_away' ? 'data-goal-event-open="goal_away"' : '' %>
            <%- item[0] === 'yellow_away' ? 'data-yellow-event-open="yellow_away"' : '' %>
            <%- item[0] === 'red_away' ? 'data-red-event-open="red_away"' : '' %>
            <%- item[0] === 'sub_away' ? 'data-sub-event-open="sub_away"' : '' %>
            <%- item[0] === 'disallowed_goal_away' ? 'data-disallowed-open="disallowed_goal_away"' : '' %>
            <%- item[0] === 'forfeit_away' ? 'data-forfeit-open="forfeit_away"' : '' %>
            <%- item[0] === 'penalty_scored_away' ? 'data-penalty-event-open="penalty_scored_away"' : '' %>
            <%- item[0] === 'penalty_missed_away' ? 'data-penalty-event-open="penalty_missed_away"' : '' %>
          ><%= item[1] %></button>
        </form>
        <% }); %>
      </div>
    </div>
  </div>
  <% } %>
</section>

<div
  id="match-goal-modal"
  class="match-manage-modal"
  hidden
  aria-hidden="true"
  role="presentation"
>
  <div class="match-manage-modal__backdrop" data-goal-modal-close tabindex="-1" aria-hidden="true"></div>
  <div
    class="match-manage-modal__panel card-11"
    role="dialog"
    aria-modal="true"
    aria-labelledby="match-goal-modal-title"
  >
    <h2 id="match-goal-modal-title" class="match-manage-modal__title text-lg font-semibold text-white">Zapsat gól</h2>
    <form method="post" action="/administrace/zapasy/seznam?mk=goal_home" class="match-manage-modal__form mt-4 space-y-4" id="match-goal-modal-form">
      <input type="hidden" name="action" value="add_match_event" />
      <input type="hidden" name="id" value="<%= editingFixture.id %>" />
      <input type="hidden" name="page" value="<%= _page %>" />
      <input type="hidden" name="mk" id="match-goal-event-key" value="goal_home" />
      <div class="flex gap-2">
        <div class="flex-1">
          <label class="text-xs text-11muted" for="match-goal-minute">Minuta</label>
          <input id="match-goal-minute" name="minute" type="number" min="1" max="90" placeholder="např. 45" required class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
        </div>
        <div class="w-24">
          <label class="text-xs text-11muted" for="match-goal-minute-extra">+ nastavení</label>
          <input id="match-goal-minute-extra" name="minute_extra" type="number" min="0" max="20" placeholder="0" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
        </div>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <label class="text-xs text-11muted" for="match-goal-scorer-number">Číslo střelce</label>
          <input id="match-goal-scorer-number" name="scorer_number" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
        </div>
        <div>
          <label class="text-xs text-11muted" for="match-goal-scorer-name">Jméno střelce</label>
          <input id="match-goal-scorer-name" name="scorer_name" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
        </div>
        <div>
          <label class="text-xs text-11muted" for="match-goal-assist-number">Číslo asistence</label>
          <input id="match-goal-assist-number" name="assist_number" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
        </div>
        <div>
          <label class="text-xs text-11muted" for="match-goal-assist-name">Jméno asistence</label>
          <input id="match-goal-assist-name" name="assist_name" class="input-11 mt-1 w-full rounded-xl border border-white/10 bg-[#111827] px-3 py-2 text-sm text-white" />
        </div>
      </div>
      <datalist id="match-goal-player-list-home">
        <% _lineupHomePlayers.forEach(function (player) { %>
        <% if (!player.number) return; %>
        <option value="<%= player.number %>"><%= player.name %></option>
        <% }); %>
      </datalist>
      <datalist id="match-goal-player-list-away">
        <% _lineupAwayPlayers.forEach(function (player) { %>
        <% if (!player.number) return; %>
        <option value="<%= player.number %>"><%= player.name %></option>
        <% }); %>
      </datalist>
      <div class="flex flex-wrap justify-end gap-2">
        <button type="button" class="rounded-xl border border-white/15 px-4 py-2 text-sm text-slate-200 hover:bg-white/5" data-goal-modal-close>
          Zavřít
        </button>
        <button type="submit" class="rounded-xl bg-11accent px-4 py-2 text-sm font-semibold text-11bg">
          Uložit gól
        </button>
      </div>
    </form>
  </div>
</div>

