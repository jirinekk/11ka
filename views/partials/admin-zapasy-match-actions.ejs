      btn.addEventListener('click', function () {
        openModal(btn);
      });
    });

    modal.querySelectorAll('[data-finish-match-close]').forEach(function (el) {
      el.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', function (e) {
      if (modal.hidden) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
      }
    });

    modal.addEventListener('click', function (e) {
      if (e.target === modal.querySelector('.match-manage-modal__backdrop')) {
        closeModal();
      }
    });
  })();
</script>
