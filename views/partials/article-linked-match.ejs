<% var m = typeof linkedMatch !== 'undefined' && linkedMatch ? linkedMatch : null; %>
<% if (m) { %>
<a class="article-match<%= m.isLive || m.state === 'in' ? ' is-live' : '' %><%= m.isDone || m.state === 'post' ? ' is-done' : '' %>" href="<%= m.detailHref || m.href || '#' %>">
  <span class="article-match__comp"><%= m.league || 'Chance Liga' %><% if (m.round) { %> · <%= m.round %><% } %></span>
  <span class="article-match__duel">
    <span class="article-match__side">
      <% if (m.homeLogo) { %>
      <img src="<%= m.homeLogo %>" alt="" width="28" height="28" />
      <% } %>
      <span><%= m.homeLabel || m.home %></span>
    </span>
    <span class="article-match__mid">
      <%- include('match-score', { m: m, liveClass: 'article-match__live', scoreClass: 'article-match__score', vsClass: 'article-match__vs' }) %>
    </span>
    <span class="article-match__side">
      <% if (m.awayLogo) { %>
      <img src="<%= m.awayLogo %>" alt="" width="28" height="28" />
      <% } %>
      <span><%= m.awayLabel || m.away %></span>
    </span>
  </span>
  <span class="article-match__cta">Zápas</span>
</a>
<% } %>
