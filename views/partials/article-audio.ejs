<%
  var audioSlug = typeof articleSlug !== 'undefined' ? articleSlug : '';
  var audioSec = typeof audioDurationSec !== 'undefined' ? Number(audioDurationSec) : 0;
  if (!Number.isFinite(audioSec) || audioSec < 0) audioSec = 0;
  var audioMin = Math.floor(audioSec / 60);
  var audioRem = Math.round(audioSec % 60);
  var audioLabel = audioSec ? (audioMin + ':' + String(audioRem).padStart(2, '0')) : '';
%>
<div class="article-audio" data-article-audio data-slug="<%= audioSlug %>" data-duration="<%= audioSec %>">
  <button type="button" class="article-audio__btn" data-audio-play aria-label="Pustit audio komentář">
    <svg class="article-audio__icon article-audio__icon--play" viewBox="0 0 14 19" fill="currentColor" aria-hidden="true"><path d="M13.56 8.75L1.56.75A1 1 0 000 1.58v16a1 1 0 001.56.83l12-8a1 1 0 000-1.66z"/></svg>
    <svg class="article-audio__icon article-audio__icon--stop" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden><rect x="6" y="6" width="12" height="12" rx="1.5"/></svg>
    <span class="article-audio__spinner" hidden aria-hidden="true"></span>
    <span class="article-audio__time" data-audio-time><%= audioLabel %></span>
  </button>
  <div class="article-audio__rail" data-audio-bar hidden>
    <div class="article-audio__track" data-audio-track role="slider" tabindex="0" aria-label="Pozice v audio komentáři" aria-valuemin="0" aria-valuemax="<%= audioSec || 0 %>" aria-valuenow="0">
      <span class="article-audio__fill" data-audio-fill></span>
      <span class="article-audio__knob" data-audio-knob></span>
    </div>
  </div>
</div>
