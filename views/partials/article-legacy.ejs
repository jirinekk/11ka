  <div class="mx-auto max-w-7xl px-4 py-6 lg:px-6 lg:py-8">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-start">
      <article class="min-w-0" itemscope itemtype="https://schema.org/NewsArticle">
        <!-- Breadcrumbs -->
        <nav class="mb-4 text-xs text-11muted sm:text-sm" aria-label="Drobečková navigace">
          <% breadcrumbs.forEach(function (crumb, i) { %>
            <% if (i > 0) { %><span class="mx-1 text-slate-600" aria-hidden="true">›</span><% } %>
            <% if (crumb.href) { %>
              <a href="<%= crumb.href %>" class="hover:text-white"><%= crumb.label %></a>
            <% } else { %>
              <span class="text-slate-400"><%= crumb.label %></span>
            <% } %>
          <% }); %>
        </nav>
        <div id="top-ssp-411555-wrap" class="mb-4" style="display:none;">
          <div id="ssp-zone-411555" class="home-side-ad-wrap mx-auto h-[210px] w-[970px] overflow-hidden"></div>
          <script>
            (function () {
              var topWrap = document.getElementById('top-ssp-411555-wrap');
              var topZone = document.getElementById('ssp-zone-411555');
              var attempts = 0;
              var maxAttempts = 20;
              var timerId = null;
              var started = false;
              var creativeWatchId = null;
              var creativeChecks = 0;
              var maxCreativeChecks = 40;

              function hasCreative() {
                return !!(topZone && topZone.querySelector('iframe, img, ins, object, embed'));
              }

              function revealIfCreative() {
                if (!topWrap) return;
                if (hasCreative()) {
                  topWrap.style.display = '';
                  if (creativeWatchId) {
                    window.clearInterval(creativeWatchId);
                    creativeWatchId = null;
                  }
                }
              }

              function startCreativeWatcher() {
                if (creativeWatchId) return;
                creativeWatchId = window.setInterval(function () {
                  creativeChecks += 1;
                  revealIfCreative();
                  if (creativeChecks >= maxCreativeChecks) {
                    window.clearInterval(creativeWatchId);
                    creativeWatchId = null;
                  }
                }, 150);
              }

              function renderAdOnce() {
                if (started) return true;
                if (!window.sssp || typeof window.sssp.getAds !== 'function') return false;
                started = true;
                window.sssp.getAds([
                  {
                    zoneId: 411555,
                    id: 'ssp-zone-411555',
                    width: 970,
                    height: 210
                  }
                ]);
                startCreativeWatcher();
                return true;
              }

              renderAdOnce();

              timerId = window.setInterval(function () {
                attempts += 1;
                if (renderAdOnce() || attempts >= maxAttempts) {
                  window.clearInterval(timerId);
                }
              }, 150);
            })();
          </script>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-block rounded-full bg-11accent/15 px-3 py-1 text-xs font-semibold text-11accent"><%= category %></span>
          <% if (typeof tag !== 'undefined' && tag) { %>
          <span class="inline-block rounded-full bg-white/5 px-3 py-1 text-xs font-semibold text-slate-200 ring-1 ring-white/10"><%= tag %></span>
          <% } %>
        </div>
        <h1 class="font-article-title mt-3 text-2xl font-bold leading-tight text-white sm:text-3xl lg:text-4xl" itemprop="headline"><%= headline %></h1>
        <p class="mt-4 text-base leading-relaxed text-slate-300 sm:text-lg"><%= lead %></p>

        <!-- Scoreboard -->
        <div class="scoreboard-11 mt-8 flex items-center justify-between gap-4 rounded-2xl px-4 py-6 sm:px-8">
          <div class="flex min-w-0 flex-1 items-center gap-3 sm:gap-4">
            <img src="<%= scoreboard.homeLogo %>" alt="" class="h-12 w-12 shrink-0 rounded-full object-cover ring-2 ring-white/10 sm:h-14 sm:w-14" />
            <span class="truncate text-sm font-semibold text-white sm:text-base"><%= scoreboard.homeTeam %></span>
          </div>
          <div class="shrink-0 text-3xl font-bold tabular-nums text-11accent sm:text-4xl"><%= scoreboard.score %></div>
          <div class="flex min-w-0 flex-1 items-center justify-end gap-3 sm:gap-4">
            <span class="truncate text-right text-sm font-semibold text-white sm:text-base"><%= scoreboard.awayTeam %></span>
            <img src="<%= scoreboard.awayLogo %>" alt="" class="h-12 w-12 shrink-0 rounded-full object-cover ring-2 ring-white/10 sm:h-14 sm:w-14" />
          </div>
        </div>

        <!-- Author meta -->
        <div class="mt-6 flex flex-wrap items-center gap-3 border-b border-white/10 pb-6">
          <% var _metaAvLogo = String(author.avatar || '').indexOf('/logo.png') !== -1; %>
          <img src="<%= author.avatar %>" alt="" class="h-11 w-11 shrink-0 rounded-full ring-2 ring-white/10 <%= _metaAvLogo ? 'bg-11bg object-contain p-1' : 'object-cover' %>" width="44" height="44" />
          <div class="text-sm">
            <span class="font-semibold text-white"><%= author.name %></span>
            <div class="mt-0.5 flex flex-wrap items-center gap-x-2 text-11muted">
              <time datetime="2024-12-15"><%= author.date %></time>
              <span aria-hidden="true">·</span>
              <span class="inline-flex items-center gap-1">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <%= author.readTime %>
              </span>
            </div>
          </div>
        </div>

        <!-- Stats -->
        <div class="card-11 mt-8 p-5 sm:p-6">
          <h2 class="text-lg font-bold text-white"><%= stats.title %></h2>
          <div class="mt-6 grid grid-cols-3 gap-4 text-center">
            <% stats.items.forEach(function (s) { %>
            <div>
              <p class="text-2xl font-bold text-11accent sm:text-3xl"><%= s.value %></p>
              <p class="mt-1 text-xs text-11muted sm:text-sm"><%= s.label %></p>
            </div>
            <% }); %>
          </div>
        </div>

        <!-- Featured image -->
        <figure class="mt-8 overflow-hidden rounded-2xl ring-1 ring-white/10">
          <img src="<%= featuredImage %>" alt="" class="aspect-[21/9] w-full object-cover sm:aspect-[2/1]" itemprop="image" />
          <figcaption class="px-1 py-2 text-xs text-11muted sm:text-sm"><%= caption %></figcaption>
        </figure>

        <%- include('article-mobile-ad', { domId: 'ssp-zone-411438-article-legacy' }) %>

        <% sections.forEach(function (sec) { %>
        <section class="prose-11 mt-8">
          <h2 class="text-xl font-bold text-11accent sm:text-2xl"><%= sec.heading %></h2>
          <% sec.paragraphs.forEach(function (p) { %>
          <p class="mt-3 text-sm leading-relaxed text-slate-300 sm:text-base"><%= p %></p>
          <% }); %>
        </section>
        <% }); %>

        <!-- Klíčové momenty -->
        <div class="card-11 mt-8 p-5 sm:p-6">
          <h2 class="text-lg font-bold text-white">Klíčové momenty</h2>
          <ul class="mt-4 space-y-3">
            <% keyMoments.forEach(function (km) { 
              var mc = km.tone === 'goal' ? 'text-red-400' : km.tone === 'win' ? 'text-emerald-400' : 'text-cyan-400';
            %>
            <li class="flex gap-3 text-sm sm:text-base">
              <span class="shrink-0 font-mono font-semibold tabular-nums <%= mc %>"><%= km.minute %></span>
              <span class="text-slate-300"><%= km.text %></span>
            </li>
            <% }); %>
          </ul>
        </div>

        <!-- Quote -->
        <blockquote class="quote-11 relative mt-8 rounded-2xl p-6 text-center sm:p-8">
          <span class="quote-mark" aria-hidden="true">“</span>
          <p class="relative z-[1] text-base italic text-white sm:text-lg"><%= quote.text %></p>
          <footer class="relative z-[1] mt-4 text-sm text-11muted"><%= quote.attribution %></footer>
        </blockquote>

        <!-- Share -->
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <span class="text-sm font-medium text-slate-400">Sdílet:</span>
          <div class="flex gap-2">
            <a href="#" class="share-btn" aria-label="Sdílet na Facebooku"><svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg></a>
            <a href="#" class="share-btn" aria-label="Sdílet na X"><svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
            <a href="#" class="share-btn" aria-label="Kopírovat odkaz"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg></a>
          </div>
        </div>

        <%- include('promo-banner', { promoBanner: typeof articleMidPromoAd !== 'undefined' ? articleMidPromoAd : null }) %>

        <%- include('article-penalty-game') %>

        <!-- Author bio -->
        <div class="card-11 mt-8 flex flex-col gap-4 p-5 sm:flex-row sm:items-start sm:p-6">
          <% var _bioAvLogo = String(authorBio.avatar || '').indexOf('/logo.png') !== -1; %>
          <img src="<%= authorBio.avatar %>" alt="" class="mx-auto h-20 w-20 shrink-0 rounded-full ring-2 ring-white/10 sm:mx-0 <%= _bioAvLogo ? 'bg-11bg object-contain p-1.5' : 'object-cover' %>" width="80" height="80" />
          <div class="min-w-0 text-center sm:text-left">
            <p class="text-lg font-bold text-white"><%= authorBio.name %></p>
            <p class="text-sm text-11accent"><%= authorBio.role %></p>
            <p class="mt-2 text-sm leading-relaxed text-11muted"><%= authorBio.bio %></p>
          </div>
        </div>

        <!-- Související -->
        <section class="mt-10" aria-labelledby="related-heading">
          <h2 id="related-heading" class="mb-4 text-xl font-bold text-white sm:text-2xl">Další články</h2>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            <% relatedArticles.forEach(function (item) { %>
            <article class="card-11 flex flex-col overflow-hidden p-0">
              <a href="<%= item.href %>" class="block overflow-hidden">
                <img src="<%= item.image %>" alt="" class="aspect-video w-full object-cover" />
              </a>
              <div class="p-4">
                <h3 class="font-semibold leading-snug text-white">
                  <a href="<%= item.href %>" class="hover:text-11accent"><%= item.title %></a>
                </h3>
                <p class="mt-2 line-clamp-2 text-sm text-11muted"><%= item.excerpt %></p>
              </div>
            </article>
            <% }); %>
          </div>
        </section>

        <% /* Komentáře vypnuté */ %>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-6 lg:sticky lg:top-24">
        <%- include('partials/sidebar-most-read', { items: sidebarMostRead }) %>

        <%- include('sidebar-ssp-ad') %>
      </aside>
    </div>
  </div>
