<%
  var rs = String(typeof accStatus !== 'undefined' ? accStatus : 'pending').trim().toLowerCase();
  if (rs !== 'approved' && rs !== 'rejected' && rs !== 'requested' && rs !== 'pending') rs = 'pending';
  var label =
    rs === 'approved' ? 'Schváleno' :
    rs === 'rejected' ? 'Zamítnuto' :
    rs === 'requested' ? 'Zažádáno' :
    (typeof accStatusLong !== 'undefined' && accStatusLong ? 'Čeká na vyřízení' : 'Čeká');
  var variant = typeof accStatusVariant !== 'undefined' ? accStatusVariant : 'badge';
%>
<% if (variant === 'text') { %>
  <% if (rs === 'approved') { %>
  <span class="font-medium text-emerald-300"><%= label %></span>
  <% } else if (rs === 'rejected') { %>
  <span class="font-medium text-red-300"><%= label %></span>
  <% } else if (rs === 'requested') { %>
  <span class="font-medium text-sky-300"><%= label %></span>
  <% } else { %>
  <span class="font-medium text-amber-300"><%= label %></span>
  <% } %>
<% } else if (variant === 'detail') { %>
  <% if (rs === 'approved') { %>
  <span class="font-medium text-emerald-300"><%= label %></span>
  <% } else if (rs === 'rejected') { %>
  <span class="font-medium text-red-300"><%= label %></span>
  <% } else if (rs === 'requested') { %>
  <span class="font-medium text-sky-300"><%= label %></span>
  <% } else { %>
  <span class="font-medium text-amber-300"><%= label %></span>
  <% } %>
<% } else { %>
  <% if (rs === 'approved') { %>
  <span class="shrink-0 rounded-lg bg-emerald-500/15 px-2.5 py-1 text-xs font-semibold text-emerald-300"><%= label %></span>
  <% } else if (rs === 'rejected') { %>
  <span class="shrink-0 rounded-lg bg-red-500/15 px-2.5 py-1 text-xs font-semibold text-red-300"><%= label %></span>
  <% } else if (rs === 'requested') { %>
  <span class="shrink-0 rounded-lg bg-sky-500/15 px-2.5 py-1 text-xs font-semibold text-sky-300"><%= label %></span>
  <% } else { %>
  <span class="shrink-0 rounded-lg bg-amber-500/15 px-2.5 py-1 text-xs font-semibold text-amber-300"><%= label %></span>
  <% } %>
<% } %>
