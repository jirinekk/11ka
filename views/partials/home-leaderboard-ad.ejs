  <p class="mb-2 text-center text-xs font-medium uppercase tracking-wide text-11muted">Reklama</p>
  <div id="<%= adDomId %>" class="home-side-ad-wrap home-side-ad-wrap--970x210 mx-auto w-full max-w-full overflow-hidden"></div>
</div>
