  <div
    id="adblock-gate"
    class="hidden fixed inset-0 z-[120] flex items-center justify-center bg-black/75 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="adblock-gate-title"
  >
    <div class="w-full max-w-xl rounded-2xl border border-white/15 bg-[#0f1729] p-6 text-center shadow-2xl shadow-black/70">
      <h2 id="adblock-gate-title" class="text-xl font-bold text-white sm:text-2xl">Vypněte prosím blokování reklam</h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-300 sm:text-base">
        Tento web je financován reklamami. Abychom mohli zobrazit obsah, vypněte prosím adblock
        nebo jiný systém pro blokování reklam a obnovte stránku.
      </p>
      <p class="mt-3 text-xs text-11muted">
        Po vypnutí blokace reklam stiskněte obnovení stránky.
      </p>
      <button
        type="button"
        class="mt-5 inline-flex min-h-[40px] items-center justify-center rounded-xl border border-white/25 px-4 py-2 text-sm font-semibold text-white/90 transition hover:bg-white/10"
        data-adblock-reload
      >Obnovit stránku</button>
    </div>
  </div>
  <script src="/js/adblock-gate.js?v=<%= encodeURIComponent(typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" defer></script>
