  <div
    id="cookie-banner"
    role="dialog"
    aria-modal="true"
    aria-live="polite"
    aria-hidden="true"
    aria-labelledby="cookie-banner-title"
  >
    <button
      type="button"
      id="cookie-banner-close"
      class="cookie-banner__close"
      data-cookie-close
      hidden
      aria-label="Zavřít nastavení cookies"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M6 18 18 6" stroke-linecap="round"/></svg>
    </button>
    <div class="cookie-banner-inner mx-auto flex max-w-[1400px] flex-col gap-3 px-4 py-4 md:flex-row md:items-center md:justify-between lg:px-6">
      <div class="min-w-0 text-sm text-slate-300" role="document">
        <p id="cookie-banner-title" class="sr-only">Nastavení cookies</p>
        Používáme cookies pro správné fungování webu a zlepšení obsahu.
        <a href="/cookies" class="text-11accent hover:underline">Více informací</a>.
      </div>
      <div class="cookie-banner__actions flex w-full shrink-0 flex-col gap-2 sm:w-auto sm:items-end">
        <p id="cookie-banner-status" class="cookie-banner__status" role="status" aria-live="polite" hidden></p>
        <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:items-stretch sm:justify-end">
        <button
          id="cookie-reject"
          type="button"
          class="btn-11 btn-11--ghost cookie-banner__choice btn-11--block btn-11--block-sm-auto min-h-[44px]"
          data-cookie-choice="rejected"
          aria-pressed="false"
        >Nesouhlasím</button>
        <button
          id="cookie-accept"
          type="button"
          class="btn-11 btn-11--ghost cookie-banner__choice btn-11--block btn-11--block-sm-auto min-h-[44px]"
          data-cookie-choice="accepted"
          aria-pressed="false"
        >Souhlasím</button>
        </div>
      </div>
    </div>
  </div>

