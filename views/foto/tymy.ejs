<%- include('layout-start') %>
<div class="fotak-head">
  <h1>Týmy</h1>
  <p><%= (teams || []).length %> klubů</p>
</div>
<form class="fotak-search" method="get">
  <input class="input-11" type="search" name="q" value="<%= q || '' %>" placeholder="Klub…" />
</form>
<ul class="fotak-list">
  <% teams.forEach(function (t) { %>
  <li>
    <a class="fotak-row" href="/foto/tymy/<%= t.slug %>">
      <span class="fotak-row__who">
        <% if (t.logo) { %><img src="<%= t.logo %>" alt="" width="28" height="28" /><% } %>
        <span class="truncate"><%= t.name %></span>
      </span>
      <span><%= t.album_count %> alb</span>
    </a>
  </li>
  <% }); %>
</ul>
<%- include('layout-end') %>
