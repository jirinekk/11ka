<%- include('layout-start') %>
<div class="fotak-head fotak-head--split">
  <div>
    <p class="fotak-kicker">Upravit album</p>
    <h1><%= album.title %></h1>
    <p><%= album.date_label %> · <%= album.photo_count %> fotek</p>
  </div>
  <div class="fotak-actions">
    <a href="/foto/alba/<%= album.id %>" class="fotak-btn">Zobrazit album</a>
    <% if (typeof canManageFotoArchive !== 'undefined' && canManageFotoArchive) { %>
    <details class="fotak-tools">
      <summary class="fotak-btn">Nástroje</summary>
      <div class="fotak-tools__menu">
        <form method="post" action="/foto/studio/alba/<%= album.id %>/smazat" onsubmit="return confirm('Smazat celé album včetně fotek?');">
          <button type="submit" class="fotak-tools__danger">Smazat album</button>
        </form>
      </div>
    </details>
    <% } %>
  </div>
</div>

<% if (saved) { %>
<p class="fotak-note fotak-note--ok">Údaje o zápase jsou uložené.</p>
<% } %>
<% if (error) { %>
<p class="fotak-note fotak-note--bad">
  <%= error === 'teams' ? 'Domácí a hosté musí být jiný klub.' : 'Zkontroluj formulář.' %>
</p>
<% } %>

<form class="fotak-panel fotak-panel--album" method="post" action="/foto/studio/alba/<%= album.id %>" data-foto-team-form>
  <h2>Údaje o zápase</h2>
  <label class="fotak-field">Soutěž
    <select name="competition" class="input-11 mt-2" data-foto-comp>
      <% (typeof competitionGroups !== 'undefined' ? competitionGroups : [{ label: '', items: competitions }]).forEach(function (group) { %>
      <optgroup label="<%= group.label %>">
        <% group.items.forEach(function (c) { %>
        <option <%= album.competition === c ? 'selected' : '' %>><%= c %></option>
        <% }); %>
      </optgroup>
      <% }); %>
      <% if (album.competition && competitions.indexOf(album.competition) === -1) { %>
      <option selected><%= album.competition %></option>
      <% } %>
    </select>
  </label>
  <div class="fotak-team-pick-row">
    <%- include('_team-pick', { name: 'homeTeamId', label: 'Domácí', selectedId: album.home_team_id, placeholder: 'Vybrat domácí' }) %>
    <%- include('_team-pick', { name: 'awayTeamId', label: 'Hosté', selectedId: album.away_team_id, placeholder: 'Vybrat hosty' }) %>
  </div>
  <label class="fotak-field">Datum zápasu
    <input name="matchDate" type="date" required class="input-11 mt-2" value="<%= album.date_input || '' %>" />
  </label>
  <div class="grid gap-4 sm:grid-cols-2">
    <label class="fotak-field">Góly domácích
      <input name="homeScore" type="number" min="0" class="input-11 mt-2" value="<%= album.home_score != null ? album.home_score : '' %>" />
    </label>
    <label class="fotak-field">Góly hostů
      <input name="awayScore" type="number" min="0" class="input-11 mt-2" value="<%= album.away_score != null ? album.away_score : '' %>" />
    </label>
  </div>
  <label class="fotak-field">Stadion
    <input name="venue" class="input-11 mt-2" value="<%= album.venue || '' %>" />
  </label>
  <label class="fotak-field">Název alba
    <input name="title" class="input-11 mt-2" value="<%= album.title || '' %>" />
  </label>
  <label class="fotak-field">Poznámka
    <input name="notes" class="input-11 mt-2" value="<%= album.notes || '' %>" />
  </label>
  <button class="fotak-btn fotak-btn--solid" type="submit">Uložit zápas</button>
</form>

<form class="fotak-panel" method="post" action="/foto/studio/alba/<%= album.id %>/upload" enctype="multipart/form-data" data-foto-upload>
  <h2>Nahrát fotky</h2>
  <p class="fotak-quiet">Při tvorbě alba jdou fotky mazat přímo z mřížky.</p>
  <label class="fotak-field">Soubory
    <input type="file" name="photos" accept="image/*" multiple required />
  </label>
  <div class="foto-up mt-4" data-foto-up hidden>
    <p class="foto-up__status" data-foto-up-status>Připraveno</p>
    <div class="foto-up__track"><span data-foto-up-bar></span></div>
    <p class="foto-up__fail" data-foto-up-fail hidden></p>
  </div>
  <button class="fotak-btn" type="submit">Nahrát</button>
</form>

<p class="fotak-quiet">Otevři fotku, vyber hráče a klikni na něj na snímku.</p>
<div
  id="foto-gallery"
  data-photos="<%= encodeURIComponent(photosJson) %>"
  data-squads="<%= encodeURIComponent(typeof squadsJson !== 'undefined' ? squadsJson : '{}') %>"
  data-edit="1"
  data-album="<%= album.id %>"
  data-home="<%= album.home_team_id || '' %>"
  data-away="<%= album.away_team_id || '' %>"
></div>
<script src="/js/foto-gallery.js?v=<%= encodeURIComponent(assetVersion + '-tag8') %>" defer></script>
<script>
(function () {
  var form = document.querySelector('[data-foto-upload]');
  if (!form) return;

  function sleep(ms) {
    return new Promise(function (resolve) { window.setTimeout(resolve, ms); });
  }

  function shouldRetry(status) {
    return status === 0 || status === 408 || status === 429 || status === 502 || status === 503 || status === 504;
  }

  function uploadOne(file, onProgress) {
    return new Promise(function (resolve, reject) {
      var body = new FormData();
      body.append('photos', file, file.name);
      var xhr = new XMLHttpRequest();
      xhr.open('POST', form.action);
      xhr.timeout = 180000;
      xhr.setRequestHeader('Accept', 'application/json');
      xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
      xhr.upload.onprogress = function (ev) {
        if (ev.lengthComputable && onProgress) onProgress(ev.loaded / ev.total);
      };
      xhr.onload = function () {
        var data = {};
        try { data = JSON.parse(xhr.responseText || '{}'); } catch (err) { data = {}; }
        if (xhr.status >= 200 && xhr.status < 300 && data.ok !== false && Number(data.uploaded || 0) > 0) {
          resolve(data);
          return;
        }
        var err = new Error((data.failed && data.failed[0] && data.failed[0].error) || ('HTTP ' + xhr.status));
        err.status = xhr.status;
        reject(err);
      };
      xhr.onerror = function () {
        var err = new Error('Síťová chyba');
        err.status = 0;
        reject(err);
      };
      xhr.ontimeout = function () {
        var err = new Error('Časový limit');
        err.status = 504;
        reject(err);
      };
      xhr.send(body);
    });
  }

  form.addEventListener('submit', function (event) {
    event.preventDefault();
    var input = form.querySelector('input[type=file]');
    var files = input && input.files ? Array.prototype.slice.call(input.files) : [];
    if (!files.length) return;
    var box = form.querySelector('[data-foto-up]');
    var status = form.querySelector('[data-foto-up-status]');
    var bar = form.querySelector('[data-foto-up-bar]');
    var fail = form.querySelector('[data-foto-up-fail]');
    var button = form.querySelector('button[type=submit]');
    if (box) box.hidden = false;
    if (fail) { fail.hidden = true; fail.textContent = ''; }
    if (button) button.disabled = true;
    var uploaded = 0;
    var failedItems = [];

    (async function () {
      for (var i = 0; i < files.length; i += 1) {
        var file = files[i];
        var ok = false;
        var lastErr = '';
        for (var attempt = 1; attempt <= 3 && !ok; attempt += 1) {
          if (status) {
            status.textContent =
              'Nahrávám ' + (i + 1) + ' / ' + files.length +
              (attempt > 1 ? ' · znovu ' + attempt + '/3' : '') +
              ' · ' + file.name;
          }
          try {
            await uploadOne(file, function (part) {
              var pct = Math.round(((i + part) / files.length) * 100);
              if (bar) bar.style.width = pct + '%';
            });
            ok = true;
            uploaded += 1;
          } catch (err) {
            lastErr = err.message || 'chyba';
            if (attempt < 3 && shouldRetry(err.status)) await sleep(700 * attempt);
            else break;
          }
        }
        if (!ok) failedItems.push({ name: file.name, error: lastErr });
        if (bar) bar.style.width = Math.round(((i + 1) / files.length) * 100) + '%';
      }
      if (status) {
        status.textContent = 'Hotovo: nahráno ' + uploaded + ' z ' + files.length +
          (failedItems.length ? ' · selhalo ' + failedItems.length : '');
      }
      if (bar) bar.style.width = '100%';
      if (fail && failedItems.length) {
        fail.hidden = false;
        fail.textContent = failedItems.map(function (item) {
          return (item.name || 'soubor') + ': ' + (item.error || 'chyba');
        }).join(' · ');
      }
      if (button) button.disabled = false;
      if (uploaded && !failedItems.length) window.setTimeout(function () { window.location.reload(); }, 600);
      else if (uploaded) window.setTimeout(function () { window.location.reload(); }, 1600);
    })();
  });
})();
</script>
<script type="application/json" id="foto-team-data"><%- JSON.stringify({ teams: teams || [], leagues: typeof teamLeagues !== 'undefined' ? teamLeagues : {} }) %></script>
<script src="/js/foto-team-pick.js?v=<%= encodeURIComponent((typeof assetVersion !== 'undefined' ? assetVersion : '1') + '-tp1') %>"></script>
<%- include('layout-end') %>
