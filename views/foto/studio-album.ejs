<%- include('layout-start') %>
<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="text-xs font-semibold uppercase tracking-wider text-11accent">Upravit album</p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight text-white md:text-3xl"><%= album.title %></h1>
    <p class="mt-1 text-sm text-11muted"><%= album.date_label %> · <%= album.photo_count %> fotek</p>
  </div>
  <a href="/foto/alba/<%= album.id %>" class="rounded-xl bg-white/10 px-3 py-2 text-sm font-medium text-white hover:bg-white/15">Zobrazit album</a>
</div>

<% if (saved) { %>
<p class="mt-6 rounded-xl border border-emerald-500/40 bg-emerald-500/10 px-3 py-2 text-sm text-emerald-200">Údaje o zápase jsou uložené.</p>
<% } %>
<% if (error) { %>
<p class="mt-6 rounded-xl border border-red-500/40 bg-red-500/10 px-3 py-2 text-sm text-red-200">
  <%= error === 'teams' ? 'Domácí a hosté musí být jiný klub.' : 'Zkontroluj formulář.' %>
</p>
<% } %>

<form class="card-11 mt-8 space-y-4 p-6" method="post" action="/foto/studio/alba/<%= album.id %>">
  <h2 class="text-lg font-semibold text-white">Údaje o zápase</h2>
  <div class="grid gap-4 sm:grid-cols-2">
    <label class="text-xs font-semibold uppercase tracking-wider text-11muted">Domácí
      <select name="homeTeamId" class="input-11 mt-2" required>
        <% teams.forEach(function (t) { %>
        <option value="<%= t.id %>" <%= t.id === album.home_team_id ? 'selected' : '' %>><%= t.name %></option>
        <% }); %>
      </select>
    </label>
    <label class="text-xs font-semibold uppercase tracking-wider text-11muted">Hosté
      <select name="awayTeamId" class="input-11 mt-2" required>
        <% teams.forEach(function (t) { %>
        <option value="<%= t.id %>" <%= t.id === album.away_team_id ? 'selected' : '' %>><%= t.name %></option>
        <% }); %>
      </select>
    </label>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <label class="text-xs font-semibold uppercase tracking-wider text-11muted">Datum zápasu
      <input name="matchDate" type="date" required class="input-11 mt-2" value="<%= album.date_input || '' %>" />
    </label>
    <label class="text-xs font-semibold uppercase tracking-wider text-11muted">Soutěž
      <select name="competition" class="input-11 mt-2">
        <% competitions.forEach(function (c) { %>
        <option <%= album.competition === c ? 'selected' : '' %>><%= c %></option>
        <% }); %>
        <% if (album.competition && competitions.indexOf(album.competition) === -1) { %>
        <option selected><%= album.competition %></option>
        <% } %>
      </select>
    </label>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <label class="text-xs font-semibold uppercase tracking-wider text-11muted">Góly domácích
      <input name="homeScore" type="number" min="0" class="input-11 mt-2" value="<%= album.home_score != null ? album.home_score : '' %>" />
    </label>
    <label class="text-xs font-semibold uppercase tracking-wider text-11muted">Góly hostů
      <input name="awayScore" type="number" min="0" class="input-11 mt-2" value="<%= album.away_score != null ? album.away_score : '' %>" />
    </label>
  </div>
  <label class="block text-xs font-semibold uppercase tracking-wider text-11muted">Stadion
    <input name="venue" class="input-11 mt-2" value="<%= album.venue || '' %>" />
  </label>
  <label class="block text-xs font-semibold uppercase tracking-wider text-11muted">Název alba
    <input name="title" class="input-11 mt-2" value="<%= album.title || '' %>" />
  </label>
  <label class="block text-xs font-semibold uppercase tracking-wider text-11muted">Poznámka
    <input name="notes" class="input-11 mt-2" value="<%= album.notes || '' %>" />
  </label>
  <button class="rounded-xl bg-11accent px-4 py-2 text-sm font-semibold text-11bg" type="submit">Uložit zápas</button>
</form>

<form class="card-11 mt-6 p-6" method="post" action="/foto/studio/alba/<%= album.id %>/upload" enctype="multipart/form-data">
  <h2 class="text-lg font-semibold text-white">Nahrát fotky</h2>
  <label class="mt-3 block text-xs font-semibold uppercase tracking-wider text-11muted">Soubory
    <input class="mt-3 block w-full text-sm text-11muted" type="file" name="photos" accept="image/*" multiple required />
  </label>
  <button class="mt-5 rounded-xl bg-white/10 px-4 py-2 text-sm font-semibold text-white hover:bg-white/15" type="submit">Nahrát</button>
</form>

<p class="mt-8 text-sm text-11muted">Otevři fotku, vyber hráče ze soupisky a klikni na něj na snímku. Po označení se výběr vypne.</p>
<div
  id="foto-gallery"
  class="mt-4"
  data-photos="<%= encodeURIComponent(photosJson) %>"
  data-squads="<%= encodeURIComponent(typeof squadsJson !== 'undefined' ? squadsJson : '{}') %>"
  data-edit="1"
  data-album="<%= album.id %>"
  data-home="<%= album.home_team_id || '' %>"
  data-away="<%= album.away_team_id || '' %>"
></div>
<script src="/js/foto-gallery.js?v=<%= encodeURIComponent(assetVersion + '-tag3') %>" defer></script>
<%- include('layout-end') %>
