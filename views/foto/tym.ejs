<%- include('layout-start') %>
<header class="fotak-person">
  <% if (team.logo) { %><img src="<%= team.logo %>" alt="" width="56" height="56" /><% } %>
  <div>
    <p class="fotak-kicker"><%= team.league || 'Klub' %></p>
    <h1><%= team.name %></h1>
  </div>
</header>
<% if (albums.length) { %>
<h2 class="fotak-section">Alba</h2>
<div class="fotak-tile-grid">
  <% albums.forEach(function (album) { %>
  <%- include('_album-card', { album: album }) %>
  <% }); %>
</div>
<% } %>
<h2 class="fotak-section">Soupiska</h2>
<ul class="fotak-list">
  <% players.forEach(function (p) { %>
  <li>
    <a class="fotak-row" href="/foto/hraci/<%= p.slug %>">
      <span><%= p.number != null ? '#' + p.number + ' ' : '' %><%= p.name %></span>
      <span><%= p.tag_count %> fotek</span>
    </a>
  </li>
  <% }); %>
</ul>
<%- include('layout-end') %>
