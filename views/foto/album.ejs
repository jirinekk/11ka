<%- include('layout-start') %>
<header class="fotak-albumhead">
  <p class="fotak-kicker"><%= album.competition %></p>
  <div class="fotak-match__row">
    <a href="/foto/tymy/<%= album.home_slug %>" class="fotak-match__side">
      <% if (album.home_logo) { %><img src="<%= album.home_logo %>" alt="" width="36" height="36" /><% } %>
      <span><%= album.home_name || album.home_short %></span>
    </a>
    <span class="fotak-match__score"><%= album.score %></span>
    <a href="/foto/tymy/<%= album.away_slug %>" class="fotak-match__side fotak-match__side--away">
      <span><%= album.away_name || album.away_short %></span>
      <% if (album.away_logo) { %><img src="<%= album.away_logo %>" alt="" width="36" height="36" /><% } %>
    </a>
  </div>
  <p class="fotak-albumhead__meta">
    <%= album.date_label %><%= album.venue ? ' · ' + album.venue : '' %> · <%= album.photo_count %> fotek
    <% if (album.photographer_name) { %>
    · <a href="/foto/fotografi/<%= album.photographer_slug %>"><%= album.photographer_name %></a>
    <% } %>
  </p>
  <div class="fotak-actions">
    <a href="/foto/studio/alba/<%= album.id %>" class="fotak-btn">Upravit</a>
  </div>
</header>
<div
  id="foto-gallery"
  class="mt-6"
  data-photos="<%= encodeURIComponent(photosJson) %>"
  data-squads="<%= encodeURIComponent(typeof squadsJson !== 'undefined' ? squadsJson : '{}') %>"
  data-edit="<%= canEdit ? '1' : '' %>"
  data-album="<%= album.id %>"
  data-home="<%= album.home_team_id || '' %>"
  data-away="<%= album.away_team_id || '' %>"
></div>
<script src="/js/foto-gallery.js?v=<%= encodeURIComponent(assetVersion + '-tag8') %>" defer></script>
<%- include('layout-end') %>
