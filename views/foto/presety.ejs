<%- include('layout-start') %>
<div class="fotak-head">
  <h1>Presety</h1>
</div>
<% if (!presets.length) { %>
<p class="fotak-empty">Zatím tu žádný preset není.</p>
<% } else { %>
<div class="fotak-preset-grid">
  <% presets.forEach(function (p) { %>
  <article class="fotak-panel">
    <h2><%= p.name %></h2>
    <p class="fotak-quiet"><%= p.app %></p>
  </article>
  <% }); %>
</div>
<% } %>
<%- include('layout-end') %>
