<%- include('layout-start') %>
<div class="fotak-head">
  <h1>Nové album</h1>
  <p>Nejdřív soutěž a týmy. Fotky nahraješ hned potom.</p>
</div>
<% if (error) { %>
<p class="fotak-note fotak-note--bad">
  <%= error === 'teams' ? 'Domácí a hosté musí být jiný klub.' : 'Zkontroluj formulář.' %>
</p>
<% } %>
<form class="fotak-panel fotak-panel--album" method="post" action="/foto/studio/alba/nove" data-foto-team-form>
  <label class="fotak-field">Soutěž
    <select name="competition" class="input-11" data-foto-comp>
      <% (typeof competitionGroups !== 'undefined' ? competitionGroups : [{ label: '', items: competitions }]).forEach(function (group) { %>
      <optgroup label="<%= group.label %>">
        <% group.items.forEach(function (c) { %><option><%= c %></option><% }); %>
      </optgroup>
      <% }); %>
    </select>
  </label>
  <div class="fotak-team-pick-row">
    <%- include('_team-pick', { name: 'homeTeamId', label: 'Domácí', placeholder: 'Vybrat domácí' }) %>
    <%- include('_team-pick', { name: 'awayTeamId', label: 'Hosté', placeholder: 'Vybrat hosty' }) %>
  </div>
  <label class="fotak-field">Datum zápasu
    <input name="matchDate" type="date" required class="input-11" />
  </label>
  <div class="grid gap-4 sm:grid-cols-2">
    <label class="fotak-field">Góly domácích
      <input name="homeScore" type="number" min="0" class="input-11" />
    </label>
    <label class="fotak-field">Góly hostů
      <input name="awayScore" type="number" min="0" class="input-11" />
    </label>
  </div>
  <label class="fotak-field">Stadion
    <input name="venue" class="input-11" />
  </label>
  <label class="fotak-field">Název alba (volitelné)
    <input name="title" class="input-11" />
  </label>
  <button class="fotak-btn fotak-btn--solid" type="submit">Vytvořit a nahrát fotky</button>
</form>
<script type="application/json" id="foto-team-data"><%- JSON.stringify({ teams: teams || [], leagues: typeof teamLeagues !== 'undefined' ? teamLeagues : {} }) %></script>
<script src="/js/foto-team-pick.js?v=<%= encodeURIComponent((typeof assetVersion !== 'undefined' ? assetVersion : '1') + '-tp1') %>"></script>
<%- include('layout-end') %>
