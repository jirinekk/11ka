<%- include('layout-start') %>
<div class="fotak-head">
  <h1>Fotografové</h1>
  <p><%= (photographers || []).length %></p>
</div>
<ul class="fotak-list">
  <% photographers.forEach(function (p) { %>
  <li>
    <a class="fotak-row" href="/foto/fotografi/<%= p.slug %>">
      <span><%= p.name %></span>
      <span><%= p.album_count %> alb</span>
    </a>
  </li>
  <% }); %>
</ul>
<%- include('layout-end') %>
