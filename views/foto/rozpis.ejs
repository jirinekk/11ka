<%- include('layout-start') %>
<%
  var liveItems = typeof live !== 'undefined' && live ? live : [];
  var todayItems = typeof today !== 'undefined' && today ? today : [];
%>
<div class="fotak-head">
  <h1>Rozpis</h1>
</div>
<div class="fotak-chips">
  <a href="/foto/rozpis" class="fotak-chip<%= !liga ? ' is-on' : '' %>">Vše</a>
  <% leagues.forEach(function (l) { %>
  <a href="/foto/rozpis?liga=<%= encodeURIComponent(l) %>" class="fotak-chip<%= liga === l ? ' is-on' : '' %>"><%= l %></a>
  <% }); %>
</div>

<% if (!liveItems.length && !todayItems.length && !groups.length) { %>
<p class="fotak-empty">Žádné zápasy v tomhle filtru.</p>
<% } %>

<% if (liveItems.length) { %>
  <h2 class="fotak-section">Živě</h2>
  <ul class="fotak-list">
    <% liveItems.forEach(function (f) { %>
    <li class="fotak-fx<%= f.isLive ? ' is-live' : '' %>">
      <span class="fotak-fx__teams">
        <% if (f.homeLogo) { %><img src="<%= f.homeLogo %>" alt="" width="22" height="22" /><% } %>
        <span class="truncate"><%= f.homeName %></span>
        <span class="fotak-fx__vs">–</span>
        <span class="truncate"><%= f.awayName %></span>
        <% if (f.awayLogo) { %><img src="<%= f.awayLogo %>" alt="" width="22" height="22" /><% } %>
      </span>
      <span class="fotak-fx__time is-live">Živě</span>
    </li>
    <% }); %>
  </ul>
<% } %>

<% if (todayItems.length) { %>
  <h2 class="fotak-section">Dnes</h2>
  <ul class="fotak-list">
    <% todayItems.forEach(function (f) { %>
    <li class="fotak-fx<%= f.isLive ? ' is-live' : '' %>">
      <span class="fotak-fx__teams">
        <% if (f.homeLogo) { %><img src="<%= f.homeLogo %>" alt="" width="22" height="22" /><% } %>
        <span class="truncate"><%= f.homeName %></span>
        <span class="fotak-fx__vs">–</span>
        <span class="truncate"><%= f.awayName %></span>
        <% if (f.awayLogo) { %><img src="<%= f.awayLogo %>" alt="" width="22" height="22" /><% } %>
      </span>
      <span class="fotak-fx__time<%= f.isLive ? ' is-live' : '' %>"><%= f.time_label %></span>
    </li>
    <% }); %>
  </ul>
<% } else if (!liveItems.length) { %>
  <h2 class="fotak-section">Dnes</h2>
  <p class="fotak-quiet">Dnes v tomhle filtru nic nehraje.</p>
<% } %>

<% groups.forEach(function (g) { %>
  <h2 class="fotak-section"><%= g.date_label %></h2>
  <ul class="fotak-list">
    <% g.items.forEach(function (f) { %>
    <li class="fotak-fx">
      <span class="fotak-fx__teams">
        <% if (f.homeLogo) { %><img src="<%= f.homeLogo %>" alt="" width="22" height="22" /><% } %>
        <span class="truncate"><%= f.homeName %></span>
        <span class="fotak-fx__vs">–</span>
        <span class="truncate"><%= f.awayName %></span>
        <% if (f.awayLogo) { %><img src="<%= f.awayLogo %>" alt="" width="22" height="22" /><% } %>
      </span>
      <span class="fotak-fx__time"><%= f.time_label %></span>
    </li>
    <% }); %>
  </ul>
<% }); %>
<%- include('layout-end') %>
