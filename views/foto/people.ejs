<%- include('layout-start') %>
<h1 class="text-2xl font-bold tracking-tight text-white md:text-3xl"><%= heading %></h1>
<form class="mt-6 max-w-xl" method="get">
  <input class="input-11" type="search" name="q" value="<%= q || '' %>" placeholder="Jméno…" />
</form>
<ul class="card-11 mt-6 divide-y divide-white/10 px-4">
  <% (people || []).forEach(function (p) { %>
  <li>
    <a class="fotak-row" href="/foto/hraci/<%= p.slug %>">
      <span><%= p.number != null ? '#' + p.number + ' ' : '' %><%= p.name %></span>
      <span><%= p.team_short || p.tag_count + ' fotek' %></span>
    </a>
  </li>
  <% }); %>
</ul>
<%- include('layout-end') %>
