<a href="/foto/alba/<%= album.id %>" class="fotak-tile" data-search="<%= [album.title, album.home_name, album.away_name, album.competition, album.photographer_name, album.date_label].filter(Boolean).join(' ') %>">
  <div class="fotak-tile__cover">
    <% if (album.cover_url) { %>
    <img src="<%= album.cover_url %>" alt="" loading="lazy" decoding="async" onerror="this.onerror=null;this.style.display='none'" />
    <% } %>
    <span class="fotak-tile__fallback">
      <% if (album.home_logo) { %><img src="<%= album.home_logo %>" alt="" width="36" height="36" /><% } %>
      <span><%= album.score %></span>
      <% if (album.away_logo) { %><img src="<%= album.away_logo %>" alt="" width="36" height="36" /><% } %>
    </span>
    <span class="fotak-tile__shade">
      <span class="fotak-tile__title"><%= album.title %></span>
      <span class="fotak-tile__meta"><% if (album.photographer_name) { %><%= album.photographer_name %> · <% } %><%= album.photo_count || 0 %> fotek · <%= album.date_label %></span>
    </span>
  </div>
</a>
