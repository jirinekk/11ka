<%- include('layout-start') %>
<header class="fotak-person">
  <% if (player.photo) { %>
  <img class="fotak-person__photo" src="<%= player.photo %>" alt="" width="72" height="72" />
  <% } %>
  <div>
    <p class="fotak-kicker"><%= player.team_name || (player.role === 'REFEREE' ? 'Rozhodčí' : 'Hráč') %></p>
    <h1><%= player.number != null ? '#' + player.number + ' ' : '' %><%= player.name %></h1>
  </div>
</header>
<% if ((photos || []).length) { %>
<div class="photo-grid fotak-photo-grid">
  <% (photos || []).forEach(function (p) { %>
  <a class="photo-tile" href="/foto/alba/<%= p.album_id %>">
    <img src="<%= p.thumbSrc %>" alt="" loading="lazy" onerror="this.parentNode.classList.add('is-missing')" />
  </a>
  <% }); %>
</div>
<% } else { %>
<p class="fotak-empty">Zatím bez oštítkovaných fotek.</p>
<% } %>
<%- include('layout-end') %>
