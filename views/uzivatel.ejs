<%- include('partials/header') %>

<main id="main-content" class="flex-1" tabindex="-1">
  <div class="mx-auto max-w-3xl px-4 py-8 lg:px-6 lg:py-10">
    <article class="card-11 p-6 sm:p-8">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
        <% if (profile.avatar_path) { %>
        <img src="<%= profile.avatar_path %>" alt="" class="h-20 w-20 shrink-0 rounded-full object-cover ring-2 ring-11accent/30" width="80" height="80" />
        <% } else { %>
        <img src="/logo.png" alt="" class="h-20 w-20 shrink-0 rounded-full bg-11bg object-contain p-2 ring-2 ring-white/10" width="80" height="80" />
        <% } %>
        <div class="min-w-0 flex-1">
          <h1 class="text-2xl font-bold leading-tight text-white sm:text-3xl"><%= profile.display_name || 'Uživatel 11ky' %></h1>
          <p class="mt-1 text-sm text-11muted">Veřejný profil</p>
          <% if (profile.public_bio) { %>
          <p class="mt-4 whitespace-pre-wrap text-sm leading-relaxed text-slate-200"><%= profile.public_bio %></p>
          <% } %>
          <div class="mt-4 flex flex-wrap gap-3 text-sm">
            <% if (isOwnProfile) { %>
            <a href="/ucet" class="text-11accent hover:underline">Upravit profil</a>
            <% } %>
            <% if (authorHref && articleCount) { %>
            <a href="<%= authorHref %>" class="text-11accent hover:underline">Články autora (<%= articleCount %>)</a>
            <% } %>
          </div>
        </div>
      </div>

      <% if (profile.favoriteTeam) { %>
      <section class="mt-8 border-t border-white/10 pt-6" aria-labelledby="fav-team-heading">
        <h2 id="fav-team-heading" class="text-sm font-semibold uppercase tracking-wide text-11muted">Oblíbený klub</h2>
        <div class="mt-3 inline-flex items-center gap-3 rounded-xl border border-11accent/30 bg-11accent/10 px-3 py-2">
          <img src="<%= profile.favoriteTeam.logo %>" alt="" class="h-9 w-9 object-contain" width="36" height="36" />
          <span class="text-sm font-semibold text-white"><%= profile.favoriteTeam.name %></span>
        </div>
      </section>
      <% } %>

      <% if (profile.starredTeams && profile.starredTeams.length) { %>
      <section class="mt-8 border-t border-white/10 pt-6" aria-labelledby="star-teams-heading">
        <h2 id="star-teams-heading" class="text-sm font-semibold uppercase tracking-wide text-11muted">Hvězdičky Chance Ligy</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          <% profile.starredTeams.forEach(function (team) { %>
          <li class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-3 py-2">
            <img src="<%= team.logo %>" alt="" class="h-7 w-7 object-contain" width="28" height="28" />
            <span class="text-sm text-slate-200"><%= team.name %></span>
            <span class="text-11accent" aria-hidden="true">★</span>
          </li>
          <% }); %>
        </ul>
      </section>
      <% } %>

      <% if (!profile.favoriteTeam && !(profile.starredTeams && profile.starredTeams.length) && !profile.public_bio) { %>
      <p class="mt-8 border-t border-white/10 pt-6 text-sm text-11muted">Zatím bez bio a oblíbených klubů.</p>
      <% } %>
    </article>
  </div>
</main>

<%- include('partials/footer') %>
