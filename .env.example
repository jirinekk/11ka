PORT=3000
TRUST_PROXY=1
# Na Vercelu nastavte stejné názvy v Project → Settings → Environment Variables → Production.
# .env se nedeplojuje.
SESSION_SECRET=change-this-to-a-long-random-string
# Redakce (včetně Jiřího Galby) se na prázdné DB bere z data/seed-users.json — bcrypt hashe, bez pepperu.
# ADMIN_EMAIL / ADMIN_PASSWORD jen založí chybějící extra účet. Prázdné hodnoty už NEpíšou výchozí heslo přes seed.
# Na Vercelu je nenechávejte na vývojových hodnotách z tohoto souboru.
ADMIN_EMAIL=
ADMIN_PASSWORD=

PUBLIC_BASE_URL=https://11ka.cz
ASSET_VERSION=2026-04-19-4

NEWSLETTER_SMTP_HOST=
NEWSLETTER_SMTP_PORT=465
NEWSLETTER_SMTP_SECURE=true
NEWSLETTER_SMTP_USER=
NEWSLETTER_SMTP_PASS=
NEWSLETTER_MAIL_FROM=novinky@11ka.cz

ACCREDITATION_SMTP_HOST=
ACCREDITATION_SMTP_PORT=465
ACCREDITATION_SMTP_SECURE=true
ACCREDITATION_SMTP_USER=
ACCREDITATION_SMTP_PASS=
ACCREDITATION_MAIL_FROM=akreditace@11ka.cz
ACCREDITATION_EMAIL=akreditace@11ka.cz

AI_DRAFT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=cs-cz-advisor-1
# Audio komentář: ElevenLabs když je klíč, jinak český Gemini hlas cs-cz-advisor-1.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_multilingual_v2

FOTO_11KA_URL=https://foto.11ka.cz
FOTO_11KA_KEY=
